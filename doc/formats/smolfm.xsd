<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

  <!-- Root element.  Version 3 splits the document into a semantic part
       (<Graph>: processors + wiring) and a presentation part (<Layout>:
       canvas boxes; future UI settings extend it).  Version 2 files keep
       the flat legacy structure; the reader accepts both. -->
  <xs:element name="SmolFM">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Graph" type="GraphType"/>
        <xs:element name="Layout" type="LayoutType" minOccurs="0"/>
      </xs:sequence>
      <!-- Metadata group on the root element (kept together with name):
           description = one concise sentence about the sound-design goal;
           techniques = comma-separated names from the doc/techniques
           catalogue.  Both optional, an empty string is allowed. -->
      <xs:attribute name="version" type="xs:string" use="required"/>
      <xs:attribute name="name" type="xs:string" use="optional"/>
      <xs:attribute name="description" type="xs:string" use="optional"/>
      <xs:attribute name="techniques" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>

  <!-- Enumerations of the semantic part: the named spelling the writer
       emits; the reader also accepts the numeric legacy values. -->
  <xs:simpleType name="WaveformType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="sine"/>
      <xs:enumeration value="saw"/>
      <xs:enumeration value="square"/>
      <xs:enumeration value="triangle"/>
      <xs:enumeration value="noise"/>
      <xs:enumeration value="perlin"/>
      <xs:enumeration value="simplex"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="OscModeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="pitch"/>
      <xs:enumeration value="static"/>
      <xs:enumeration value="lfo"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="FilterModeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="lp"/>
      <xs:enumeration value="bp"/>
      <xs:enumeration value="hp"/>
      <xs:enumeration value="notch"/>
      <xs:enumeration value="ap"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ShapeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="soft"/>
      <xs:enumeration value="hard"/>
      <xs:enumeration value="fold"/>
      <xs:enumeration value="quantize"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="SyncType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="off"/>
      <xs:enumeration value="on"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Bypass toggle (gain/shape/filter/adsr/fadsr/delay): 1 = neutral
       passthrough; the processor's internal state is remembered (frozen:
       delay line, envelope phase, filter integrators) and un-bypassing
       resumes where it left off.  SmolFmFile::save writes 0/1. -->
  <xs:simpleType name="BypassType">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="DivisionType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="half"/>
      <xs:enumeration value="quarter"/>
      <xs:enumeration value="eighth"/>
      <xs:enumeration value="sixteenth"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="FscaleIntervalType">
    <xs:annotation>
      <xs:appinfo xmlns="urn:smolfm:node-meta">
        <purpose>Musikalischer Kurzbefehl für die fscale-Stufe: jede Option steht für ein exaktes 12-TET-Frequenzverhältnis (2^k/12, "none" = 1); Ratio und Faktor multiplizieren sich.</purpose>
      </xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="none"/>
      <xs:enumeration value="octave_up"/>
      <xs:enumeration value="octave_down"/>
      <xs:enumeration value="fifth_up"/>
      <xs:enumeration value="fifth_down"/>
      <xs:enumeration value="fourth_up"/>
      <xs:enumeration value="fourth_down"/>
      <xs:enumeration value="minor_third_up"/>
      <xs:enumeration value="major_third_up"/>
      <xs:enumeration value="semitone_up"/>
      <xs:enumeration value="semitone_down"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PortDirectionType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="in"/>
      <xs:enumeration value="out"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PortKindType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="frequency"/>
      <xs:enumeration value="signal"/>
      <xs:enumeration value="velocity"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Valid ranges for the numeric attributes, mirroring the APVTS
       NormalisableRange bounds from PluginProcessor::createParameterLayout().
       Strict validators (xsi:type) enforce them; loose validation skips. -->
  <xs:simpleType name="StaticFreqRangeType">
    <xs:restriction base="xs:float">
      <xs:minInclusive value="20"/>
      <xs:maxInclusive value="20000"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="LfoRateRangeType">
    <xs:restriction base="xs:float">
      <xs:minInclusive value="0.01"/>
      <xs:maxInclusive value="50"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="FmAmountRangeType">
    <xs:restriction base="xs:float">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="10"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="FrequencyFactorRangeType">
    <xs:restriction base="xs:float">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="10"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="EnvelopeTimeRangeType">
    <xs:restriction base="xs:float">
      <xs:minInclusive value="0.001"/>
      <xs:maxInclusive value="5"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="EnvelopeSustainRangeType">
    <xs:restriction base="xs:float">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="EnvelopeReleaseRangeType">
    <xs:restriction base="xs:float">
      <xs:minInclusive value="0.001"/>
      <xs:maxInclusive value="10"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="EnvelopeFactorRangeType">
    <xs:restriction base="xs:float">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="10"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="GainFactorRangeType">
    <xs:restriction base="xs:float">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="10"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="DriveRangeType">
    <xs:restriction base="xs:float">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="FilterCutoffRangeType">
    <xs:restriction base="xs:float">
      <xs:minInclusive value="20"/>
      <xs:maxInclusive value="20000"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="FilterResonanceRangeType">
    <xs:restriction base="xs:float">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AmAmountRangeType">
    <xs:restriction base="xs:float">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="DelayTimeRangeType">
    <xs:restriction base="xs:float">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="2000"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="DelayFeedbackRangeType">
    <xs:restriction base="xs:float">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="0.95"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="DelayMixRangeType">
    <xs:restriction base="xs:float">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="HoldRateRangeType">
    <xs:restriction base="xs:float">
      <xs:minInclusive value="0.5"/>
      <xs:maxInclusive value="20000"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ResonatorTuneRangeType">
    <xs:restriction base="xs:float">
      <xs:minInclusive value="20"/>
      <xs:maxInclusive value="8000"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ResonatorQRangeType">
    <xs:restriction base="xs:float">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ResonatorDecayRangeType">
    <xs:restriction base="xs:float">
      <xs:minInclusive value="0.01"/>
      <xs:maxInclusive value="10"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="VelSpreadRangeType">
    <xs:restriction base="xs:float">
      <xs:minInclusive value="0.25"/>
      <xs:maxInclusive value="4"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="StrikeLevelRangeType">
    <xs:restriction base="xs:float">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="2"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="StrikeTimeRangeType">
    <xs:restriction base="xs:float">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="0.2"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="FeedbackAmountRangeType">
    <xs:restriction base="xs:float">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="0.95"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="MasterLevelRangeType">
    <xs:restriction base="xs:float">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <!--
    One explicit complexType per processor. SmolFmFile::save writes the
    generic <Node> element for every node; a validator applies the
    processor-specific type only when the document states it:

        <Node xsi:type="OscillatorNodeType" id="osc0" waveform="saw"/>
  -->
  <xs:complexType name="GraphType">
    <xs:sequence>
      <xs:element name="Nodes" type="NodesType"/>
      <xs:element name="Connections" type="ConnectionsType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="NodesType">
    <xs:sequence>
      <xs:element name="Node" type="BaseNodeType" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Semantic shared base: identity + ports.  Presentation data (canvas
       position, UI settings) lives in the <Layout> part, never here; the
       anyAttribute keeps the writer's loose output valid. -->
  <xs:complexType name="BaseNodeType">
    <xs:sequence>
      <xs:element name="Pin" type="PinType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:anyAttribute processContents="skip"/>
  </xs:complexType>

  <!-- Note input (note): parameter-free. -->
  <xs:complexType name="NoteNodeType">
    <xs:annotation>
      <xs:appinfo xmlns="urn:smolfm:node-meta">
        <purpose>Wandelt die aktuell gespielte MIDI-Note in eine Frequenz (Hz) um und stellt sie als Frequenzsignal bereit; der zusätzliche vel-Ausgang trägt die Anschlagsstärke (0-1) der Note als eigenständigen Port-Typ velocity (Accent). Dient als MIDI-Quelle des Graphen ohne eigene Parameter.</purpose>
        <docReference>doc/processors/NoteProcessor.md</docReference>
        <outputs>
          <port id="out" type="frequency"/>
          <port id="vel" type="velocity"/>
        </outputs>
        <maxInstances>1</maxInstances>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="BaseNodeType"/>
    </xs:complexContent>
  </xs:complexType>

  <!-- Oscillator (osc) -->
  <xs:complexType name="OscillatorNodeType">
    <xs:annotation>
      <xs:appinfo xmlns="urn:smolfm:node-meta">
        <purpose>Integriert die momentane Eingangsfrequenz und rendert daraus die gewählte Wellenform (sine, saw, square, triangle, noise, perlin, simplex). 
		Im Pitch-Modus folgt die Frequenz dem note_in-Eingang, im Static-Modus schwingt der Oszillator mit der festen StaticFreq und im LFO-Modus erzeugt er eine periodische Niederfrequenz mit der einstellbaren LfoRate. 
		Ohne angeschlossenen Eingang bleibt der Oszillator still: Im Pitch-Modus liest er 0 Hz (kein Ton), im Static-/LFO-Modus dient der Draht als Gate — ohne verbundene Note gibt es keinen Oszillationsstart. Damit dient er im Graph als Träger- oder Modulator-Oszillator sowie als LFO-Quelle.</purpose>
        <docReference>doc/processors/OscillatorProcessor.md</docReference>
        <inputs>
          <port id="note_in" type="frequency"/>
        </inputs>
        <outputs>
          <port id="out" type="signal"/>
        </outputs>
        <maxInstances>16</maxInstances>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="BaseNodeType">
        <xs:attribute name="waveform" type="WaveformType" use="optional"/>
        <xs:attribute name="mode" type="OscModeType" use="optional"/>
        <xs:attribute name="staticfreq" type="StaticFreqRangeType" use="optional"/>
        <xs:attribute name="lforate" type="LfoRateRangeType" use="optional"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- FM modulator (fm) -->
  <xs:complexType name="FMNodeType">
    <xs:annotation>
      <xs:appinfo xmlns="urn:smolfm:node-meta">
        <purpose>Moduliert die Eingangsfrequenz um die Summe aus Amount und dem angelegten Modulatoreingang und gibt die resultierende Frequenz aus. Dient als FM-Modulationsstufe im Frequenz-Pfad.</purpose>
        <docReference>doc/processors/FMModulationProcessor.md</docReference>
        <inputs>
          <port id="freq_in" type="frequency"/>
          <port id="modulator_in" type="signal"/>
          <port id="amount_mod_in" type="signal"/>
          <port id="vel" type="velocity"/>
        </inputs>
        <outputs>
          <port id="out" type="frequency"/>
        </outputs>
        <maxInstances>8</maxInstances>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="BaseNodeType">
        <xs:attribute name="amount" type="FmAmountRangeType" use="optional"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- Frequency scale (fscale) -->
  <xs:complexType name="FrequencyScaleNodeType">
    <xs:annotation>
      <xs:appinfo xmlns="urn:smolfm:node-meta">
        <purpose>Skaliert die Eingangsfrequenz mit einem konstanten Faktor und gibt das Ergebnis weiter. Dient zur Intervall- oder Oktavskalierung im Frequenz-Pfad.</purpose>
        <docReference>doc/processors/FrequencyScaleProcessor.md</docReference>
        <inputs>
          <port id="freq_in" type="frequency"/>
        </inputs>
        <outputs>
          <port id="out" type="frequency"/>
        </outputs>
        <maxInstances>16</maxInstances>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="BaseNodeType">
        <xs:attribute name="factor" type="FrequencyFactorRangeType" use="optional"/>
        <xs:attribute name="interval" type="FscaleIntervalType" use="optional"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- Velocity Scale (vsc): bends the velocity domain before the consumers -->
  <xs:simpleType name="VscCurveType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="linear"/>
      <xs:enumeration value="sqrt"/>
      <xs:enumeration value="square"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="VelocityScaleNodeType">
    <xs:annotation>
      <xs:appinfo xmlns="urn:smolfm:node-meta">
        <purpose>Skaliert die Velocity-Domäne vor den vel-Verbrauchern (Curve linear/sqrt/square, Scale 0,25-4). Die Analog-Brücke zwischen rohem MIDI-Anschlag und Hardware-Akzentgesetzen.</purpose>
        <docReference>doc/processors/VelocityScaleProcessor.md</docReference>
        <inputs>
          <port id="vel_in" type="velocity"/>
        </inputs>
        <outputs>
          <port id="out" type="velocity"/>
        </outputs>
        <maxInstances>8</maxInstances>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="BaseNodeType">
        <xs:attribute name="curve" type="VscCurveType" use="optional"/>
        <xs:attribute name="scale" type="VelSpreadRangeType" use="optional"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- ADSR (adsr) -->
  <xs:complexType name="AdsrNodeType">
    <xs:annotation>
      <xs:appinfo xmlns="urn:smolfm:node-meta">
        <purpose>Formt das Eingangssignal mit einer vierstufigen Hüllkurve (Attack/Decay/Sustain/Release) als Amplitudenmodulation, getriggert pro Note. Gibt das gehüllte Signal weiter.</purpose>
        <docReference>doc/processors/AdsrProcessor.md</docReference>
        <inputs>
          <port id="in" type="signal"/>
        </inputs>
        <outputs>
          <port id="out" type="signal"/>
        </outputs>
        <maxInstances>16</maxInstances>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="BaseNodeType">
        <xs:attribute name="attack" type="EnvelopeTimeRangeType" use="optional"/>
        <xs:attribute name="decay" type="EnvelopeTimeRangeType" use="optional"/>
        <xs:attribute name="sustain" type="EnvelopeSustainRangeType" use="optional"/>
        <xs:attribute name="release" type="EnvelopeReleaseRangeType" use="optional"/>
        <xs:attribute name="bypass" type="BypassType" use="optional"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- fadsr up/down: free-range factor (0..10) or an interval-name shortcut;
       the union keeps the numeric legacy spelling valid alongside the names. -->
  <xs:simpleType name="FAdsrFactorType">
    <xs:annotation>
      <xs:appinfo xmlns="urn:smolfm:node-meta">
        <purpose>Faktor eines fadsr-Ankers (up = E=1, down = E=0): eine Zahl 0-10 (multiplikativer Frequenzfaktor) oder ein Intervallname (FscaleIntervalType); der Name resolviert auf sein exaktes 12-TET-Verhältnis (z. B. octave_up = 2, fifth_down ≈ 0.667420), nie auf einen Index.</purpose>
      </xs:appinfo>
    </xs:annotation>
    <xs:union memberTypes="EnvelopeFactorRangeType FscaleIntervalType"/>
  </xs:simpleType>

  <!-- FADSR (fadsr) -->
  <xs:complexType name="FAdsrNodeType">
    <xs:annotation>
      <xs:appinfo xmlns="urn:smolfm:node-meta">
        <purpose>Skaliert die Eingangsfrequenz mit einer sechsstufigen Hüllkurve; Up und Down bestimmen den Frequenzfaktor bei E=1 bzw. E=0. Dient als Pitch-Hüllkurve im Frequenz-Pfad.</purpose>
        <docReference>doc/processors/FAdsrProcessor.md</docReference>
        <inputs>
          <port id="freq_in" type="frequency"/>
          <port id="vel" type="velocity"/>
        </inputs>
        <outputs>
          <port id="out" type="frequency"/>
        </outputs>
        <maxInstances>8</maxInstances>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="BaseNodeType">
        <xs:attribute name="attack" type="EnvelopeTimeRangeType" use="optional"/>
        <xs:attribute name="decay" type="EnvelopeTimeRangeType" use="optional"/>
        <xs:attribute name="sustain" type="EnvelopeSustainRangeType" use="optional"/>
        <xs:attribute name="release" type="EnvelopeReleaseRangeType" use="optional"/>
        <xs:attribute name="up" type="FAdsrFactorType" use="optional"/>
        <xs:attribute name="down" type="FAdsrFactorType" use="optional"/>
        <xs:attribute name="bypass" type="BypassType" use="optional"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- Gain (gain) -->
  <xs:complexType name="GainNodeType">
    <xs:annotation>
      <xs:appinfo xmlns="urn:smolfm:node-meta">
        <purpose>Multipliziert das Eingangssignal mit einem konstanten Faktor und gibt das skalierte Signal weiter. Dient zum Anheben oder Absenken der Amplitude im Signal-Pfad.</purpose>
        <docReference>doc/processors/GainProcessor.md</docReference>
        <inputs>
          <port id="in" type="signal"/>
          <port id="factor_mod_in" type="signal"/>
          <port id="vel" type="velocity"/>
        </inputs>
        <outputs>
          <port id="out" type="signal"/>
        </outputs>
        <maxInstances>16</maxInstances>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="BaseNodeType">
        <xs:attribute name="factor" type="GainFactorRangeType" use="optional"/>
        <xs:attribute name="bypass" type="BypassType" use="optional"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- Waveshaper (shape) -->
  <xs:complexType name="WaveshaperNodeType">
    <xs:annotation>
      <xs:appinfo xmlns="urn:smolfm:node-meta">
        <purpose>Verzerrt das Eingangssignal über eine nichtlineare Übertragungskurve in Soft-, Hard-, Fold- oder Quantize-Variante (Amplitudentreppstufen; der Drive setzt die Stufenzahl pro Einheit) mit einstellbarem Drive-Anteil. Gibt das verzerrte Signal weiter.</purpose>
        <docReference>doc/processors/WaveshaperProcessor.md</docReference>
        <inputs>
          <port id="in" type="signal"/>
          <port id="drive_mod_in" type="signal"/>
          <port id="vel" type="velocity"/>
        </inputs>
        <outputs>
          <port id="out" type="signal"/>
        </outputs>
        <maxInstances>16</maxInstances>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="BaseNodeType">
        <xs:attribute name="drive" type="DriveRangeType" use="optional"/>
        <xs:attribute name="shape" type="ShapeType" use="optional"/>
        <xs:attribute name="bypass" type="BypassType" use="optional"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <!-- Filter (filter) -->
  <xs:complexType name="FilterNodeType">
    <xs:annotation>
      <xs:appinfo xmlns="urn:smolfm:node-meta">
        <purpose>Filtert das Eingangssignal mit LP-, BP-, HP-, Notch- oder Allpass-Charakteristik über einstellbare Cutoff-Frequenz und Resonanz. Ein angebundener Modulationseingang überschreibt die statische Cutoff-Frequenz. Im AP-Modus bleibt die Amplitude 1 (bilinear-exakter Allpass, y = x − 2k·v1); nur die Phase rotiert 0°→−360° — cutoff ist der Drehpunkt, resonance die Kantigkeit der Drehung.</purpose>
        <docReference>doc/processors/FilterProcessor.md</docReference>
        <inputs>
          <port id="in" type="signal"/>
          <port id="cutoff_mod_in" type="frequency"/>
          <port id="resonance_mod_in" type="signal"/>
          <port id="vel" type="velocity"/>
        </inputs>
        <outputs>
          <port id="out" type="signal"/>
        </outputs>
        <maxInstances>16</maxInstances>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="BaseNodeType">
        <xs:attribute name="cutoff" type="FilterCutoffRangeType" use="optional"/>
        <xs:attribute name="resonance" type="FilterResonanceRangeType" use="optional"/>
        <xs:attribute name="mode" type="FilterModeType" use="optional"/>
        <xs:attribute name="bypass" type="BypassType" use="optional"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- Delay (delay) -->
  <xs:complexType name="DelayNodeType">
    <xs:annotation>
      <xs:appinfo xmlns="urn:smolfm:node-meta">
        <purpose>Verzögert das Eingangssignal um eine einstellbare Zeit mit Feedback-Anteil und mischt Original und Echo. Die Zeit läuft statisch in Millisekunden oder tempo-synchronisiert über eine Noten-Länge.</purpose>
        <docReference>doc/processors/DelayProcessor.md</docReference>
        <inputs>
          <port id="in" type="signal"/>
          <port id="time_mod_in" type="signal"/>
        </inputs>
        <outputs>
          <port id="out" type="signal"/>
        </outputs>
        <maxInstances>16</maxInstances>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="BaseNodeType">
        <xs:attribute name="time" type="DelayTimeRangeType" use="optional"/>
        <xs:attribute name="feedback" type="DelayFeedbackRangeType" use="optional"/>
        <xs:attribute name="mix" type="DelayMixRangeType" use="optional"/>
        <xs:attribute name="sync" type="SyncType" use="optional"/>
        <xs:attribute name="division" type="DivisionType" use="optional"/>
        <xs:attribute name="bypass" type="BypassType" use="optional"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- Sample hold (hold) -->
  <xs:complexType name="SampleHoldNodeType">
    <xs:annotation>
      <xs:appinfo xmlns="urn:smolfm:node-meta">
        <purpose>Hält das Eingangssignal für eine einstellbare Rasterdauer fest (Sample-and-Hold / Sample-Rate-Reduktion): der Ausgang liefert pro Raster eine neue eingefrorene L/R-Kopie, dazwischen denselben Wert. Die Raste läuft statisch in Hertz oder tempo-synchronisiert über eine Noten-Länge; rate_mod_in multipliziert die Rasterfrequenz. Dient der Bitcrush-Raster-Achse und als getakteter Mod-Stepper.</purpose>
        <docReference>doc/processors/SampleHoldProcessor.md</docReference>
        <inputs>
          <port id="in" type="signal"/>
          <port id="rate_mod_in" type="signal"/>
        </inputs>
        <outputs>
          <port id="out" type="signal"/>
        </outputs>
        <maxInstances>8</maxInstances>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="BaseNodeType">
        <xs:attribute name="rate" type="HoldRateRangeType" use="optional"/>
        <xs:attribute name="sync" type="SyncType" use="optional"/>
        <xs:attribute name="division" type="DivisionType" use="optional"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- Resonator (resonator) -->
  <xs:complexType name="ResonatorNodeType">
    <xs:annotation>
      <xs:appinfo xmlns="urn:smolfm:node-meta">
        <purpose>Angeregter Resonator zweiter Ordnung (komplexes Polpaar): der Exciter-Eingang kippt Energie in den Resonanzmodus, das Netzwerk antwortet abklingend pseudo-sinusförmig mit tune als Resonanzfrequenz. Dekay ist die Polradius-Abklingzeit (keine überlagerte Hüllkurve); vel auf Dekay skaliert die Abklingzeit nach dem Spread-Muster. Lange Dekay = Ring-Quelle (BD/Toms/Congas/Claves), kurzer Dekay = Körperfilter (Snare-Bodies); derselbe Kern in zwei quantitativen Lagen. Die tune-Port-Verbindung überschreibt die statische tune (Key-Tracking bleibt patchbar: note -> fscale -> tune). Interne Hieb (strikelevel/striketime, beide 0 = neutrale
          Abwesenheit = das alte Verhalten): die Note zaehlt den Koerper selbst; der Pegel folgt dem ROH-Anschluss strike_vel direkt (Kraftgesetz Energie vel^2).</purpose>
        <docReference>doc/processors/ResonatorProcessor.md</docReference>
        <inputs>
          <port id="in" type="signal"/>
          <port id="tune" type="frequency"/>
          <port id="q_mod_in" type="signal"/>
          <port id="vel" type="velocity"/>
          <port id="strike_vel" type="velocity"/>
        </inputs>
        <outputs>
          <port id="out" type="signal"/>
        </outputs>
        <maxInstances>8</maxInstances>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="BaseNodeType">
        <xs:attribute name="tune" type="ResonatorTuneRangeType" use="optional"/>
        <xs:attribute name="q" type="ResonatorQRangeType" use="optional"/>
        <xs:attribute name="decay" type="ResonatorDecayRangeType" use="optional"/>
        <xs:attribute name="strikelevel" type="StrikeLevelRangeType" use="optional"/>
        <xs:attribute name="striketime" type="StrikeTimeRangeType" use="optional"/>
        <xs:attribute name="spread" type="VelSpreadRangeType" use="optional"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- Feedback (feedback) -->
  <xs:complexType name="FeedbackNodeType">
    <xs:annotation>
      <xs:appinfo xmlns="urn:smolfm:node-meta">
        <purpose>Begrenzter Zyklusbrecher für Schaltungs-Rückkopplungen: out = in + amount * fb_in. Jeder Graph-Zyklus trägt implizit 1 Sample Verzögerung (der Rückkanal liest den vorherigen Tick des später geordneten Erzeugers); amount begrenzt pro Durchlauf die Energie (Stabilität bis 0.95). amount = 0: transparenter Durchlass.</purpose>
        <docReference>doc/processors/FeedbackProcessor.md</docReference>
        <inputs>
          <port id="in" type="signal"/>
          <port id="fb_in" type="signal"/>
        </inputs>
        <outputs>
          <port id="out" type="signal"/>
        </outputs>
        <maxInstances>4</maxInstances>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="BaseNodeType">
        <xs:attribute name="amount" type="FeedbackAmountRangeType" use="optional"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- Ring modulator (ring): parameter-free, like the note input. -->
  <xs:complexType name="RingModulatorNodeType">
    <xs:annotation>
      <xs:appinfo xmlns="urn:smolfm:node-meta">
        <purpose>Multipliziert beide Eingangssignale sampleweise (Ringmodulation) und gibt das Produkt aus. Erzeugt damit Nebenbänder beider Signale im Signal-Pfad.</purpose>
        <docReference>doc/processors/RingModulatorProcessor.md</docReference>
        <inputs>
          <port id="in1" type="signal"/>
          <port id="in2" type="signal"/>
        </inputs>
        <outputs>
          <port id="out" type="signal"/>
        </outputs>
        <maxInstances>8</maxInstances>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="BaseNodeType"/>
    </xs:complexContent>
  </xs:complexType>

  <!-- Splitter (split): parameter-free topology node with two outputs. -->
  <xs:complexType name="SplitterNodeType">
    <xs:annotation>
      <xs:appinfo xmlns="urn:smolfm:node-meta">
        <purpose>Teilt ein Stereo-Signal in seine Seitenzweige: outL = (L, 0), outR = (0, R). Jeder Zweig trägt nur eine Seite (seitenrein) und bleibt PortType::signal, damit er direkt jeden Standardprozessor speist. Ein Zweig kann direkt in den Master geroutet werden, ohne Merger.</purpose>
        <docReference>doc/processors/SplitterProcessor.md</docReference>
        <inputs>
          <port id="in" type="signal"/>
        </inputs>
        <outputs>
          <port id="outL" type="signal"/>
          <port id="outR" type="signal"/>
        </outputs>
        <maxInstances>8</maxInstances>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="BaseNodeType"/>
    </xs:complexContent>
  </xs:complexType>

  <!-- Merger (merge): parameter-free topology node with two inputs. -->
  <xs:complexType name="MergerNodeType">
    <xs:annotation>
      <xs:appinfo xmlns="urn:smolfm:node-meta">
        <purpose>FÃ¼hrt zwei Seitenzweige zu einem Stereo-Signal zusammen: out = (in1.L, in2.R). Eine unverbundene Seite trÃ¤gt 0 bei. Zentrierte Mono-Quellen dÃ¼rfen beide EingÃ¤nge speisen; der Ausgang ist dann wieder ein zentriertes Frame.</purpose>
        <docReference>doc/processors/MergerProcessor.md</docReference>
        <inputs>
          <port id="in1" type="signal"/>
          <port id="in2" type="signal"/>
        </inputs>
        <outputs>
          <port id="out" type="signal"/>
        </outputs>
        <maxInstances>8</maxInstances>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="BaseNodeType"/>
    </xs:complexContent>
  </xs:complexType>

  <!-- Adder (add): parameter-free summation node. -->
  <xs:complexType name="AdderNodeType">
    <xs:annotation>
      <xs:appinfo xmlns="urn:smolfm:node-meta">
        <purpose>Summiert zwei Signale sampleweise kanalweise: out = in1 + in2. Der Bus-Builder des Graphen: parallele Quellen (Oszillator-Schwärme, Layer-Stacks) werden vor einer gemeinsamen Downstream-Stufe (Filter, Shaper, Hüllkurve) zu EINEM Signal zusammengelegt. Eine unverbundene Seite liest 0 und trägt Stille bei; der Typ bleibt PortType::signal (Welt A: EIN Audiotyp).</purpose>
        <docReference>doc/processors/AdderProcessor.md</docReference>
        <inputs>
          <port id="in1" type="signal"/>
          <port id="in2" type="signal"/>
        </inputs>
        <outputs>
          <port id="out" type="signal"/>
        </outputs>
        <maxInstances>8</maxInstances>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="BaseNodeType"/>
    </xs:complexContent>
  </xs:complexType>

  <!-- AM modulator (am) -->
  <xs:complexType name="AMNodeType">
    <xs:annotation>
      <xs:appinfo xmlns="urn:smolfm:node-meta">
        <purpose>Moduliert die Amplitude des Trägersignals mit dem Modulatoreingang; Depth mischt zwischen unverändertem Durchgang und voller Modulation. Gibt das amplitudenmodulierte Signal weiter.</purpose>
        <docReference>doc/processors/AmProcessor.md</docReference>
        <inputs>
          <port id="carrier_in" type="signal"/>
          <port id="modulator_in" type="signal"/>
        </inputs>
        <outputs>
          <port id="out" type="signal"/>
        </outputs>
        <maxInstances>8</maxInstances>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="BaseNodeType">
        <xs:attribute name="amount" type="AmAmountRangeType" use="optional"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- Master output (output) -->
  <xs:complexType name="MasterOutputNodeType">
    <xs:annotation>
      <xs:appinfo xmlns="urn:smolfm:node-meta">
        <purpose>Summiert bis zu acht Eingangssignale und skaliert die Summe über den Master-Level auf den Hauptausgang. Bildet den Endpunkt des Signalgraphen und hat keinen Ausgangsport.</purpose>
        <docReference>doc/processors/MasterOutputProcessor.md</docReference>
        <inputs>
          <port id="in1" type="signal"/>
          <port id="in2" type="signal"/>
          <port id="in3" type="signal"/>
          <port id="in4" type="signal"/>
          <port id="in5" type="signal"/>
          <port id="in6" type="signal"/>
          <port id="in7" type="signal"/>
          <port id="in8" type="signal"/>
        </inputs>
        <maxInstances>1</maxInstances>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="BaseNodeType">
        <xs:attribute name="level" type="MasterLevelRangeType" use="optional"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- Presentation part: canvas layout; future UI settings extend this. -->
  <xs:complexType name="LayoutType">
    <xs:sequence>
      <xs:element name="Boxes" type="BoxesType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="BoxesType">
    <xs:sequence>
      <xs:element name="Box" type="BoxType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="BoxType">
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attribute name="x" type="xs:int" use="required"/>
    <xs:attribute name="y" type="xs:int" use="required"/>
    <xs:anyAttribute processContents="skip"/>
  </xs:complexType>

  <!-- Pin definition: ports are semantic, part of the graph. -->
  <!-- Connection endpoint classes: fixed direction + signal kind.  Strict
       validators apply them per <Pin xsi:type="...">; the loose writer
       output carries direction/type as enum attributes. -->
  <xs:complexType name="PinBaseType">
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="PinType">
    <xs:complexContent>
      <xs:extension base="PinBaseType">
        <xs:attribute name="direction" type="PortDirectionType" use="required"/>
        <xs:attribute name="type" type="PortKindType" use="required"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="FrequencyInPinType">
    <xs:complexContent>
      <xs:extension base="PinBaseType">
        <xs:attribute name="direction" type="PortDirectionType" use="required" fixed="in"/>
        <xs:attribute name="type" type="PortKindType" use="required" fixed="frequency"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="FrequencyOutPinType">
    <xs:complexContent>
      <xs:extension base="PinBaseType">
        <xs:attribute name="direction" type="PortDirectionType" use="required" fixed="out"/>
        <xs:attribute name="type" type="PortKindType" use="required" fixed="frequency"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="SignalInPinType">
    <xs:complexContent>
      <xs:extension base="PinBaseType">
        <xs:attribute name="direction" type="PortDirectionType" use="required" fixed="in"/>
        <xs:attribute name="type" type="PortKindType" use="required" fixed="signal"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="SignalOutPinType">
    <xs:complexContent>
      <xs:extension base="PinBaseType">
        <xs:attribute name="direction" type="PortDirectionType" use="required" fixed="out"/>
        <xs:attribute name="type" type="PortKindType" use="required" fixed="signal"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="VelocityInPinType">
    <xs:complexContent>
      <xs:extension base="PinBaseType">
        <xs:attribute name="direction" type="PortDirectionType" use="required" fixed="in"/>
        <xs:attribute name="type" type="PortKindType" use="required" fixed="velocity"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="VelocityOutPinType">
    <xs:complexContent>
      <xs:extension base="PinBaseType">
        <xs:attribute name="direction" type="PortDirectionType" use="required" fixed="out"/>
        <xs:attribute name="type" type="PortKindType" use="required" fixed="velocity"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- Connections container -->
  <xs:complexType name="ConnectionsType">
    <xs:sequence>
      <xs:element name="Wire" type="WireType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Wire definition -->
  <xs:complexType name="WireType">
    <xs:attribute name="from" type="xs:string" use="required"/>
    <xs:attribute name="fromPort" type="xs:string" use="required"/>
    <xs:attribute name="to" type="xs:string" use="required"/>
    <xs:attribute name="toPort" type="xs:string" use="required"/>
  </xs:complexType>

</xs:schema>
