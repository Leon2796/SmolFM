<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="Haas Flute">
  <Graph>
    <Nodes>
      <Node id="note">
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc0" waveform="sine" mode="lfo" lforate="5.2">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="fm0" amount="0.014">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="modulator_in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc1" waveform="triangle">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr0" attack="0.09" decay="0.5" sustain="0.72" release="0.5">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="split0">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="outL" direction="out" type="signal" />
        <Pin id="outR" direction="out" type="signal" />
      </Node>
      <Node id="delay0" time="9" feedback="0.0" mix="1.0" sync="off">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="merge0">
        <Pin id="in1" direction="in" type="signal" />
        <Pin id="in2" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc2" waveform="noise" mode="static" staticfreq="2400">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain0" factor="0.06">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr1" attack="0.12" decay="0.8" sustain="0.3" release="0.7">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.62">
        <Pin id="in1" direction="in" type="signal" />
        <Pin id="in2" direction="in" type="signal" />
      </Node>
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="fm0" toPort="freq_in" />
      <Wire from="osc0" fromPort="out" to="fm0" toPort="modulator_in" />
      <Wire from="fm0" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="osc1" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="split0" toPort="in" />
      <Wire from="split0" fromPort="outL" to="merge0" toPort="in1" />
      <Wire from="split0" fromPort="outR" to="delay0" toPort="in" />
      <Wire from="delay0" fromPort="out" to="merge0" toPort="in2" />
      <Wire from="merge0" fromPort="out" to="output" toPort="in1" />
      <Wire from="osc2" fromPort="out" to="gain0" toPort="in" />
      <Wire from="gain0" fromPort="out" to="adsr1" toPort="in" />
      <Wire from="adsr1" fromPort="out" to="output" toPort="in2" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="240" />
      <Box id="osc0" x="60" y="480" />
      <Box id="fm0" x="240" y="240" />
      <Box id="osc1" x="420" y="240" />
      <Box id="adsr0" x="600" y="240" />
      <Box id="split0" x="780" y="240" />
      <Box id="delay0" x="780" y="440" />
      <Box id="merge0" x="960" y="240" />
      <Box id="osc2" x="240" y="680" />
      <Box id="gain0" x="420" y="680" />
      <Box id="adsr1" x="600" y="680" />
      <Box id="output" x="1140" y="240" />
    </Boxes>
  </Layout>
</SmolFM>