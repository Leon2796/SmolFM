<?xml version="1.0" encoding="UTF-8"?>

<!-- High AM amount with slow LFO produces a rhythmic pump on a bright square lead -->
<SmolFM version="2" name="Sidechain Duck">
  <description>Square-wave carrier rhythmically ducked by a slow descending sine via deep AM — pumping, sidechain-like lead.</description>
  <Nodes>
    <Node id="note0" x="80" y="100">
      <Pin id="out" direction="out" type="frequency"/>
    </Node>

    <Node id="osc0" x="260" y="100" waveform="2">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>

    <Node id="note1" x="80" y="280">
      <Pin id="out" direction="out" type="frequency"/>
    </Node>

    <Node id="fscale0" x="260" y="280" factor="0.04">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>

    <Node id="osc1" x="440" y="280" waveform="0">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>

    <Node id="am0" x="620" y="190" amount="0.95">
      <Pin id="carrier_in" direction="in" type="signal"/>
      <Pin id="modulator_in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>

    <Node id="adsr0" x="800" y="100" attack="0.002" decay="0.2" sustain="0.6" release="0.2">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>

    <Node id="adsr1" x="800" y="300" attack="0.6" decay="0.4" sustain="0.9" release="0.5">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>

    <Node id="output" x="980" y="190" level="0.75">
      <Pin id="in1" direction="in" type="signal"/>
    </Node>
  </Nodes>

  <Connections>
    <Wire from="note0" fromPort="out" to="osc0" toPort="note_in"/>
    <Wire from="note1" fromPort="out" to="fscale0" toPort="freq_in"/>
    <Wire from="fscale0" fromPort="out" to="osc1" toPort="note_in"/>
    <Wire from="osc1" fromPort="out" to="adsr1" toPort="in"/>
    <Wire from="adsr1" fromPort="out" to="am0" toPort="modulator_in"/>
    <Wire from="osc0" fromPort="out" to="am0" toPort="carrier_in"/>
    <Wire from="am0" fromPort="out" to="adsr0" toPort="in"/>
    <Wire from="adsr0" fromPort="out" to="output" toPort="in1"/>
  </Connections>
</SmolFM>
