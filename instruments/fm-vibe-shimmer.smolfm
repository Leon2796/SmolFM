<?xml version="1.0" encoding="UTF-8"?>

<!-- Advanced: Vibraphone Shimmer (Dual Envelopes for FM Evolution) -->
<SmolFM version="2" name="Vibraphone Shimmer">
  <description>Independent envelopes for carrier and modulator create evolving shimmer</description>
  <Nodes>
    <Node id="note0" x="100" y="100"/>
    <Node id="note1" x="100" y="300"/>
    
    <Node id="fscale0" x="300" y="300" factor="4.0"/>
    
    <Node id="fm0" x="500" y="100" amount="1.6"/>
    
    <Node id="osc0" x="700" y="100" waveform="0"/>
    <Node id="osc1" x="500" y="300" waveform="0"/>
    
    <Node id="adsr0" x="900" y="100" attack="0.002" decay="1.0" sustain="0.2" release="0.5"/>
    <Node id="adsr1" x="500" y="400" attack="0.001" decay="1.5" sustain="0.4" release="1.2"/>
    
    <Node id="output" x="1100" y="100" level="0.6"/>
  </Nodes>
  <Connections>
    <Wire from="note0" fromPort="out" to="fm0" toPort="freq_in"/>
    <Wire from="note1" fromPort="out" to="fscale0" toPort="freq_in"/>
    <Wire from="fscale0" fromPort="out" to="osc1" toPort="note_in"/>
    
    <Wire from="osc1" fromPort="out" to="adsr1" toPort="in"/>
    <Wire from="adsr1" fromPort="out" to="fm0" toPort="modulator_in"/>
    
    <Wire from="fm0" fromPort="out" to="osc0" toPort="note_in"/>
    <Wire from="osc0" fromPort="out" to="adsr0" toPort="in"/>
    <Wire from="adsr0" fromPort="out" to="output" toPort="in1"/>
  </Connections>
</SmolFM>