      <Node id="add0" />
      <Node id="add1" />
      <Node id="add2" />
      <Node id="add3" />
      <Node id="add4" />
      <Node id="add5" />
      <Node id="add6" />
      <Node id="shape0" shape="soft" drive="0.5" />
      <Node id="filter0" mode="bp" cutoff="10800" resonance="0.58" />
      <Node id="adsr0" attack="0.001" decay="3.4" sustain="0" release="0.4" />
      <Node id="gain0" factor="0.46" />
      <Node id="osc8" waveform="noise" mode="static" staticfreq="9000" />
      <Node id="adsr1" attack="0.001" decay="3.6" sustain="0" release="0.35" />
      <Node id="filter1" mode="hp" cutoff="7200" resonance="0.25" />
      <Node id="gain1" factor="0.36" />
      <Node id="vsc0" curve="sqrt" scale="2.6" />
      <Node id="output" level="0.75" />
    </Nodes>
    <Connections>
      <Wire from="osc0" fromPort="out" to="add0" toPort="in1" />
      <Wire from="osc1" fromPort="out" to="add0" toPort="in2" />
