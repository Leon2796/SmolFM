<?xml version="1.0" encoding="UTF-8"-->

<SmolFM version="2" name="fadsr-metal-drop-perc">
  <description>Metallic percussion: the F-ADSR drops the carrier pitch from 3x down to playing pitch over a fast decay (inverted pitch drop), while a chained inharmonic FM stage with keyboard-tracked modulators creates the metallic spectrum; short amplitude envelope keeps it percussive.</description>
  <Nodes>
    <Node id="note0" x="60" y="60">
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="fadsr0" x="360" y="60" attack="0.001" decay="0.18" sustain="0.0" release="0.1" up="3.0" down="1.0">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="fm0" x="360" y="380" amount="3.0">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="modulator_in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="note1" x="60" y="380">
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="fscale0" x="60" y="680" factor="3.55"/>
    <Node id="osc1" x="360" y="680" waveform="0">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="osc0" x="680" y="60" waveform="0">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="adsr0" x="1000" y="60" attack="0.001" decay="0.35" sustain="0.0" release="0.2">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="output" x="1320" y="60" level="0.8"/>
  </Nodes>
  <Connections>
    <Wire from="note0" fromPort="out" to="fm0" toPort="freq_in"/>
    <Wire from="note1" fromPort="out" to="fscale0" toPort="freq_in"/>
    <Wire from="fscale0" fromPort="out" to="osc1" toPort="note_in"/>
    <Wire from="osc1" fromPort="out" to="fm0" toPort="modulator_in"/>
    <Wire from="fm0" fromPort="out" to="fadsr0" toPort="freq_in"/>
    <Wire from="fadsr0" fromPort="out" to="osc0" toPort="note_in"/>
    <Wire from="osc0" fromPort="out" to="adsr0" toPort="in"/>
    <Wire from="adsr0" fromPort="out" to="output" toPort="in1"/>
  </Connections>
</SmolFM>