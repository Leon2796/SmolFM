<?xml version="1.0" encoding="UTF-8"?>

<!-- Inharmonic FM bell fed through ring-mod and a slow amplitude swell -->
<SmolFM version="2" name="Granite Chimes">
  <description>Deep sine modulates a sine carrier via FM (ratio ~2.76), ring-mod multiplied with a sub-octave square; gentle AM swell at 0.4 Hz gives a breathy tail.</description>
  <Nodes>
    <Node id="note0" x="80" y="60">
      <Pin id="out" direction="out" type="frequency"/>
    </Node>

    <!-- FM chain: modulator at 2.76x -->
    <Node id="fscale0" x="260" y="60" factor="2.76">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="osc0" x="440" y="60" waveform="0">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="fm0" x="620" y="60" amount="0.35">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="modulator_in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="osc1" x="800" y="60" waveform="0">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>

    <!-- Sub-octave square for ring-mod weight -->
    <Node id="fscale1" x="260" y="240" factor="0.5">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="osc2" x="440" y="240" waveform="2">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>

    <!-- Ring mod multiplies FM bell by sub square -->
    <Node id="ring0" x="620" y="240">
      <Pin id="in1" direction="in" type="signal"/>
      <Pin id="in2" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>

    <!-- Slow AM swell (0.4 Hz) -->
    <Node id="note1" x="80" y="420">
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="fscale2" x="260" y="420" factor="0.04">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="osc3" x="440" y="420" waveform="0">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="am0" x="800" y="180" amount="0.35">
      <Pin id="carrier_in" direction="in" type="signal"/>
      <Pin id="modulator_in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>

    <!-- Envelope: fast percussive attack, long decay -->
    <Node id="adsr0" x="980" y="180" attack="0.003" decay="1.8" sustain="0.1" release="2.5">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>

    <Node id="output" x="1180" y="180" level="0.7">
      <Pin id="in1" direction="in" type="signal"/>
    </Node>
  </Nodes>

  <Connections>
    <Wire from="note0" fromPort="out" to="fscale0" toPort="freq_in"/>
    <Wire from="fscale0" fromPort="out" to="osc0" toPort="note_in"/>
    <Wire from="note0" fromPort="out" to="fm0" toPort="freq_in"/>
    <Wire from="osc0" fromPort="out" to="fm0" toPort="modulator_in"/>
    <Wire from="fm0" fromPort="out" to="osc1" toPort="note_in"/>

    <Wire from="note0" fromPort="out" to="fscale1" toPort="freq_in"/>
    <Wire from="fscale1" fromPort="out" to="osc2" toPort="note_in"/>

    <Wire from="osc1" fromPort="out" to="ring0" toPort="in1"/>
    <Wire from="osc2" fromPort="out" to="ring0" toPort="in2"/>

    <Wire from="note1" fromPort="out" to="fscale2" toPort="freq_in"/>
    <Wire from="fscale2" fromPort="out" to="osc3" toPort="note_in"/>
    <Wire from="ring0" fromPort="out" to="am0" toPort="carrier_in"/>
    <Wire from="osc3" fromPort="out" to="am0" toPort="modulator_in"/>

    <Wire from="am0" fromPort="out" to="adsr0" toPort="in"/>
    <Wire from="adsr0" fromPort="out" to="output" toPort="in1"/>
  </Connections>
</SmolFM>
