<SmolFM version="3" name="Granite Chimes">
  <Graph>
    <Nodes>
      <Node id="note">
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fscale0" factor="2.76">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc0" waveform="sine">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="fm0" amount="0.35">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="modulator_in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc1" waveform="sine">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="fscale1" factor="0.5">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc2" waveform="square">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="ring0">
        <Pin id="in1" direction="in" type="signal" />
        <Pin id="in2" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="fscale2" factor="0.04">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc3" waveform="sine">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="am0" amount="0.35">
        <Pin id="carrier_in" direction="in" type="signal" />
        <Pin id="modulator_in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr0" attack="0.003" decay="1.8" sustain="0.1" release="2.5">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.7">
        <Pin id="in1" direction="in" type="signal" />
      </Node>
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in" />
      <Wire from="fscale0" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="note" fromPort="out" to="fm0" toPort="freq_in" />
      <Wire from="osc0" fromPort="out" to="fm0" toPort="modulator_in" />
      <Wire from="fm0" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="note" fromPort="out" to="fscale1" toPort="freq_in" />
      <Wire from="fscale1" fromPort="out" to="osc2" toPort="note_in" />
      <Wire from="osc1" fromPort="out" to="ring0" toPort="in1" />
      <Wire from="osc2" fromPort="out" to="ring0" toPort="in2" />
      <Wire from="note" fromPort="out" to="fscale2" toPort="freq_in" />
      <Wire from="fscale2" fromPort="out" to="osc3" toPort="note_in" />
      <Wire from="ring0" fromPort="out" to="am0" toPort="carrier_in" />
      <Wire from="osc3" fromPort="out" to="am0" toPort="modulator_in" />
      <Wire from="am0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="80" y="60" />
      <Box id="fscale0" x="260" y="60" />
      <Box id="osc0" x="440" y="60" />
      <Box id="fm0" x="620" y="60" />
      <Box id="osc1" x="800" y="60" />
      <Box id="fscale1" x="260" y="240" />
      <Box id="osc2" x="440" y="240" />
      <Box id="ring0" x="620" y="240" />
      <Box id="fscale2" x="260" y="420" />
      <Box id="osc3" x="440" y="420" />
      <Box id="am0" x="800" y="180" />
      <Box id="adsr0" x="980" y="180" />
      <Box id="output" x="1180" y="180" />
    </Boxes>
  </Layout>
</SmolFM>