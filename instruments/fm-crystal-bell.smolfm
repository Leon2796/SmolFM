<SmolFM version="3" name="Crystal Bell">
  <Graph>
    <Nodes>
      <Node id="note" />
      <Node id="fscale0" factor="1.618" />
      <Node id="fscale1" factor="3.14159" />
      <Node id="fscale2" factor="0.618" />
      <Node id="fm0" amount="2.2" />
      <Node id="fm1" amount="1.8" />
      <Node id="fm2" amount="1.5" />
      <Node id="osc0" waveform="sine" />
      <Node id="osc1" waveform="sine" />
      <Node id="osc2" waveform="sine" />
      <Node id="osc3" waveform="sine" />
      <Node id="adsr0" attack="0.001" decay="1.8" sustain="0.0" release="1.5" />
      <Node id="output" level="0.65" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="fm0" toPort="freq_in" />
      <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in" />
      <Wire from="fscale0" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="osc1" fromPort="out" to="fm0" toPort="modulator_in" />
      <Wire from="fm0" fromPort="out" to="fm1" toPort="freq_in" />
      <Wire from="note" fromPort="out" to="fscale1" toPort="freq_in" />
      <Wire from="fscale1" fromPort="out" to="osc2" toPort="note_in" />
      <Wire from="osc2" fromPort="out" to="fm1" toPort="modulator_in" />
      <Wire from="fm1" fromPort="out" to="fm2" toPort="freq_in" />
      <Wire from="note" fromPort="out" to="fscale2" toPort="freq_in" />
      <Wire from="fscale2" fromPort="out" to="osc3" toPort="note_in" />
      <Wire from="osc3" fromPort="out" to="fm2" toPort="modulator_in" />
      <Wire from="fm2" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="60" />
      <Box id="fscale0" x="380" y="320" />
      <Box id="fscale1" x="380" y="580" />
      <Box id="fscale2" x="380" y="840" />
      <Box id="fm0" x="700" y="60" />
      <Box id="fm1" x="700" y="320" />
      <Box id="fm2" x="700" y="580" />
      <Box id="osc0" x="1340" y="60" />
      <Box id="osc1" x="1020" y="320" />
      <Box id="osc2" x="1020" y="580" />
      <Box id="osc3" x="1020" y="840" />
      <Box id="adsr0" x="1660" y="60" />
      <Box id="output" x="1980" y="60" />
    </Boxes>
  </Layout>
</SmolFM>