<?xml version="1.0" encoding="UTF-8"?>

<!--
  Klassischer FM-Patch im Frequenz-Flow:
  note0 -> fm0 (Hz biegen) -> osc0 (Carrier rendert) -> adsr.
  Modulator osc1 wird ueber note1 -> fscale0 (Faktor 0.1136, ~50 Hz bei A4)
  mit einer langsamen, deutlich hoerbaren Rate gespeist.
-->
<SmolFM version="2">
  <Nodes>
    <Node id="note0" x="272" y="403">
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="osc0" x="734" y="69" waveform="0.0">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="fm0" x="1212" y="269" amount="1.080000281333923">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="modulator_in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="osc1" x="738" y="544" waveform="0.0">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="note1" x="272" y="620"/>
    <Node id="fscale0" x="420" y="600" factor="0.1136"/>
    <Node id="adsr" x="1699" y="271" attack="0.02800000086426735" decay="1.310000061988831"
          sustain="0.4480000138282776" release="0.5">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
  </Nodes>
  <Connections>
    <Wire from="note0" fromPort="out" to="fm0" toPort="freq_in"/>
    <Wire from="osc1" fromPort="out" to="fm0" toPort="modulator_in"/>
    <Wire from="fm0" fromPort="out" to="osc0" toPort="note_in"/>
    <Wire from="osc0" fromPort="out" to="adsr" toPort="in"/>
    <Wire from="note1" fromPort="out" to="fscale0" toPort="freq_in"/>
    <Wire from="fscale0" fromPort="out" to="osc1" toPort="note_in"/>
  </Connections>
</SmolFM>
