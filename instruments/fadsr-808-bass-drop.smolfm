<?xml version="1.0" encoding="UTF-8"?>

<SmolFM version="2" name="fadsr-808-bass-drop">
  <description>Classic 808-style kick/bass body: the F-ADSR pitch envelope starts the carrier at 0 Hz and glides it to the played pitch over 30 ms, with a fast amplitude envelope for punch.</description>
  <Nodes>
    <Node id="note" x="60" y="60">
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="fadsr0" x="360" y="60" attack="0.03" decay="0.12" sustain="0.0" release="0.1" up="1.0" down="0.0">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="osc0" x="680" y="60" waveform="0">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="adsr0" x="1000" y="60" attack="0.001" decay="0.45" sustain="0.0" release="0.15">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="output" x="1320" y="60" level="0.9"/>
  </Nodes>
  <Connections>
    <Wire from="note" fromPort="out" to="fadsr0" toPort="freq_in"/>
    <Wire from="fadsr0" fromPort="out" to="osc0" toPort="note_in"/>
    <Wire from="osc0" fromPort="out" to="adsr0" toPort="in"/>
    <Wire from="adsr0" fromPort="out" to="output" toPort="in1"/>
  </Connections>
</SmolFM>