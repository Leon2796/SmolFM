<?xml version="1.0" encoding="UTF-8"?>

<SmolFM version="2" name="fadsr-echo-gate-machine">
  <description>Rhythmic echo machine: one F-ADSR pitch-blip carrier feeds four parallel delays at different tempo divisions (1/4, 1/8, 1/16 dotted feel via different ms values), each with its own feedback, stacked into four output inputs; a slow fscale-derived AM gate chops the mixed tail.</description>
  <Nodes>
    <Node id="note" x="60" y="60">
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="fadsr0" x="360" y="60" attack="0.001" decay="0.08" sustain="0.0" release="0.05" up="1.5" down="0.98">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="osc0" x="680" y="60" waveform="2">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="adsr0" x="680" y="380" attack="0.001" decay="0.12" sustain="0.0" release="0.1">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="delay0" x="1000" y="60" time="250" feedback="0.55" mix="0.9" sync="1" division="1">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="delay1" x="1000" y="260" time="125" feedback="0.45" mix="0.9" sync="1" division="2">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="delay2" x="1000" y="460" time="93" feedback="0.4" mix="0.9" sync="1" division="3">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="delay3" x="1000" y="660" time="167" feedback="0.6" mix="0.9" sync="1" division="2">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="output" x="1340" y="60" level="0.75"/>
  </Nodes>
  <Connections>
    <Wire from="note" fromPort="out" to="fadsr0" toPort="freq_in"/>
    <Wire from="fadsr0" fromPort="out" to="osc0" toPort="note_in"/>
    <Wire from="osc0" fromPort="out" to="adsr0" toPort="in"/>
    <Wire from="adsr0" fromPort="out" to="delay0" toPort="in"/>
    <Wire from="adsr0" fromPort="out" to="delay1" toPort="in"/>
    <Wire from="adsr0" fromPort="out" to="delay2" toPort="in"/>
    <Wire from="adsr0" fromPort="out" to="delay3" toPort="in"/>
    <Wire from="delay0" fromPort="out" to="output" toPort="in1"/>
    <Wire from="delay1" fromPort="out" to="output" toPort="in2"/>
    <Wire from="delay2" fromPort="out" to="output" toPort="in3"/>
    <Wire from="delay3" fromPort="out" to="output" toPort="in4"/>
  </Connections>
</SmolFM>