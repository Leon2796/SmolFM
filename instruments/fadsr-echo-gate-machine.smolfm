<SmolFM version="3" name="fadsr-echo-gate-machine">
  <Graph>
    <Nodes>
      <Node id="note">
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fadsr0" attack="0.001" decay="0.08" sustain="0.0" release="0.05" up="1.5" down="0.98">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc0" waveform="square">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr0" attack="0.001" decay="0.12" sustain="0.0" release="0.1">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="delay0" time="250" feedback="0.55" mix="0.9" sync="on" division="quarter">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="delay1" time="125" feedback="0.45" mix="0.9" sync="on" division="eighth">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="delay2" time="93" feedback="0.4" mix="0.9" sync="on" division="sixteenth">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="delay3" time="167" feedback="0.6" mix="0.9" sync="on" division="eighth">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.75" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="fadsr0" toPort="freq_in" />
      <Wire from="fadsr0" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="delay0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="delay1" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="delay2" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="delay3" toPort="in" />
      <Wire from="delay0" fromPort="out" to="output" toPort="in1" />
      <Wire from="delay1" fromPort="out" to="output" toPort="in2" />
      <Wire from="delay2" fromPort="out" to="output" toPort="in3" />
      <Wire from="delay3" fromPort="out" to="output" toPort="in4" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="60" />
      <Box id="fadsr0" x="360" y="60" />
      <Box id="osc0" x="680" y="60" />
      <Box id="adsr0" x="680" y="380" />
      <Box id="delay0" x="1000" y="60" />
      <Box id="delay1" x="1000" y="260" />
      <Box id="delay2" x="1000" y="460" />
      <Box id="delay3" x="1000" y="660" />
      <Box id="output" x="1340" y="60" />
    </Boxes>
  </Layout>
</SmolFM>