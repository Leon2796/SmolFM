<?xml version="1.0" encoding="UTF-8"?>

<!--
  Reiner Sinus ohne FM, migriert auf Instanz-IDs:
  note -> osc0 -> adsr.  fm0 und osc1 liegen unverdrahtet auf dem Canvas
  und haben keinen Einfluss auf den Klang.
-->
<SmolFM version="2">
  <Nodes>
    <Node id="note" x="272" y="403">
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="osc0" x="734" y="69" frequency="1195.000610351562" waveform="0.0">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="fm0" x="1324" y="707" amount="1.080000281333923">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="modulator_in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="osc1" x="738" y="544" frequency="50.0" waveform="0.0">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="adsr" x="1699" y="271" attack="0.001000000047497451" decay="0.5390000343322754"
          sustain="0.335999995470047" release="1.445000171661377">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
  </Nodes>
  <Connections>
    <Wire from="note" fromPort="out" to="osc0" toPort="note_in"/>
    <Wire from="osc0" fromPort="out" to="adsr" toPort="in"/>
  </Connections>
</SmolFM>
