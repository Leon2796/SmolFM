<?xml version="1.0" encoding="UTF-8"-->

<SmolFM version="2" name="fadsr-rubber-bass-growl">
  <description>Rubber bass: the F-ADSR drops the carrier pitch from below (factor 0.5) up to playing pitch with a slow-ish attack, then a fast FM growl from a saw modulator adds grit that follows the same pitch sweep.</description>
  <Nodes>
    <Node id="note0" x="60" y="60">
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="fadsr0" x="360" y="60" attack="0.08" decay="0.25" sustain="0.6" release="0.3" up="1.0" down="0.5">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="fm0" x="360" y="380" amount="0.9">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="modulator_in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="note1" x="60" y="380">
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="fscale0" x="60" y="680" factor="2.0"/>
    <Node id="osc1" x="360" y="680" waveform="1">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="osc0" x="680" y="60" waveform="1">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="adsr0" x="1000" y="60" attack="0.005" decay="0.2" sustain="0.75" release="0.15">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="output" x="1320" y="60" level="0.85"/>
  </Nodes>
  <Connections>
    <Wire from="note0" fromPort="out" to="fm0" toPort="freq_in"/>
    <Wire from="note1" fromPort="out" to="fscale0" toPort="freq_in"/>
    <Wire from="fscale0" fromPort="out" to="osc1" toPort="note_in"/>
    <Wire from="osc1" fromPort="out" to="fm0" toPort="modulator_in"/>
    <Wire from="fm0" fromPort="out" to="fadsr0" toPort="freq_in"/>
    <Wire from="fadsr0" fromPort="out" to="osc0" toPort="note_in"/>
    <Wire from="osc0" fromPort="out" to="adsr0" toPort="in"/>
    <Wire from="adsr0" fromPort="out" to="output" toPort="in1"/>
  </Connections>
</SmolFM>