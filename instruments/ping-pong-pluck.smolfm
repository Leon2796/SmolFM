<?xml version="1.0" encoding="UTF-8"?>

<!-- Ping-pong pluck: bright FM lead into two parallel tempo-synced delays with different divisions that answer each other across the stereo field -->
<SmolFM version="2" name="Ping-Pong Pluck">
  <description>Plucked saw FM voice split into two synced delays — 1/4 + 1/8 dotted pattern — fed from the same envelope for a cascading ping-pong tail.</description>
  <Nodes>
    <Node id="note0" x="60" y="140">
      <Pin id="out" direction="out" type="frequency"/>
    </Node>

    <!-- Pluck voice: saw carrier, sine mod at 1.5x for attack click -->
    <Node id="fscale0" x="240" y="80" factor="1.5">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="osc0" x="420" y="80" waveform="0">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="fm0" x="600" y="80" amount="0.25">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="modulator_in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="osc1" x="780" y="80" waveform="1">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>

    <!-- Pluck envelope -->
    <Node id="adsr0" x="600" y="240" attack="0.001" decay="0.25" sustain="0.0" release="0.15">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>

    <!-- Two synced delays with different divisions -->
    <Node id="delay0" x="780" y="220" time="500" feedback="0.5" mix="0.6" sync="1" division="1">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="delay1" x="780" y="340" time="250" feedback="0.35" mix="0.6" sync="1" division="2">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>

    <Node id="output" x="980" y="240" level="0.7">
      <Pin id="in1" direction="in" type="signal"/>
      <Pin id="in2" direction="in" type="signal"/>
    </Node>
  </Nodes>

  <Connections>
    <Wire from="note0" fromPort="out" to="fscale0" toPort="freq_in"/>
    <Wire from="fscale0" fromPort="out" to="osc0" toPort="note_in"/>
    <Wire from="note0" fromPort="out" to="fm0" toPort="freq_in"/>
    <Wire from="osc0" fromPort="out" to="fm0" toPort="modulator_in"/>
    <Wire from="fm0" fromPort="out" to="osc1" toPort="note_in"/>

    <Wire from="osc1" fromPort="out" to="adsr0" toPort="in"/>

    <!-- Same feed into both delays -->
    <Wire from="adsr0" fromPort="out" to="delay0" toPort="in"/>
    <Wire from="adsr0" fromPort="out" to="delay1" toPort="in"/>

    <Wire from="delay0" fromPort="out" to="output" toPort="in1"/>
    <Wire from="delay1" fromPort="out" to="output" toPort="in2"/>
  </Connections>
</SmolFM>
