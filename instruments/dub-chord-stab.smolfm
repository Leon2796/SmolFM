<?xml version="1.0" encoding="UTF-8"?>

<!-- Dub chord stab: FM stack with percussive attack, tempo-synced 1/8 delay creates syncopated echoes -->
<SmolFM version="2" name="Dub Chord Stab">
  <description>Sine modulated by FM (ratio 4.0) with a hard gate envelope, sent to a 1/8-note tempo-synced delay with 55 percent feedback — each stab produces a rhythmic echo train tied to the host bpm.</description>
  <Nodes>
    <Node id="note0" x="80" y="100">
      <Pin id="out" direction="out" type="frequency"/>
    </Node>

    <!-- FM stack: high ratio for metallic transient -->
    <Node id="fscale0" x="260" y="60" factor="4.0">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="osc0" x="440" y="60" waveform="0">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="fm0" x="620" y="60" amount="0.4">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="modulator_in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="osc1" x="800" y="60" waveform="0">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>

    <!-- Short stab envelope -->
    <Node id="adsr0" x="620" y="260" attack="0.001" decay="0.15" sustain="0.0" release="0.1">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>

    <!-- Synced 1/8 delay with heavy feedback -->
    <Node id="delay0" x="800" y="260" time="250" feedback="0.55" mix="0.45" sync="1" division="2">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>

    <Node id="output" x="980" y="260" level="0.75">
      <Pin id="in1" direction="in" type="signal"/>
    </Node>
  </Nodes>

  <Connections>
    <Wire from="note0" fromPort="out" to="fscale0" toPort="freq_in"/>
    <Wire from="fscale0" fromPort="out" to="osc0" toPort="note_in"/>
    <Wire from="note0" fromPort="out" to="fm0" toPort="freq_in"/>
    <Wire from="osc0" fromPort="out" to="fm0" toPort="modulator_in"/>
    <Wire from="fm0" fromPort="out" to="osc1" toPort="note_in"/>

    <Wire from="osc1" fromPort="out" to="adsr0" toPort="in"/>
    <Wire from="adsr0" fromPort="out" to="delay0" toPort="in"/>
    <Wire from="delay0" fromPort="out" to="output" toPort="in1"/>
  </Connections>
</SmolFM>
