<?xml version="1.0" encoding="UTF-8"?>

<!--
  Demo 3: Growl-Bass  (doppelte FM: fm0 -> fm1 -> osc0)

  Klangidee: Saw-Carrier + FM eine Oktave tiefer (Mod1 = 220 Hz, 0.5:1)
  verdichtet das Spektrum nach unten. Mod2 ist minimal verstimmt
  (442 Hz statt 440 Hz): Durch die Verkettung schwebt die zweite Stufe
  gegen die erste - das langsame Beating ist der "Growl".

  Tipp: Tief spielen (A1-A3), dort wirkt die 0.5:1-Stufe am staerksten.
-->
<SmolFM version="2">
  <Nodes>
    <Node id="note" x="60" y="300">
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="osc0" x="940" y="180" frequency="440.0" waveform="1">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="osc1" x="60" y="540" frequency="220.0" waveform="0">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="osc2" x="360" y="580" frequency="442.0" waveform="0">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="fm0" x="360" y="220" amount="2.0">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="modulator_in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="fm1" x="660" y="260" amount="1.8">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="modulator_in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="adsr" x="1220" y="280" attack="0.01" decay="0.3" sustain="0.9" release="0.2">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
  </Nodes>
  <Connections>
    <Wire from="note" fromPort="out" to="fm0" toPort="freq_in"/>
    <Wire from="osc1" fromPort="out" to="fm0" toPort="modulator_in"/>
    <Wire from="fm0" fromPort="out" to="fm1" toPort="freq_in"/>
    <Wire from="osc2" fromPort="out" to="fm1" toPort="modulator_in"/>
    <Wire from="fm1" fromPort="out" to="osc0" toPort="note_in"/>
    <Wire from="osc0" fromPort="out" to="adsr" toPort="in"/>
  </Connections>
</SmolFM>
