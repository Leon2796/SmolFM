<?xml version="1.0" encoding="UTF-8"?>

<!-- Advanced: Brass Swell (Pre-FM Modulator Envelope) -->
<SmolFM version="2" name="Brass Swell">
  <description>ADSR on modulator creates evolving FM intensity for swelling brass</description>
  <Nodes>
    <Node id="note0" x="60" y="60"/>
    <Node id="note1" x="60" y="380"/>
    
    <Node id="fscale0" x="380" y="380" factor="1.0"/>
    
    <Node id="fm0" x="700" y="60" amount="1.2"/>
    
    <Node id="osc0" x="1020" y="60" waveform="1"/>
    <Node id="osc1" x="1020" y="380" waveform="1"/>
    
    <Node id="adsr0" x="1340" y="60" attack="0.15" decay="0.3" sustain="0.7" release="0.3"/>
    <Node id="adsr1" x="700" y="380" attack="0.4" decay="0.2" sustain="0.8" release="0.2"/>
    
    <Node id="output" x="1660" y="60" level="0.75"/>
  </Nodes>
  <Connections>
    <Wire from="note0" fromPort="out" to="fm0" toPort="freq_in"/>
    <Wire from="note1" fromPort="out" to="fscale0" toPort="freq_in"/>
    <Wire from="fscale0" fromPort="out" to="osc1" toPort="note_in"/>
    
    <Wire from="osc1" fromPort="out" to="adsr1" toPort="in"/>
    <Wire from="adsr1" fromPort="out" to="fm0" toPort="modulator_in"/>
    
    <Wire from="fm0" fromPort="out" to="osc0" toPort="note_in"/>
    <Wire from="osc0" fromPort="out" to="adsr0" toPort="in"/>
    <Wire from="adsr0" fromPort="out" to="output" toPort="in1"/>
  </Connections>
</SmolFM>