<?xml version="1.0" encoding="UTF-8"?>

<!-- Advanced: Choir Pad (4-Voice Formant Layering) -->
<SmolFM version="2" name="Choir Pad">
  <description>Multi-voice detuned saw pad with sub octave and ensemble width</description>
  <Nodes>
    <Node id="note0" x="60" y="60"/>
    <Node id="note1" x="60" y="320"/>
    <Node id="note2" x="60" y="580"/>
    <Node id="note3" x="60" y="840"/>
    
    <Node id="fscale0" x="380" y="320" factor="0.5"/>
    <Node id="fscale1" x="380" y="580" factor="1.007"/>
    <Node id="fscale2" x="380" y="840" factor="0.993"/>
    
    <Node id="osc0" x="1020" y="60" waveform="1"/>
    <Node id="osc1" x="1020" y="320" waveform="1"/>
    <Node id="osc2" x="1020" y="580" waveform="1"/>
    <Node id="osc3" x="1020" y="840" waveform="1"/>
    
    <Node id="adsr0" x="1340" y="220" attack="1.2" decay="1.5" sustain="0.75" release="3.0"/>
    <Node id="adsr1" x="1340" y="480" attack="1.4" decay="1.6" sustain="0.7" release="3.2"/>
    
    <Node id="output" x="1660" y="480" level="0.2"/>
  </Nodes>
  <Connections>
    <Wire from="note0" fromPort="out" to="osc0" toPort="note_in"/>
    <Wire from="note1" fromPort="out" to="fscale0" toPort="freq_in"/>
    <Wire from="fscale0" fromPort="out" to="osc1" toPort="note_in"/>
    <Wire from="note2" fromPort="out" to="fscale1" toPort="freq_in"/>
    <Wire from="fscale1" fromPort="out" to="osc2" toPort="note_in"/>
    <Wire from="note3" fromPort="out" to="fscale2" toPort="freq_in"/>
    <Wire from="fscale2" fromPort="out" to="osc3" toPort="note_in"/>
    
    <Wire from="osc0" fromPort="out" to="adsr0" toPort="in"/>
    <Wire from="osc1" fromPort="out" to="adsr1" toPort="in"/>
    
    <Wire from="adsr0" fromPort="out" to="output" toPort="in1"/>
    <Wire from="osc2" fromPort="out" to="output" toPort="in2"/>
    <Wire from="adsr1" fromPort="out" to="output" toPort="in3"/>
    <Wire from="osc3" fromPort="out" to="output" toPort="in4"/>
  </Connections>
</SmolFM>