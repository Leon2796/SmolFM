<SmolFM version="3" name="Acid Reactor">
  <Graph>
    <Nodes>
      <Node id="note">
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc0" waveform="sine">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="fm0" amount="0.5">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="modulator_in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc1" waveform="saw">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="fscale0" factor="3.0">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc2" waveform="sine">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="fm1" amount="0.75">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="modulator_in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc3" waveform="triangle">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="ring0">
        <Pin id="in1" direction="in" type="signal" />
        <Pin id="in2" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="fscale1" factor="0.08">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc4" waveform="sine">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="am0" amount="0.95">
        <Pin id="carrier_in" direction="in" type="signal" />
        <Pin id="modulator_in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr0" attack="0.002" decay="0.12" sustain="0.0" release="0.08">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.8">
        <Pin id="in1" direction="in" type="signal" />
      </Node>
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="fm0" toPort="freq_in" />
      <Wire from="osc0" fromPort="out" to="fm0" toPort="modulator_in" />
      <Wire from="fm0" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in" />
      <Wire from="fscale0" fromPort="out" to="osc2" toPort="note_in" />
      <Wire from="note" fromPort="out" to="fm1" toPort="freq_in" />
      <Wire from="osc2" fromPort="out" to="fm1" toPort="modulator_in" />
      <Wire from="fm1" fromPort="out" to="osc3" toPort="note_in" />
      <Wire from="osc1" fromPort="out" to="ring0" toPort="in1" />
      <Wire from="osc3" fromPort="out" to="ring0" toPort="in2" />
      <Wire from="note" fromPort="out" to="fscale1" toPort="freq_in" />
      <Wire from="fscale1" fromPort="out" to="osc4" toPort="note_in" />
      <Wire from="ring0" fromPort="out" to="am0" toPort="carrier_in" />
      <Wire from="osc4" fromPort="out" to="am0" toPort="modulator_in" />
      <Wire from="am0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="60" />
      <Box id="osc0" x="240" y="60" />
      <Box id="fm0" x="420" y="60" />
      <Box id="osc1" x="600" y="60" />
      <Box id="fscale0" x="240" y="260" />
      <Box id="osc2" x="420" y="260" />
      <Box id="fm1" x="600" y="260" />
      <Box id="osc3" x="780" y="260" />
      <Box id="ring0" x="780" y="160" />
      <Box id="fscale1" x="240" y="440" />
      <Box id="osc4" x="420" y="440" />
      <Box id="am0" x="960" y="160" />
      <Box id="adsr0" x="1140" y="160" />
      <Box id="output" x="1320" y="160" />
    </Boxes>
  </Layout>
</SmolFM>