<?xml version="1.0" encoding="UTF-8"?>

<!-- Cross-FM oscillator pair through ring mod with hard AM chopping -->
<SmolFM version="2" name="Acid Reactor">
  <description>Two FM pairs at 1:1 and 1:3 ratios ring-modulated together; fast 8 Hz AM with high depth chops the aggressive spectrum into a techno stab.</description>
  <Nodes>
    <Node id="note0" x="60" y="60">
      <Pin id="out" direction="out" type="frequency"/>
    </Node>

    <!-- Pair A: unity FM -->
    <Node id="osc0" x="240" y="60" waveform="0">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="fm0" x="420" y="60" amount="0.5">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="modulator_in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="osc1" x="600" y="60" waveform="1">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>

    <!-- Pair B: 3:1 ratio FM -->
    <Node id="fscale0" x="240" y="260" factor="3.0">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="osc2" x="420" y="260" waveform="0">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="fm1" x="600" y="260" amount="0.75">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="modulator_in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="osc3" x="780" y="260" waveform="3">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>

    <!-- Cross multiplication -->
    <Node id="ring0" x="780" y="160">
      <Pin id="in1" direction="in" type="signal"/>
      <Pin id="in2" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>

    <!-- Hard chop AM -->
    <Node id="note1" x="60" y="440">
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="fscale1" x="240" y="440" factor="0.08">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="osc4" x="420" y="440" waveform="0">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="am0" x="960" y="160" amount="0.95">
      <Pin id="carrier_in" direction="in" type="signal"/>
      <Pin id="modulator_in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>

    <!-- Gate-like envelope: no sustain, short -->
    <Node id="adsr0" x="1140" y="160" attack="0.002" decay="0.12" sustain="0.0" release="0.08">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>

    <Node id="output" x="1320" y="160" level="0.8">
      <Pin id="in1" direction="in" type="signal"/>
    </Node>
  </Nodes>

  <Connections>
    <!-- Pair A -->
    <Wire from="note0" fromPort="out" to="fm0" toPort="freq_in"/>
    <Wire from="osc0" fromPort="out" to="fm0" toPort="modulator_in"/>
    <Wire from="fm0" fromPort="out" to="osc1" toPort="note_in"/>

    <!-- Pair B -->
    <Wire from="note0" fromPort="out" to="fscale0" toPort="freq_in"/>
    <Wire from="fscale0" fromPort="out" to="osc2" toPort="note_in"/>
    <Wire from="note0" fromPort="out" to="fm1" toPort="freq_in"/>
    <Wire from="osc2" fromPort="out" to="fm1" toPort="modulator_in"/>
    <Wire from="fm1" fromPort="out" to="osc3" toPort="note_in"/>

    <!-- Cross-mod -->
    <Wire from="osc1" fromPort="out" to="ring0" toPort="in1"/>
    <Wire from="osc3" fromPort="out" to="ring0" toPort="in2"/>

    <!-- Chop -->
    <Wire from="note1" fromPort="out" to="fscale1" toPort="freq_in"/>
    <Wire from="fscale1" fromPort="out" to="osc4" toPort="note_in"/>
    <Wire from="ring0" fromPort="out" to="am0" toPort="carrier_in"/>
    <Wire from="osc4" fromPort="out" to="am0" toPort="modulator_in"/>

    <Wire from="am0" fromPort="out" to="adsr0" toPort="in"/>
    <Wire from="adsr0" fromPort="out" to="output" toPort="in1"/>
  </Connections>
</SmolFM>
