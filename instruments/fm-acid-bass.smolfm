<?xml version="1.0" encoding="UTF-8"?>

<!-- Advanced: Acid Bass (Square Mod / Saw Carrier) -->
<SmolFM version="2" name="Acid Bass">
  <description>Square modulator on saw carrier for aggressive acid bass</description>
  <Nodes>
    <Node id="note0" x="60" y="60"/>
    <Node id="note1" x="60" y="380"/>
    
    <Node id="fscale0" x="380" y="380" factor="3.0"/>
    
    <Node id="fm0" x="700" y="60" amount="1.4"/>
    
    <Node id="osc0" x="1020" y="60" waveform="1"/>
    <Node id="osc1" x="1020" y="380" waveform="3"/>
    
    <Node id="adsr0" x="1340" y="60" attack="0.001" decay="0.25" sustain="0.85" release="0.1"/>
    
    <Node id="output" x="1660" y="60" level="0.65"/>
  </Nodes>
  <Connections>
    <Wire from="note0" fromPort="out" to="fm0" toPort="freq_in"/>
    <Wire from="note1" fromPort="out" to="fscale0" toPort="freq_in"/>
    <Wire from="fscale0" fromPort="out" to="osc1" toPort="note_in"/>
    <Wire from="osc1" fromPort="out" to="fm0" toPort="modulator_in"/>
    <Wire from="fm0" fromPort="out" to="osc0" toPort="note_in"/>
    <Wire from="osc0" fromPort="out" to="adsr0" toPort="in"/>
    <Wire from="adsr0" fromPort="out" to="output" toPort="in1"/>
  </Connections>
</SmolFM>