<SmolFM version="3" name="Acid Bass">
  <Graph>
    <Nodes>
      <Node id="note" />
      <Node id="fscale0" factor="3.0" />
      <Node id="fm0" amount="1.4" />
      <Node id="osc0" waveform="saw" />
      <Node id="osc1" waveform="triangle" />
      <Node id="adsr0" attack="0.001" decay="0.25" sustain="0.85" release="0.1" />
      <Node id="output" level="0.65" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="fm0" toPort="freq_in" />
      <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in" />
      <Wire from="fscale0" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="osc1" fromPort="out" to="fm0" toPort="modulator_in" />
      <Wire from="fm0" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="60" />
      <Box id="fscale0" x="380" y="380" />
      <Box id="fm0" x="700" y="60" />
      <Box id="osc0" x="1020" y="60" />
      <Box id="osc1" x="1020" y="380" />
      <Box id="adsr0" x="1340" y="60" />
      <Box id="output" x="1660" y="60" />
    </Boxes>
  </Layout>
</SmolFM>