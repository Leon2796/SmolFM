<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="fscale-interval-modulator-fm" description="Minimal example instance of the technique fscale-interval-modulator-fm from the SmolFM technique catalogue." techniques="fscale-interval-modulator-fm">
  <Graph>
    <Nodes>
      <Node id="note" />
      <Node id="fm0" amount="2.0" />
      <Node id="osc0" />
      <Node id="fscale0" interval="fifth_up" />
      <Node id="osc1" />
      <Node id="output" level="0.7" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="fm0" toPort="freq_in" />
      <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in" />
      <Wire from="fm0" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="fscale0" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="osc1" fromPort="out" to="fm0" toPort="modulator_in" />
      <Wire from="osc0" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="80" />
      <Box id="fm0" x="1050" y="80" />
      <Box id="osc0" x="1380" y="80" />
      <Box id="fscale0" x="390" y="80" />
      <Box id="osc1" x="720" y="80" />
      <Box id="output" x="1710" y="80" />
    </Boxes>
  </Layout>
</SmolFM>
