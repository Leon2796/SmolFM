<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="serial-gain-staging" description="Minimal example instance of the technique serial-gain-staging from the SmolFM technique catalogue." techniques="serial-gain-staging">
  <Graph>
    <Nodes>
      <Node id="note" />
      <Node id="osc0" />
      <Node id="gain0" factor="1.6" />
      <Node id="shape0" shape="soft" drive="0.45" />
      <Node id="gain1" factor="0.5" />
      <Node id="output" level="0.7" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="gain0" toPort="in" />
      <Wire from="gain0" fromPort="out" to="shape0" toPort="in" />
      <Wire from="shape0" fromPort="out" to="gain1" toPort="in" />
      <Wire from="gain1" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="80" />
      <Box id="osc0" x="390" y="80" />
      <Box id="gain0" x="720" y="80" />
      <Box id="shape0" x="1050" y="80" />
      <Box id="gain1" x="1380" y="80" />
      <Box id="output" x="1710" y="80" />
    </Boxes>
  </Layout>
</SmolFM>
