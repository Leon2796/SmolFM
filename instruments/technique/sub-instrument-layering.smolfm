<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="sub-instrument-layering" description="Minimal example instance of the technique sub-instrument-layering from the SmolFM technique catalogue." techniques="sub-instrument-layering">
  <Graph>
    <Nodes>
      <Node id="note" />
      <Node id="osc0" waveform="sine" mode="pitch" />
      <Node id="osc1" waveform="saw" />
      <Node id="adsr0" attack="0.01" release="0.4" sustain="0.5" decay="0.3" />
      <Node id="output" level="0.7" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="note" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="output" toPort="in1" />
      <Wire from="osc1" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="output" toPort="in2" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="80" />
      <Box id="osc0" x="390" y="80" />
      <Box id="osc1" x="390" y="320" />
      <Box id="adsr0" x="720" y="80" />
      <Box id="output" x="1050" y="80" />
    </Boxes>
  </Layout>
</SmolFM>
