<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="vibrato-tail-echo" description="Minimal example instance of the technique vibrato-tail-echo from the SmolFM technique catalogue." techniques="vibrato-tail-echo">
  <Graph>
    <Nodes>
      <Node id="note" />
      <Node id="osc0" />
      <Node id="adsr0" attack="0.01" release="0.4" sustain="0.6" decay="0.5" />
      <Node id="delay0" time="320" mix="0.6" feedback="0.35" />
      <Node id="osc1" waveform="sine" mode="lfo" lforate="5.5" />
      <Node id="output" level="0.7" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="delay0" toPort="in" />
      <Wire from="osc1" fromPort="out" to="delay0" toPort="time_mod_in" />
      <Wire from="delay0" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="320" />
      <Box id="osc0" x="390" y="80" />
      <Box id="adsr0" x="720" y="80" />
      <Box id="delay0" x="1050" y="80" />
      <Box id="osc1" x="60" y="80" />
      <Box id="output" x="1380" y="80" />
    </Boxes>
  </Layout>
</SmolFM>
