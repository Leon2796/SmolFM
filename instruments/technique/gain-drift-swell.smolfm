<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="gain-drift-swell" description="Minimal example instance of the technique gain-drift-swell from the SmolFM technique catalogue." techniques="gain-drift-swell">
  <Graph>
    <Nodes>
      <Node id="note" />
      <Node id="osc0" />
      <Node id="gain0" factor="1.0" />
      <Node id="osc1" waveform="perlin" mode="lfo" lforate="0.3" />
      <Node id="output" level="0.7" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="gain0" toPort="in" />
      <Wire from="osc1" fromPort="out" to="gain0" toPort="factor_mod_in" />
      <Wire from="gain0" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="320" />
      <Box id="osc0" x="390" y="80" />
      <Box id="gain0" x="720" y="80" />
      <Box id="osc1" x="60" y="80" />
      <Box id="output" x="1050" y="80" />
    </Boxes>
