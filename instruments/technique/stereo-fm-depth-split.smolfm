<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="stereo-fm-depth-split" description="Minimal example instance of the technique stereo-fm-depth-split from the SmolFM technique catalogue." techniques="stereo-fm-depth-split">
  <Graph>
    <Nodes>
      <Node id="note" />
      <Node id="fm0" amount="1.6" />
      <Node id="fm1" amount="2.8" />
      <Node id="osc0" />
      <Node id="osc1" />
      <Node id="osc2" />
      <Node id="split0" />
      <Node id="merge0" />
      <Node id="output" level="0.7" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="note" fromPort="out" to="fm0" toPort="freq_in" />
      <Wire from="note" fromPort="out" to="fm1" toPort="freq_in" />
      <Wire from="osc0" fromPort="out" to="split0" toPort="in" />
      <Wire from="split0" fromPort="outL" to="fm0" toPort="modulator_in" />
      <Wire from="split0" fromPort="outR" to="fm1" toPort="modulator_in" />
      <Wire from="fm0" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="fm1" fromPort="out" to="osc2" toPort="note_in" />
      <Wire from="osc1" fromPort="out" to="merge0" toPort="in1" />
      <Wire from="osc2" fromPort="out" to="merge0" toPort="in2" />
      <Wire from="merge0" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="80" />
      <Box id="fm0" x="1050" y="80" />
      <Box id="fm1" x="1050" y="320" />
      <Box id="osc0" x="390" y="80" />
      <Box id="osc1" x="1380" y="80" />
      <Box id="osc2" x="1380" y="320" />
      <Box id="split0" x="720" y="80" />
      <Box id="merge0" x="1710" y="80" />
      <Box id="output" x="2040" y="80" />
    </Boxes>
  </Layout>
</SmolFM>
