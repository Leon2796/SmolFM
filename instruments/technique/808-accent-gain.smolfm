<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="808-accent-gain" description="Minimal example instance of the technique 808-accent-gain from the SmolFM technique catalogue." techniques="808-accent-gain">
  <Graph>
    <Nodes>
      <Node id="note" />
      <Node id="osc0" />
      <Node id="gain0" factor="1.4" />
      <Node id="output" level="0.7" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="gain0" toPort="in" />
      <Wire from="note" fromPort="vel" to="gain0" toPort="vel" />
      <Wire from="gain0" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="80" />
      <Box id="osc0" x="390" y="80" />
      <Box id="gain0" x="720" y="80" />
      <Box id="output" x="1050" y="80" />
    </Boxes>
  </Layout>
</SmolFM>
