<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="lfo-cutoff-wobble" description="Minimal example instance of the technique lfo-cutoff-wobble from the SmolFM technique catalogue." techniques="lfo-cutoff-wobble">
  <Graph>
    <Nodes>
      <Node id="note" />
      <Node id="fm0" amount="1.5" />
      <Node id="osc0" waveform="triangle" />
      <Node id="osc1" waveform="sine" mode="lfo" lforate="6.0" />
      <Node id="filter0" mode="lp" cutoff="800" resonance="0.4" />
      <Node id="output" level="0.7" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="note" fromPort="out" to="fm0" toPort="freq_in" />
      <Wire from="osc1" fromPort="out" to="fm0" toPort="modulator_in" />
      <Wire from="fm0" fromPort="out" to="filter0" toPort="cutoff_mod_in" />
      <Wire from="osc0" fromPort="out" to="filter0" toPort="in" />
      <Wire from="filter0" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="320" />
      <Box id="fm0" x="390" y="80" />
      <Box id="osc0" x="390" y="320" />
      <Box id="osc1" x="60" y="80" />
      <Box id="filter0" x="720" y="80" />
      <Box id="output" x="1050" y="80" />
    </Boxes>
  </Layout>
</SmolFM>
