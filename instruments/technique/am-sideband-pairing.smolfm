<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="am-sideband-pairing" description="Minimal example instance of the technique am-sideband-pairing from the SmolFM technique catalogue." techniques="am-sideband-pairing">
  <Graph>
    <Nodes>
      <Node id="note" />
      <Node id="osc0" />
      <Node id="fscale0" factor="2.2" />
      <Node id="osc1" />
      <Node id="am0" amount="0.6" />
      <Node id="output" level="0.7" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in" />
      <Wire from="fscale0" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="am0" toPort="carrier_in" />
      <Wire from="osc1" fromPort="out" to="am0" toPort="modulator_in" />
      <Wire from="am0" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="80" />
      <Box id="osc0" x="390" y="80" />
      <Box id="fscale0" x="390" y="320" />
      <Box id="osc1" x="720" y="80" />
      <Box id="am0" x="1050" y="80" />
      <Box id="output" x="1380" y="80" />
    </Boxes>
  </Layout>
</SmolFM>
