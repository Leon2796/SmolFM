<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="resonator-body-strike" description="Minimal example instance of the technique resonator-body-strike from the SmolFM technique catalogue." techniques="resonator-body-strike">
  <Graph>
    <Nodes>
      <Node id="note" />
      <Node id="osc0" waveform="noise" />
      <Node id="adsr0" attack="0.001" release="0.01" sustain="0.0" decay="0.02" />
      <Node id="gain0" factor="2.4" />
      <Node id="resonator0" q="0.5" decay="1.1" tune="196" />
      <Node id="gain1" factor="1.2" />
      <Node id="output" level="0.7" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="resonator0" toPort="tune" />
      <Wire from="osc0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="gain0" toPort="in" />
      <Wire from="gain0" fromPort="out" to="resonator0" toPort="in" />
      <Wire from="resonator0" fromPort="out" to="gain1" toPort="in" />
      <Wire from="note" fromPort="vel" to="resonator0" toPort="vel" />
      <Wire from="note" fromPort="vel" to="gain1" toPort="vel" />
      <Wire from="gain1" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="320" />
