<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="difference-tone-bass" description="Minimal example instance of the technique difference-tone-bass from the SmolFM technique catalogue." techniques="difference-tone-bass">
  <Graph>
    <Nodes>
      <Node id="note" />
      <Node id="fscale0" factor="4.0" />
      <Node id="osc0" />
      <Node id="fscale1" factor="5.0" />
      <Node id="osc1" />
      <Node id="ring0" />
      <Node id="output" level="0.7" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in" />
      <Wire from="note" fromPort="out" to="fscale1" toPort="freq_in" />
      <Wire from="fscale0" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="fscale1" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="ring0" toPort="in1" />
      <Wire from="osc1" fromPort="out" to="ring0" toPort="in2" />
      <Wire from="ring0" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="80" />
      <Box id="fscale0" x="390" y="80" />
      <Box id="osc0" x="720" y="80" />
      <Box id="fscale1" x="390" y="320" />
      <Box id="osc1" x="720" y="320" />
      <Box id="ring0" x="1050" y="80" />
      <Box id="output" x="1380" y="80" />
    </Boxes>
  </Layout>
</SmolFM>
