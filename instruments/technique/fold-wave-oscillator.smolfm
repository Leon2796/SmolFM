<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="fold-wave-oscillator" description="Minimal example instance of the technique fold-wave-oscillator from the SmolFM technique catalogue." techniques="fold-wave-oscillator">
  <Graph>
    <Nodes>
      <Node id="note" />
      <Node id="osc0" waveform="saw" />
      <Node id="shape0" shape="fold" drive="0.7" />
      <Node id="output" level="0.7" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="shape0" toPort="in" />
      <Wire from="shape0" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="80" />
      <Box id="osc0" x="390" y="80" />
      <Box id="shape0" x="720" y="80" />
      <Box id="output" x="1050" y="80" />
    </Boxes>
  </Layout>
</SmolFM>
