<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="fm-shared-modulator-duo" description="Minimal example instance of the technique fm-shared-modulator-duo from the SmolFM technique catalogue." techniques="fm-shared-modulator-duo">
  <Graph>
    <Nodes>
      <Node id="note" />
      <Node id="fm0" amount="1.5" />
      <Node id="fm1" amount="2.1" />
      <Node id="osc0" staticfreq="440" mode="static" />
      <Node id="osc1" />
      <Node id="osc2" />
      <Node id="output" level="0.7" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="fm0" toPort="freq_in" />
      <Wire from="note" fromPort="out" to="fm1" toPort="freq_in" />
      <Wire from="osc0" fromPort="out" to="fm0" toPort="modulator_in" />
      <Wire from="osc0" fromPort="out" to="fm1" toPort="modulator_in" />
      <Wire from="fm0" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="fm1" fromPort="out" to="osc2" toPort="note_in" />
      <Wire from="osc1" fromPort="out" to="output" toPort="in1" />
      <Wire from="osc2" fromPort="out" to="output" toPort="in2" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="320" />
      <Box id="fm0" x="390" y="80" />
      <Box id="fm1" x="390" y="320" />
      <Box id="osc0" x="60" y="80" />
      <Box id="osc1" x="720" y="80" />
      <Box id="osc2" x="720" y="320" />
      <Box id="output" x="1050" y="80" />
    </Boxes>
  </Layout>
</SmolFM>
