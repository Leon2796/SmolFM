      <Node id="am1" amount="0.75" />
      <Node id="osc2" waveform="sine" mode="lfo" lforate="4.15" />
      <Node id="merge0" />
      <Node id="output" level="0.7" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="split0" toPort="in" />
      <Wire from="split0" fromPort="outL" to="am0" toPort="carrier_in" />
      <Wire from="split0" fromPort="outR" to="am1" toPort="carrier_in" />
      <Wire from="osc1" fromPort="out" to="am0" toPort="modulator_in" />
      <Wire from="osc2" fromPort="out" to="am1" toPort="modulator_in" />
      <Wire from="am0" fromPort="out" to="merge0" toPort="in1" />
      <Wire from="am1" fromPort="out" to="merge0" toPort="in2" />
      <Wire from="merge0" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="560" />
      <Box id="osc0" x="390" y="80" />
      <Box id="split0" x="720" y="80" />
      <Box id="am0" x="1050" y="80" />
