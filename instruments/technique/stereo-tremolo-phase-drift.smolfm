<SmolFM version="3" name="stereo-tremolo-phase-drift" description="Minimal example instance of the technique stereo-tremolo-phase-drift from the SmolFM technique catalogue." techniques="stereo-tremolo-phase-drift">
  <Graph>
    <Nodes>
      <Node id="note" />
      <Node id="osc0" />
      <Node id="split0" />
      <Node id="am0" amount="0.75" />
