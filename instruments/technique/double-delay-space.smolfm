<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="double-delay-space" description="Minimal example instance of the technique double-delay-space from the SmolFM technique catalogue." techniques="double-delay-space">
  <Graph>
    <Nodes>
      <Node id="note" />
      <Node id="osc0" />
      <Node id="delay0" time="90" mix="0.3" feedback="0.3" />
      <Node id="delay1" time="600" mix="0.5" feedback="0.45" />
      <Node id="output" level="0.7" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="delay0" toPort="in" />
      <Wire from="delay0" fromPort="out" to="delay1" toPort="in" />
      <Wire from="delay1" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="80" />
      <Box id="osc0" x="390" y="80" />
      <Box id="delay0" x="720" y="80" />
      <Box id="delay1" x="1050" y="80" />
      <Box id="output" x="1380" y="80" />
    </Boxes>
  </Layout>
</SmolFM>
