<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="resonance-breathing-filter" description="Minimal example instance of the technique resonance-breathing-filter from the SmolFM technique catalogue." techniques="resonance-breathing-filter">
  <Graph>
    <Nodes>
      <Node id="note" />
      <Node id="osc0" waveform="perlin" mode="lfo" lforate="0.5" />
      <Node id="osc1" />
      <Node id="filter0" mode="bp" cutoff="700" resonance="0.6" />
      <Node id="output" level="0.7" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="note" fromPort="out" to="filter0" toPort="cutoff_mod_in" />
      <Wire from="osc0" fromPort="out" to="filter0" toPort="resonance_mod_in" />
      <Wire from="osc1" fromPort="out" to="filter0" toPort="in" />
      <Wire from="filter0" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="320" />
      <Box id="osc0" x="60" y="80" />
      <Box id="osc1" x="390" y="80" />
      <Box id="filter0" x="720" y="80" />
      <Box id="output" x="1050" y="80" />
    </Boxes>
  </Layout>
</SmolFM>
