<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="parallel-echo-blend" description="Minimal example instance of the technique parallel-echo-blend from the SmolFM technique catalogue." techniques="parallel-echo-blend">
  <Graph>
    <Nodes>
      <Node id="note" />
      <Node id="osc0" />
      <Node id="split0" />
      <Node id="delay0" time="240" mix="0.5" feedback="0.45" />
      <Node id="gain0" factor="1.0" />
      <Node id="gain1" factor="0.7" />
      <Node id="output" level="0.7" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="split0" toPort="in" />
      <Wire from="split0" fromPort="outL" to="gain0" toPort="in" />
      <Wire from="split0" fromPort="outR" to="delay0" toPort="in" />
      <Wire from="delay0" fromPort="out" to="gain1" toPort="in" />
      <Wire from="gain0" fromPort="out" to="output" toPort="in1" />
      <Wire from="gain1" fromPort="out" to="output" toPort="in2" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="80" />
      <Box id="osc0" x="390" y="80" />
      <Box id="split0" x="720" y="80" />
      <Box id="delay0" x="1050" y="80" />
      <Box id="gain0" x="1050" y="320" />
      <Box id="gain1" x="1380" y="80" />
      <Box id="output" x="1710" y="80" />
    </Boxes>
  </Layout>
</SmolFM>
