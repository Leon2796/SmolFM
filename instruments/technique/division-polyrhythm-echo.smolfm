<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="division-polyrhythm-echo" description="Minimal example instance of the technique division-polyrhythm-echo from the SmolFM technique catalogue." techniques="division-polyrhythm-echo">
  <Graph>
    <Nodes>
      <Node id="note" />
      <Node id="osc0" />
      <Node id="delay0" division="quarter" time="400" sync="on" mix="0.5" feedback="0.3" />
      <Node id="delay1" division="eighth" time="400" sync="on" mix="0.5" feedback="0.3" />
      <Node id="output" level="0.7" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="delay0" toPort="in" />
      <Wire from="osc0" fromPort="out" to="delay1" toPort="in" />
      <Wire from="delay0" fromPort="out" to="output" toPort="in1" />
      <Wire from="delay1" fromPort="out" to="output" toPort="in2" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="80" />
      <Box id="osc0" x="390" y="80" />
      <Box id="delay0" x="720" y="80" />
      <Box id="delay1" x="720" y="320" />
      <Box id="output" x="1050" y="80" />
    </Boxes>
  </Layout>
</SmolFM>
