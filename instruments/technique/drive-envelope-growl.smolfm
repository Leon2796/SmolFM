<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="drive-envelope-growl" description="Minimal example instance of the technique drive-envelope-growl from the SmolFM technique catalogue." techniques="drive-envelope-growl">
  <Graph>
    <Nodes>
      <Node id="note" />
      <Node id="osc0" staticfreq="110" mode="static" />
      <Node id="adsr0" attack="0.001" release="0.2" sustain="0.0" decay="0.3" />
      <Node id="osc1" waveform="saw" />
      <Node id="shape0" shape="soft" drive="0.6" />
      <Node id="output" level="0.7" />
    </Nodes>
    <Connections>
      <Wire from="osc0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="note" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="osc1" fromPort="out" to="shape0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="shape0" toPort="drive_mod_in" />
      <Wire from="shape0" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="320" />
