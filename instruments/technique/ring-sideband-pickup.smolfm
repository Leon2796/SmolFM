<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="ring-sideband-pickup" description="Minimal example instance of the technique ring-sideband-pickup from the SmolFM technique catalogue." techniques="ring-sideband-pickup">
  <Graph>
    <Nodes>
      <Node id="note" />
      <Node id="osc0" />
      <Node id="fscale0" factor="1.2" />
      <Node id="osc1" />
      <Node id="fscale1" factor="2.2" />
      <Node id="ring0" />
      <Node id="filter0" mode="bp" cutoff="1200" resonance="0.6" />
      <Node id="output" level="0.7" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in" />
      <Wire from="note" fromPort="out" to="fscale1" toPort="freq_in" />
      <Wire from="fscale0" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="ring0" toPort="in1" />
      <Wire from="osc1" fromPort="out" to="ring0" toPort="in2" />
      <Wire from="fscale1" fromPort="out" to="filter0" toPort="cutoff_mod_in" />
      <Wire from="ring0" fromPort="out" to="filter0" toPort="in" />
      <Wire from="filter0" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="80" />
      <Box id="osc0" x="390" y="80" />
      <Box id="fscale0" x="390" y="320" />
      <Box id="osc1" x="720" y="80" />
      <Box id="fscale1" x="390" y="560" />
      <Box id="ring0" x="1050" y="80" />
      <Box id="filter0" x="1380" y="80" />
      <Box id="output" x="1710" y="80" />
    </Boxes>
  </Layout>
</SmolFM>
