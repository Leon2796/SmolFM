<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="stereo-pingpong-echo" description="Minimal example instance of the technique stereo-pingpong-echo from the SmolFM technique catalogue." techniques="stereo-pingpong-echo">
  <Graph>
    <Nodes>
      <Node id="note" />
      <Node id="osc0" />
      <Node id="split0" />
      <Node id="delay0" time="180" mix="1.0" feedback="0.0" />
      <Node id="delay1" time="360" mix="1.0" feedback="0.0" />
      <Node id="delay2" time="540" mix="1.0" feedback="0.0" />
      <Node id="delay3" time="720" mix="1.0" feedback="0.0" />
      <Node id="output" level="0.7" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="split0" toPort="in" />
      <Wire from="split0" fromPort="outL" to="delay0" toPort="in" />
      <Wire from="split0" fromPort="outL" to="delay2" toPort="in" />
      <Wire from="split0" fromPort="outR" to="delay1" toPort="in" />
      <Wire from="split0" fromPort="outR" to="delay3" toPort="in" />
      <Wire from="delay0" fromPort="out" to="output" toPort="in1" />
      <Wire from="delay1" fromPort="out" to="output" toPort="in2" />
      <Wire from="delay2" fromPort="out" to="output" toPort="in3" />
      <Wire from="delay3" fromPort="out" to="output" toPort="in4" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="80" />
      <Box id="osc0" x="390" y="80" />
      <Box id="split0" x="720" y="80" />
      <Box id="delay0" x="1050" y="80" />
      <Box id="delay1" x="1050" y="320" />
      <Box id="delay2" x="1050" y="560" />
      <Box id="delay3" x="1050" y="800" />
      <Box id="output" x="1380" y="80" />
    </Boxes>
  </Layout>
</SmolFM>
