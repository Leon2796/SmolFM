<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="tr808-claves" description="808-Style Claves: reiner Sinus-Ping bei 2500 Hz mit 120-ms-Dekay, dazu kurzer Rausch-Tick durch Bandpass als Hoeholz-Attack (tuned-noise-percussion); Velocity-Akzent lauter." techniques="tuned-noise-percussion">
  <Graph>
    <Nodes>
      <Node id="note">
        <Pin id="out" direction="out" type="frequency" />
        <Pin id="vel" direction="out" type="velocity" />
      </Node>
      <Node id="osc0" waveform="sine" mode="static" staticfreq="2500">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr0" attack="0.001" decay="0.12" sustain="0.0" release="0.02">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain0" factor="0.8">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="vel" direction="in" type="velocity" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc1" waveform="noise" mode="static" staticfreq="6000">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="filter0" cutoff="2500" resonance="0.7" mode="bp">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr1" attack="0.001" decay="0.03" sustain="0.0" release="0.01">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain1" factor="0.12">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="vel" direction="in" type="velocity" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.85" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="note" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="note" fromPort="vel" to="gain0" toPort="vel" />
      <Wire from="note" fromPort="vel" to="gain1" toPort="vel" />
      <Wire from="osc0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="gain0" toPort="in" />
      <Wire from="gain0" fromPort="out" to="output" toPort="in1" />
      <Wire from="osc1" fromPort="out" to="filter0" toPort="in" />
      <Wire from="filter0" fromPort="out" to="adsr1" toPort="in" />
      <Wire from="adsr1" fromPort="out" to="gain1" toPort="in" />
      <Wire from="gain1" fromPort="out" to="output" toPort="in2" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="380" />
      <Box id="osc0" x="360" y="60" />
      <Box id="adsr0" x="680" y="60" />
      <Box id="gain0" x="1000" y="60" />
      <Box id="osc1" x="360" y="700" />
      <Box id="filter0" x="680" y="700" />
      <Box id="adsr1" x="1000" y="700" />
      <Box id="gain1" x="1320" y="700" />
      <Box id="output" x="1640" y="380" />
    </Boxes>
  </Layout>
</SmolFM>