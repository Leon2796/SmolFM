<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="tr808-snare" description="808-Style Snare: Zweiton-Korpus 185/330 Hz mit 120-ms-Korpus-Dekay (driftbox-Cap) plus Rausch-Kette nach 808-synth: HP 2200 x0,7 + Rattle-Bandpass 3600 Q4,5 x0,5 mit Skitter-Raster (Echo-Delay 3,5 ms, fb 0,5 - Annaeherung der Burst-Re-Gates aus 808-synth), 160-ms-Snap, Noise-Dominanz 1,05 (tuned-noise-percussion); Velocity-Akzent hebt alle Schichten an." techniques="tuned-noise-percussion">
  <Graph>
    <Nodes>
      <Node id="note">
        <Pin id="out" direction="out" type="frequency" />
        <Pin id="vel" direction="out" type="velocity" />
      </Node>
      <Node id="osc0" waveform="sine" mode="static" staticfreq="185">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc1" waveform="sine" mode="static" staticfreq="330">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc2" waveform="noise" mode="static" staticfreq="6000">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr0" attack="0.001" decay="0.12" sustain="0.0" release="0.05">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr1" attack="0.001" decay="0.12" sustain="0.0" release="0.04">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="filter0" cutoff="3600" resonance="0.9" mode="bp">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="vel" direction="in" type="velocity" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr2" attack="0.001" decay="0.16" sustain="0.0" release="0.06">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain0" factor="0.55">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="vel" direction="in" type="velocity" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain1" factor="0.45">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="vel" direction="in" type="velocity" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain2" factor="1.05">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="vel" direction="in" type="velocity" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="filter1" cutoff="2200" resonance="0.29" mode="hp">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain3" factor="0.7">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain4" factor="0.5">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="delay0" time="3.5" feedback="0.5" mix="0.5" sync="off" division="quarter">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="add0">
        <Pin id="in1" direction="in" type="signal" />
        <Pin id="in2" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.85" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="note" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="note" fromPort="out" to="osc2" toPort="note_in" />
      <Wire from="note" fromPort="vel" to="gain0" toPort="vel" />
      <Wire from="note" fromPort="vel" to="gain1" toPort="vel" />
      <Wire from="note" fromPort="vel" to="gain2" toPort="vel" />
      <Wire from="osc0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="gain0" toPort="in" />
      <Wire from="gain0" fromPort="out" to="output" toPort="in1" />
      <Wire from="osc1" fromPort="out" to="adsr1" toPort="in" />
      <Wire from="adsr1" fromPort="out" to="gain1" toPort="in" />
      <Wire from="gain1" fromPort="out" to="output" toPort="in2" />
      <Wire from="osc2" fromPort="out" to="filter1" toPort="in" />
      <Wire from="osc2" fromPort="out" to="filter0" toPort="in" />

      <Wire from="filter0" fromPort="out" to="delay0" toPort="in" />
      <Wire from="delay0" fromPort="out" to="gain4" toPort="in" />
      <Wire from="gain4" fromPort="out" to="add0" toPort="in2" />
      <Wire from="filter1" fromPort="out" to="gain3" toPort="in" />
      <Wire from="gain3" fromPort="out" to="add0" toPort="in1" />
      <Wire from="add0" fromPort="out" to="adsr2" toPort="in" />
      <Wire from="adsr2" fromPort="out" to="gain2" toPort="in" />
      <Wire from="gain2" fromPort="out" to="output" toPort="in3" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="380" />
      <Box id="osc0" x="360" y="60" />
      <Box id="adsr0" x="680" y="60" />
      <Box id="gain0" x="1000" y="60" />
      <Box id="osc1" x="360" y="380" />
      <Box id="adsr1" x="680" y="380" />
      <Box id="gain1" x="1000" y="380" />
      <Box id="osc2" x="360" y="700" />
      <Box id="filter0" x="680" y="700" />
      <Box id="adsr2" x="1000" y="700" />
      <Box id="gain2" x="1320" y="700" />
      <Box id="filter1" x="680" y="1020" />
      <Box id="gain3" x="1000" y="1020" />
      <Box id="delay0" x="680" y="1340" />
      <Box id="gain4" x="1000" y="1340" />
      <Box id="add0" x="1320" y="1020" />
      <Box id="output" x="1640" y="380" />
    </Boxes>
  </Layout>
</SmolFM>