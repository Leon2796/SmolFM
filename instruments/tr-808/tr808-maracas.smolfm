<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="tr808-maracas" description="808-Style Maracas: Rauschen durch Bandpass 4,8 kHz mit schnellem 130-ms-Dekay (tuned-noise-percussion); Velocity-Akzent lauter und heller." techniques="tuned-noise-percussion">
  <Graph>
    <Nodes>
      <Node id="note">
        <Pin id="out" direction="out" type="frequency" />
        <Pin id="vel" direction="out" type="velocity" />
      </Node>
      <Node id="osc0" waveform="noise" mode="static" staticfreq="6000">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="filter0" cutoff="4800" resonance="0.6" mode="bp">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="vel" direction="in" type="velocity" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr0" attack="0.001" decay="0.13" sustain="0.0" release="0.03">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain0" factor="0.8">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="vel" direction="in" type="velocity" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.85" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="filter0" toPort="in" />
      <Wire from="note" fromPort="vel" to="filter0" toPort="vel" />
      <Wire from="filter0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="gain0" toPort="in" />
      <Wire from="note" fromPort="vel" to="gain0" toPort="vel" />
      <Wire from="gain0" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="380" />
      <Box id="osc0" x="60" y="60" />
      <Box id="filter0" x="360" y="60" />
      <Box id="adsr0" x="680" y="60" />
      <Box id="gain0" x="1000" y="60" />
      <Box id="output" x="1320" y="60" />
    </Boxes>
  </Layout>
</SmolFM>