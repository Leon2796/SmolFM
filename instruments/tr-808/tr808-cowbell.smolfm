<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="tr808-cowbell" description="808-Style Cowbell: zwei statische Squares 540/800 Hz auf dem Adder-Bus durch Bandpass 2,5 kHz mit 320-ms-Dekay (osc-sum-bus); Velocity-Akzent lauter und heller." techniques="osc-sum-bus">
  <Graph>
    <Nodes>
      <Node id="note">
        <Pin id="out" direction="out" type="frequency" />
        <Pin id="vel" direction="out" type="velocity" />
      </Node>
      <Node id="osc0" waveform="square" mode="static" staticfreq="540">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc1" waveform="square" mode="static" staticfreq="800">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="add0">
        <Pin id="in1" direction="in" type="signal" />
        <Pin id="in2" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="filter0" cutoff="2500" resonance="0.45" mode="bp">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="vel" direction="in" type="velocity" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr0" attack="0.001" decay="0.32" sustain="0.0" release="0.1">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain0" factor="0.8">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="vel" direction="in" type="velocity" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.85" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="note" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="add0" toPort="in1" />
      <Wire from="osc1" fromPort="out" to="add0" toPort="in2" />
      <Wire from="add0" fromPort="out" to="filter0" toPort="in" />
      <Wire from="note" fromPort="vel" to="filter0" toPort="vel" />
      <Wire from="filter0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="gain0" toPort="in" />
      <Wire from="note" fromPort="vel" to="gain0" toPort="vel" />
      <Wire from="gain0" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="380" />
      <Box id="osc0" x="360" y="60" />
      <Box id="osc1" x="360" y="380" />
      <Box id="add0" x="680" y="200" />
      <Box id="filter0" x="1000" y="200" />
      <Box id="adsr0" x="1320" y="200" />
      <Box id="gain0" x="1640" y="200" />
      <Box id="output" x="1960" y="200" />
    </Boxes>
  </Layout>
</SmolFM>