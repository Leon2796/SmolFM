<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="tr808-bass-drum" description="808-Style Bassdrum: Rausch-Klick als Schlegel-Anreger in den schwingenden Koerper-Resonator, der feedback-Loop traegt das Bridged-T-Damping des Original-Netzwerks (statischer Anker 49.5 Hz als Bridged-T-Messung, Spielregister ca. A1-B1 55-62 Hz); Velocity-Akzent waechst Dekay (spread 2.5) und Hit lauter. Saettigungsstufe nach dem Resonator (shape soft, Drive 0.25, vel-getrieben) bildet den Op-Amp-Clip der Original-Schaltung ab: der Ring-Tail wird mit Harmonischen gefaerbt statt rein sinusfoermig, und der Accent faehrt via shape.vel in die Kurve. Ausgangs-Gain 10.0 als Basis-Ebene (Hoerfund des Nutzers: so sitzt die Stimme). Vel-Scale vsc0 (sqrt, 1.0) vor allen Accent-Verbrauchern: weiche Anschlaege erreichen die Akzent-Effekte frueher - die Hardware-Akzent-Naehe (Wurzel-Lautheitskurve). Anregung jetzt als Tuned-Strike (Technik tuned-strike-excitation): Sinus-Impuls adsr1 (25 ms) auf der Korpus-Note (osc1, pitch) + Rauschen nur als leise Attack-Lage (gain1 0.5), Summe add0 in die Schleifenbruecke - Hit-fuer-Hit berechenbare Ring-Lautheit statt Rausch-Stichprobe." techniques="resonator-body-strike, tuned-noise-percussion, tuned-strike-excitation, saturating-vca, 808-accent-gain">
  <Graph>
    <Nodes>
      <Node id="note">
        <Pin id="out" direction="out" type="frequency" />
        <Pin id="vel" direction="out" type="velocity" />
      </Node>
      <Node id="vsc0" curve="sqrt" scale="1.0">
        <Pin id="vel_in" direction="in" type="velocity" />
        <Pin id="out" direction="out" type="velocity" />
      </Node>
      <Node id="osc0" waveform="noise" mode="static" staticfreq="6000">
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc1" waveform="sine" mode="pitch" staticfreq="49.5">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr0" attack="0.001" decay="0.008" sustain="0.0" release="0.005">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr1" attack="0.001" decay="0.025" sustain="0.0" release="0.005">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain1" factor="0.5">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain3" factor="2.0">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="feedback0" amount="0.22">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="fb_in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="add0">
        <Pin id="in1" direction="in" type="signal" />
        <Pin id="in2" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="resonator0" tune="49.5" q="0.85" decay="0.30" spread="2.5">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="tune" direction="in" type="frequency" />
        <Pin id="vel" direction="in" type="velocity" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="shape0" drive="0.25" shape="soft">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="vel" direction="in" type="velocity" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain0" factor="10.0">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="vel" direction="in" type="velocity" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.9" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="resonator0" toPort="tune" />
      <Wire from="note" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="note" fromPort="vel" to="vsc0" toPort="vel_in" />
      <Wire from="vsc0" fromPort="out" to="resonator0" toPort="vel" />
      <Wire from="vsc0" fromPort="out" to="gain0" toPort="vel" />
      <Wire from="osc0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="gain1" toPort="in" />
      <Wire from="gain1" fromPort="out" to="add0" toPort="in2" />
      <Wire from="gain3" fromPort="out" to="add0" toPort="in1" />
      <Wire from="add0" fromPort="out" to="feedback0" toPort="in" />
      <Wire from="feedback0" fromPort="out" to="resonator0" toPort="in" />
      <Wire from="resonator0" fromPort="out" to="feedback0" toPort="fb_in" />
      <Wire from="resonator0" fromPort="out" to="shape0" toPort="in" />
      <Wire from="shape0" fromPort="out" to="gain0" toPort="in" />
      <Wire from="vsc0" fromPort="out" to="shape0" toPort="vel" />
      <Wire from="gain0" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="60" />
      <Box id="vsc0" x="60" y="380" />
      <Box id="osc1" x="360" y="380" />
      <Box id="adsr1" x="680" y="380" />
      <Box id="gain3" x="1000" y="380" />
      <Box id="add0" x="1320" y="380" />
      <Box id="osc0" x="360" y="60" />
      <Box id="adsr0" x="680" y="60" />
      <Box id="gain1" x="1000" y="60" />
      <Box id="feedback0" x="1320" y="60" />
      <Box id="resonator0" x="1640" y="60" />
      <Box id="shape0" x="1800" y="60" />
      <Box id="gain0" x="2120" y="60" />
      <Box id="output" x="2440" y="60" />
    </Boxes>
  </Layout>
</SmolFM>