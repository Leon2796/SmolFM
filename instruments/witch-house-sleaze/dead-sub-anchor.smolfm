<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="Dead Sub Anchor" description="Dead-clean sub bass anchor: a slightly flat (0.4995x) sine sub keeps slow temper-beating motion while a quiet 1.5028x triangle partial adds definition on top." techniques="sub-instrument-layering,fscale-temper-beating">
  <Graph>
    <Nodes>
      <Node id="note">
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fscale0" factor="0.4995">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc0" waveform="sine">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr0" attack="0.002" decay="0.2" sustain="0.85" release="0.1">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain0" factor="0.85">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="fscale1" factor="1.5028">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc1" waveform="triangle">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr1" attack="0.002" decay="0.3" sustain="0.5" release="0.15">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain1" factor="0.16">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.85" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in" />
      <Wire from="fscale0" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="gain0" toPort="in" />
      <Wire from="gain0" fromPort="out" to="output" toPort="in1" />
      <Wire from="note" fromPort="out" to="fscale1" toPort="freq_in" />
      <Wire from="fscale1" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="osc1" fromPort="out" to="adsr1" toPort="in" />
      <Wire from="adsr1" fromPort="out" to="gain1" toPort="in" />
      <Wire from="gain1" fromPort="out" to="output" toPort="in2" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="240" />
      <Box id="fscale0" x="380" y="60" />
      <Box id="osc0" x="700" y="60" />
      <Box id="adsr0" x="1020" y="60" />
      <Box id="gain0" x="1340" y="60" />
      <Box id="fscale1" x="380" y="380" />
      <Box id="osc1" x="700" y="380" />
      <Box id="adsr1" x="1020" y="380" />
      <Box id="gain1" x="1340" y="380" />
      <Box id="output" x="1660" y="200" />
    </Boxes>
  </Layout>
</SmolFM>