<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="Veil Open Hat" description="Open hat with a veiled shimmer: an inharmonic square pair into ring-mod metal, band-carved, long-gated, plus a soft 220 ms echo branch." techniques="metal-hat-squares">
  <Graph>
    <Nodes>
      <Node id="note" />
      <Node id="osc0" waveform="square" mode="static" staticfreq="587">
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc1" waveform="square" mode="static" staticfreq="921">
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="ring0">
        <Pin id="in1" direction="in" type="signal" />
        <Pin id="in2" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="filter0" cutoff="5600" resonance="0.12" mode="hp">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr0" attack="0.001" decay="0.34" sustain="0.0" release="0.1">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain0" factor="0.5">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="delay0" time="220" feedback="0.3" mix="0.22">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.8" />
    </Nodes>
    <Connections>
      <Wire from="osc0" fromPort="out" to="ring0" toPort="in1" />
      <Wire from="osc1" fromPort="out" to="ring0" toPort="in2" />
      <Wire from="ring0" fromPort="out" to="filter0" toPort="in" />
      <Wire from="filter0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="gain0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="delay0" toPort="in" />
      <Wire from="gain0" fromPort="out" to="output" toPort="in1" />
      <Wire from="delay0" fromPort="out" to="output" toPort="in2" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="60" />
      <Box id="osc0" x="380" y="60" />
      <Box id="osc1" x="380" y="380" />
      <Box id="ring0" x="380" y="680" />
      <Box id="filter0" x="700" y="140" />
      <Box id="adsr0" x="1020" y="140" />
      <Box id="gain0" x="1340" y="60" />
      <Box id="delay0" x="1340" y="380" />
      <Box id="output" x="1660" y="140" />
    </Boxes>
  </Layout>
</SmolFM>