<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="Sleaze Organ Bass" description="Indie sleaze bass organ: sub, root and detuned-octave square voices summed on the adder bus into a soft-clipped series filter stage, with fixed keyboard-anchored intervals." techniques="fscale-organ-stack,static-detune-beating,serial-drive-filter-sculpt">
  <Graph>
    <Nodes>
      <Node id="note">
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fscale0" factor="0.4995">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc0" waveform="square">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc1" waveform="square">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="fscale1" factor="2.0035">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc2" waveform="square">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain0" factor="0.8">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain1" factor="0.7">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain2" factor="0.3">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="add0">
        <Pin id="in1" direction="in" type="signal" />
        <Pin id="in2" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="add1">
        <Pin id="in1" direction="in" type="signal" />
        <Pin id="in2" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="shape0" drive="0.3" shape="soft">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="filter0" cutoff="1400" resonance="0.2" mode="lp">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr0" attack="0.003" decay="0.15" sustain="0.9" release="0.08">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.8" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in" />
      <Wire from="fscale0" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="note" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="note" fromPort="out" to="fscale1" toPort="freq_in" />
      <Wire from="fscale1" fromPort="out" to="osc2" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="gain0" toPort="in" />
      <Wire from="osc1" fromPort="out" to="gain1" toPort="in" />
      <Wire from="osc2" fromPort="out" to="gain2" toPort="in" />
      <Wire from="gain0" fromPort="out" to="add0" toPort="in1" />
      <Wire from="gain1" fromPort="out" to="add0" toPort="in2" />
      <Wire from="add0" fromPort="out" to="add1" toPort="in1" />
      <Wire from="gain2" fromPort="out" to="add1" toPort="in2" />
      <Wire from="add1" fromPort="out" to="shape0" toPort="in" />
      <Wire from="shape0" fromPort="out" to="filter0" toPort="in" />
      <Wire from="filter0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="240" />
      <Box id="fscale0" x="380" y="60" />
      <Box id="fscale1" x="380" y="380" />
      <Box id="osc0" x="700" y="60" />
      <Box id="osc1" x="700" y="240" />
      <Box id="osc2" x="700" y="380" />
      <Box id="gain0" x="1020" y="60" />
      <Box id="gain1" x="1020" y="240" />
      <Box id="gain2" x="1020" y="380" />
      <Box id="add0" x="1340" y="60" />
      <Box id="add1" x="1340" y="240" />
      <Box id="shape0" x="1340" y="380" />
      <Box id="filter0" x="1660" y="380" />
      <Box id="adsr0" x="1980" y="60" />
      <Box id="output" x="2300" y="60" />
    </Boxes>
  </Layout>
</SmolFM>