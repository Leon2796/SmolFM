<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="Lilith Glass Pad" description="Lilith glass pad: two two-operator FM voices — one at the raw key, one microdetuned at 0.9983x — both modulated by tempered 2.76x sine partners, summed and widened by a clean 17 ms Haas branch." techniques="classic-two-op-fm,fscale-detune-unison,stereo-haas-branch-delay">
  <Graph>
    <Nodes>
      <Node id="note">
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fm0" amount="1.9">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="modulator_in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fscale1" factor="2.76">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc0" waveform="sine">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc1" waveform="sine">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="fm1" amount="1.75">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="modulator_in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fscale2" factor="0.9983">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fscale3" factor="2.769">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc2" waveform="sine">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc3" waveform="sine">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain0" factor="0.5">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain1" factor="0.5">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="add0">
        <Pin id="in1" direction="in" type="signal" />
        <Pin id="in2" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr0" attack="1.4" decay="1.0" sustain="0.8" release="1.9">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="split0">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="outL" direction="out" type="signal" />
        <Pin id="outR" direction="out" type="signal" />
      </Node>
      <Node id="delay0" time="17" feedback="0.0" mix="1.0" sync="off">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="merge0">
        <Pin id="in1" direction="in" type="signal" />
        <Pin id="in2" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.8" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="fm0" toPort="freq_in" />
      <Wire from="note" fromPort="out" to="fscale1" toPort="freq_in" />
      <Wire from="fscale1" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="osc1" fromPort="out" to="fm0" toPort="modulator_in" />
      <Wire from="fm0" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="note" fromPort="out" to="fscale2" toPort="freq_in" />
      <Wire from="fscale2" fromPort="out" to="fm1" toPort="freq_in" />
      <Wire from="note" fromPort="out" to="fscale3" toPort="freq_in" />
      <Wire from="fscale3" fromPort="out" to="osc3" toPort="note_in" />
      <Wire from="osc3" fromPort="out" to="fm1" toPort="modulator_in" />
      <Wire from="fm1" fromPort="out" to="osc2" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="gain0" toPort="in" />
      <Wire from="osc2" fromPort="out" to="gain1" toPort="in" />
      <Wire from="gain0" fromPort="out" to="add0" toPort="in1" />
      <Wire from="gain1" fromPort="out" to="add0" toPort="in2" />
      <Wire from="add0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="split0" toPort="in" />
      <Wire from="split0" fromPort="outL" to="delay0" toPort="in" />
      <Wire from="split0" fromPort="outR" to="merge0" toPort="in2" />
      <Wire from="delay0" fromPort="out" to="merge0" toPort="in1" />
      <Wire from="merge0" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="60" />
      <Box id="fm0" x="380" y="60" />
      <Box id="fscale1" x="380" y="380" />
      <Box id="osc0" x="1340" y="60" />
      <Box id="osc1" x="700" y="380" />
      <Box id="fm1" x="1020" y="60" />
      <Box id="fscale2" x="380" y="680" />
      <Box id="fscale3" x="380" y="1000" />
      <Box id="osc2" x="1340" y="380" />
      <Box id="osc3" x="700" y="1000" />
      <Box id="gain0" x="1660" y="60" />
      <Box id="gain1" x="1660" y="380" />
      <Box id="add0" x="1980" y="60" />
      <Box id="adsr0" x="1660" y="540" />
      <Box id="split0" x="2300" y="300" />
      <Box id="delay0" x="2300" y="60" />
      <Box id="merge0" x="2300" y="540" />
      <Box id="output" x="2620" y="300" />
    </Boxes>
  </Layout>
</SmolFM>