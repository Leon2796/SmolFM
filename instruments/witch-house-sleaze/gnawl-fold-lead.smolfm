<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="Gnawl Fold Lead" description="Gnarling electro-punk lead: drive-enveloped fold shaper on the saw body beside a gated 2.003x square octave layer, both summed before the hp-bitten gate." techniques="drive-envelope-growl,fold-wave-oscillator,fscale-interval-power-stack,sub-instrument-layering">
  <Graph>
    <Nodes>
      <Node id="note">
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc0" waveform="saw">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc2" waveform="sine" mode="static" staticfreq="220">
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr1" attack="0.001" decay="0.12" sustain="0.25" release="0.15">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="shape0" drive="0.62" shape="fold">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="drive_mod_in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="filter0" cutoff="160" resonance="0.15" mode="hp">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr0" attack="0.002" decay="0.5" sustain="0.35" release="0.1">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="fscale0" factor="2.003">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc1" waveform="square">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain1" factor="0.3">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr2" attack="0.002" decay="0.4" sustain="0.3" release="0.1">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="add0">
        <Pin id="in1" direction="in" type="signal" />
        <Pin id="in2" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.8" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="osc2" fromPort="out" to="adsr1" toPort="in" />
      <Wire from="osc0" fromPort="out" to="shape0" toPort="in" />
      <Wire from="adsr1" fromPort="out" to="shape0" toPort="drive_mod_in" />
      <Wire from="shape0" fromPort="out" to="filter0" toPort="in" />
      <Wire from="filter0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="add0" toPort="in1" />
      <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in" />
      <Wire from="fscale0" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="osc1" fromPort="out" to="gain1" toPort="in" />
      <Wire from="gain1" fromPort="out" to="adsr2" toPort="in" />
      <Wire from="adsr2" fromPort="out" to="add0" toPort="in2" />
      <Wire from="add0" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="240" />
      <Box id="osc0" x="380" y="60" />
      <Box id="osc2" x="380" y="380" />
      <Box id="adsr1" x="700" y="380" />
      <Box id="shape0" x="700" y="60" />
      <Box id="filter0" x="1020" y="60" />
      <Box id="adsr0" x="1340" y="60" />
      <Box id="fscale0" x="60" y="680" />
      <Box id="osc1" x="380" y="680" />
      <Box id="gain1" x="700" y="680" />
      <Box id="adsr2" x="1020" y="680" />
      <Box id="add0" x="1340" y="380" />
      <Box id="output" x="1660" y="240" />
    </Boxes>
  </Layout>
</SmolFM>