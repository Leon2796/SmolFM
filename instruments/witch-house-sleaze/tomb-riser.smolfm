<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="Tomb Riser" description="Tomb riser FX: noise swept by a key-tracked F-ADSR cutoff climb beside a slow-opening saw folded voice, holding while the key is held and releasing into a wash." techniques="fadsr-cutoff-sweep,fold-wave-oscillator,sub-instrument-layering">
  <Graph>
    <Nodes>
      <Node id="note">
        <Pin id="out" direction="out" type="frequency" />
        <Pin id="vel" direction="out" type="velocity" />
      </Node>
      <Node id="fscale2" factor="4.0">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fadsr0" attack="1.8" decay="1.2" sustain="1.0" release="0.4" up="8.5" down="0.3">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc0" waveform="noise" mode="static" staticfreq="2000">
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="filter0" cutoff="2000" resonance="0.62" mode="bp">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="cutoff_mod_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr0" attack="1.8" decay="1.2" sustain="1.0" release="0.4">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain0" factor="0.55">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="vel" direction="in" type="velocity" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="fscale0" factor="1.0017">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc1" waveform="saw">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="shape0" drive="0.55" shape="fold">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr1" attack="1.8" decay="1.0" sustain="0.85" release="0.35">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain1" factor="0.3">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.8" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="fscale2" toPort="freq_in" />
      <Wire from="fscale2" fromPort="out" to="fadsr0" toPort="freq_in" />
      <Wire from="fadsr0" fromPort="out" to="filter0" toPort="cutoff_mod_in" />
      <Wire from="osc0" fromPort="out" to="filter0" toPort="in" />
      <Wire from="filter0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="gain0" toPort="in" />
      <Wire from="gain0" fromPort="out" to="output" toPort="in1" />
      <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in" />
      <Wire from="fscale0" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="osc1" fromPort="out" to="shape0" toPort="in" />
      <Wire from="shape0" fromPort="out" to="adsr1" toPort="in" />
      <Wire from="adsr1" fromPort="out" to="gain1" toPort="in" />
      <Wire from="gain1" fromPort="out" to="output" toPort="in2" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="240" />
      <Box id="fscale2" x="380" y="60" />
      <Box id="fadsr0" x="700" y="60" />
      <Box id="osc0" x="380" y="380" />
      <Box id="filter0" x="1020" y="60" />
      <Box id="adsr0" x="1340" y="60" />
      <Box id="gain0" x="1660" y="60" />
      <Box id="fscale0" x="60" y="680" />
      <Box id="osc1" x="380" y="680" />
      <Box id="shape0" x="700" y="680" />
      <Box id="adsr1" x="1020" y="680" />
      <Box id="gain1" x="1340" y="680" />
      <Box id="output" x="1980" y="240" />
    </Boxes>
  </Layout>
</SmolFM>