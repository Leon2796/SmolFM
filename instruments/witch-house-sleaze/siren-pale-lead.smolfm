<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="Siren Pale Lead" description="Pale siren sine lead: a 0.22 Hz perlin drift breathes the pitch through a proportional FM stage, the voice releasing long and splitting into a 285 ms delayed right branch for width." techniques="perlin-drift-modulation,stereo-haas-branch-delay">
  <Graph>
    <Nodes>
      <Node id="note">
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc0" waveform="perlin" mode="lfo" lforate="0.22">
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="fm0" amount="0.06">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="modulator_in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc1" waveform="sine">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr0" attack="0.06" decay="0.4" sustain="0.8" release="1.0">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain0" factor="0.8">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="split0">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="outL" direction="out" type="signal" />
        <Pin id="outR" direction="out" type="signal" />
      </Node>
      <Node id="delay0" time="285" feedback="0.4" mix="0.3" sync="off">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="merge0">
        <Pin id="in1" direction="in" type="signal" />
        <Pin id="in2" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.8" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="fm0" toPort="freq_in" />
      <Wire from="osc0" fromPort="out" to="fm0" toPort="modulator_in" />
      <Wire from="fm0" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="osc1" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="gain0" toPort="in" />
      <Wire from="gain0" fromPort="out" to="split0" toPort="in" />
      <Wire from="split0" fromPort="outL" to="delay0" toPort="in" />
      <Wire from="split0" fromPort="outR" to="merge0" toPort="in2" />
      <Wire from="delay0" fromPort="out" to="merge0" toPort="in1" />
      <Wire from="merge0" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="60" />
      <Box id="osc0" x="380" y="60" />
      <Box id="fm0" x="700" y="60" />
      <Box id="osc1" x="1020" y="60" />
      <Box id="adsr0" x="1340" y="60" />
      <Box id="gain0" x="1660" y="60" />
      <Box id="split0" x="1980" y="60" />
      <Box id="delay0" x="1980" y="380" />
      <Box id="merge0" x="2300" y="140" />
      <Box id="output" x="2620" y="200" />
    </Boxes>
  </Layout>
</SmolFM>