<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="Ghost Choir Pad" description="Ghost choir pad: tempered triangle partial stack (1x, 2.002x, 3.004x) summed into a vowel band-pass followed by a low pass, breathing through a slow sine tremolo." techniques="fscale-organ-stack,subtractive-voice-chain,am-tremolo-lfo,fscale-temper-beating">
  <Graph>
    <Nodes>
      <Node id="note">
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fscale0" factor="1.0">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fscale1" factor="2.002">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fscale2" factor="3.004">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc0" waveform="triangle">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc1" waveform="triangle">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc2" waveform="triangle">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain0" factor="0.8">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain1" factor="0.4">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain2" factor="0.25">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="add0">
        <Pin id="in1" direction="in" type="signal" />
        <Pin id="in2" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="add1">
        <Pin id="in1" direction="in" type="signal" />
        <Pin id="in2" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="filter0" cutoff="740" resonance="0.4" mode="bp">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="filter1" cutoff="2700" resonance="0.2" mode="lp">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr0" attack="1.1" decay="0.8" sustain="0.9" release="1.2">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc3" waveform="sine" mode="lfo" lforate="0.37">
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="am0" amount="0.3">
        <Pin id="carrier_in" direction="in" type="signal" />
        <Pin id="modulator_in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.8" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in" />
      <Wire from="note" fromPort="out" to="fscale1" toPort="freq_in" />
      <Wire from="note" fromPort="out" to="fscale2" toPort="freq_in" />
      <Wire from="fscale0" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="fscale1" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="fscale2" fromPort="out" to="osc2" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="gain0" toPort="in" />
      <Wire from="osc1" fromPort="out" to="gain1" toPort="in" />
      <Wire from="osc2" fromPort="out" to="gain2" toPort="in" />
      <Wire from="gain0" fromPort="out" to="add0" toPort="in1" />
      <Wire from="gain1" fromPort="out" to="add0" toPort="in2" />
      <Wire from="add0" fromPort="out" to="add1" toPort="in1" />
      <Wire from="gain2" fromPort="out" to="add1" toPort="in2" />
      <Wire from="add1" fromPort="out" to="filter0" toPort="in" />
      <Wire from="filter0" fromPort="out" to="filter1" toPort="in" />
      <Wire from="filter1" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="am0" toPort="carrier_in" />
      <Wire from="osc3" fromPort="out" to="am0" toPort="modulator_in" />
      <Wire from="am0" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="240" />
      <Box id="fscale0" x="380" y="60" />
      <Box id="fscale1" x="380" y="380" />
      <Box id="fscale2" x="380" y="680" />
      <Box id="osc0" x="700" y="60" />
      <Box id="osc1" x="700" y="380" />
      <Box id="osc2" x="700" y="680" />
      <Box id="gain0" x="1020" y="60" />
      <Box id="gain1" x="1020" y="380" />
      <Box id="gain2" x="1020" y="680" />
      <Box id="add0" x="1340" y="60" />
      <Box id="add1" x="1340" y="240" />
      <Box id="filter0" x="1660" y="240" />
      <Box id="filter1" x="1980" y="240" />
      <Box id="adsr0" x="1660" y="1000" />
      <Box id="osc3" x="380" y="1000" />
      <Box id="am0" x="1980" y="1000" />
      <Box id="output" x="2300" y="240" />
    </Boxes>
  </Layout>
</SmolFM>