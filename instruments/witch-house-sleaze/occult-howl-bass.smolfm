<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="Occult Howl Bass" description="Howling witch-house growl bass: key-tracked two-operator FM driven by a 71 Hz saw, drive-enveloped soft clip after the LP, riding on a key-anchored sine sub." techniques="classic-two-op-fm,drive-envelope-growl,sub-instrument-layering">
  <Graph>
    <Nodes>
      <Node id="note">
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc2" waveform="saw" mode="static" staticfreq="71">
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="fm0" amount="0.9">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="modulator_in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc1" waveform="saw">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc3" waveform="sine" mode="static" staticfreq="110">
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr0" attack="0.001" decay="0.9" sustain="0.9" release="0.2">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="shape0" drive="0.4" shape="soft">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="drive_mod_in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="filter0" cutoff="900" resonance="0.38" mode="lp">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr1" attack="0.004" decay="0.2" sustain="0.85" release="0.15">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="fscale0" factor="0.5">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc0" waveform="sine">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain0" factor="0.7">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.85" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="fm0" toPort="freq_in" />
      <Wire from="osc2" fromPort="out" to="fm0" toPort="modulator_in" />
      <Wire from="fm0" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="osc3" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="osc1" fromPort="out" to="shape0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="shape0" toPort="drive_mod_in" />
      <Wire from="shape0" fromPort="out" to="filter0" toPort="in" />
      <Wire from="filter0" fromPort="out" to="adsr1" toPort="in" />
      <Wire from="adsr1" fromPort="out" to="output" toPort="in1" />
      <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in" />
      <Wire from="fscale0" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="gain0" toPort="in" />
      <Wire from="gain0" fromPort="out" to="output" toPort="in2" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="240" />
      <Box id="osc2" x="380" y="380" />
      <Box id="fm0" x="700" y="240" />
      <Box id="osc1" x="1020" y="240" />
      <Box id="osc3" x="380" y="60" />
      <Box id="adsr0" x="700" y="380" />
      <Box id="shape0" x="700" y="60" />
      <Box id="filter0" x="1020" y="60" />
      <Box id="adsr1" x="1340" y="60" />
      <Box id="fscale0" x="60" y="680" />
      <Box id="osc0" x="380" y="680" />
      <Box id="gain0" x="700" y="680" />
      <Box id="output" x="1660" y="180" />
    </Boxes>
  </Layout>
</SmolFM>