<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="Bone Tom" description="Playable keyed dual-resonator drum: two sine tone bodies at a fixed inharmonic ratio (1.7838) plus a key-less noise carpet band, one gated accent trim per layer." techniques="keyed-dual-resonator-drum,tuned-noise-percussion">
  <Graph>
    <Nodes>
      <Node id="note">
        <Pin id="out" direction="out" type="frequency" />
        <Pin id="vel" direction="out" type="velocity" />
      </Node>
      <Node id="fscale0" factor="1.0">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fscale1" factor="1.7838">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc0" waveform="sine">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc1" waveform="sine">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr0" attack="0.001" decay="0.20" sustain="0.0" release="0.05">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr1" attack="0.001" decay="0.13" sustain="0.0" release="0.04">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc2" waveform="noise" mode="static" staticfreq="800">
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="filter0" cutoff="950" resonance="0.5" mode="bp">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr2" attack="0.001" decay="0.07" sustain="0.0" release="0.02">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain0" factor="0.85">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="vel" direction="in" type="velocity" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain1" factor="0.7">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="vel" direction="in" type="velocity" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain2" factor="0.55">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="vel" direction="in" type="velocity" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.8" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in" />
      <Wire from="note" fromPort="out" to="fscale1" toPort="freq_in" />
      <Wire from="fscale0" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="fscale1" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="osc1" fromPort="out" to="adsr1" toPort="in" />
      <Wire from="osc2" fromPort="out" to="filter0" toPort="in" />
      <Wire from="filter0" fromPort="out" to="adsr2" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="gain0" toPort="in" />
      <Wire from="adsr1" fromPort="out" to="gain1" toPort="in" />
      <Wire from="adsr2" fromPort="out" to="gain2" toPort="in" />
      <Wire from="note" fromPort="vel" to="gain0" toPort="vel" />
      <Wire from="note" fromPort="vel" to="gain1" toPort="vel" />
      <Wire from="note" fromPort="vel" to="gain2" toPort="vel" />
      <Wire from="gain0" fromPort="out" to="output" toPort="in1" />
      <Wire from="gain1" fromPort="out" to="output" toPort="in2" />
      <Wire from="gain2" fromPort="out" to="output" toPort="in3" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="240" />
      <Box id="fscale0" x="380" y="60" />
      <Box id="fscale1" x="380" y="380" />
      <Box id="osc0" x="700" y="60" />
      <Box id="osc1" x="700" y="380" />
      <Box id="osc2" x="380" y="680" />
      <Box id="filter0" x="700" y="680" />
      <Box id="adsr0" x="1020" y="60" />
      <Box id="adsr1" x="1020" y="380" />
      <Box id="adsr2" x="1020" y="680" />
      <Box id="gain0" x="1340" y="60" />
      <Box id="gain1" x="1340" y="380" />
      <Box id="gain2" x="1340" y="680" />
      <Box id="output" x="1660" y="240" />
    </Boxes>
  </Layout>
</SmolFM>