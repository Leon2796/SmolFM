<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="Wraith Wobble Bass" description="Wraith wobble bass: a square voice through a key-centred, LFO-wobbled low pass (FM stage bridging the cutoff port) plus a quiet sine sub layer." techniques="lfo-cutoff-wobble,sub-instrument-layering">
  <Graph>
    <Nodes>
      <Node id="note">
        <Pin id="out" direction="out" type="frequency" />
        <Pin id="vel" direction="out" type="velocity" />
      </Node>
      <Node id="osc1" waveform="sine" mode="lfo" lforate="4.1">
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="fscale1" factor="3.0">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fm0" amount="0.3">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="modulator_in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc0" waveform="square">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="filter0" cutoff="120" resonance="0.38" mode="lp">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="cutoff_mod_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr0" attack="0.002" decay="0.4" sustain="0.75" release="0.12">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="fscale0" factor="0.5">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc2" waveform="sine">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain0" factor="0.8">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.85" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="filter0" toPort="in" />
      <Wire from="note" fromPort="out" to="fscale1" toPort="freq_in" />
      <Wire from="fscale1" fromPort="out" to="fm0" toPort="freq_in" />
      <Wire from="osc1" fromPort="out" to="fm0" toPort="modulator_in" />
      <Wire from="fm0" fromPort="out" to="filter0" toPort="cutoff_mod_in" />
      <Wire from="filter0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="output" toPort="in1" />
      <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in" />
      <Wire from="fscale0" fromPort="out" to="osc2" toPort="note_in" />
      <Wire from="osc2" fromPort="out" to="gain0" toPort="in" />
      <Wire from="gain0" fromPort="out" to="output" toPort="in2" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="240" />
      <Box id="osc1" x="380" y="60" />
      <Box id="fm0" x="700" y="60" />
      <Box id="fscale1" x="700" y="380" />
      <Box id="osc0" x="380" y="240" />
      <Box id="filter0" x="1020" y="240" />
      <Box id="adsr0" x="1340" y="240" />
      <Box id="fscale0" x="60" y="680" />
      <Box id="osc2" x="380" y="680" />
      <Box id="gain0" x="700" y="680" />
      <Box id="output" x="1660" y="240" />
    </Boxes>
  </Layout>
</SmolFM>