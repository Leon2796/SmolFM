<?xml version="1.0" encoding="UTF-8"?>

<!-- Long-tail ambient pad: detuned saw pair, long release, into a 900ms delay with high feedback -->
<SmolFM version="2" name="Echo Cathedral">
  <description>Two saws detuned at 1.005 and 0.995 feed a long 900ms free-running delay with 65 percent feedback; the envelope is already pad-like, the delay turns it into a reverb-like wash.</description>
  <Nodes>
    <Node id="note0" x="80" y="140">
      <Pin id="out" direction="out" type="frequency"/>
    </Node>

    <Node id="fscale0" x="260" y="80" factor="1.005">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="osc0" x="440" y="80" waveform="1">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>

    <Node id="fscale1" x="260" y="200" factor="0.995">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="osc1" x="440" y="200" waveform="1">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>

    <!-- Pad-like envelope: slow attack, endless sustain -->
    <Node id="adsr0" x="620" y="140" attack="0.8" decay="0.5" sustain="0.85" release="2.0">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>

    <!-- Long free-running delay: echo tail becomes the reverb -->
    <Node id="delay0" x="820" y="140" time="900" feedback="0.65" mix="0.45" sync="0" division="1">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>

    <Node id="output" x="1020" y="140" level="0.6">
      <Pin id="in1" direction="in" type="signal"/>
    </Node>
  </Nodes>

  <Connections>
    <Wire from="note0" fromPort="out" to="fscale0" toPort="freq_in"/>
    <Wire from="fscale0" fromPort="out" to="osc0" toPort="note_in"/>
    <Wire from="note0" fromPort="out" to="fscale1" toPort="freq_in"/>
    <Wire from="fscale1" fromPort="out" to="osc1" toPort="note_in"/>

    <!-- Both saws summed into the envelope -->
    <Wire from="osc0" fromPort="out" to="adsr0" toPort="in"/>
    <Wire from="osc1" fromPort="out" to="adsr0" toPort="in"/>
    <Wire from="adsr0" fromPort="out" to="delay0" toPort="in"/>
    <Wire from="delay0" fromPort="out" to="output" toPort="in1"/>
  </Connections>
</SmolFM>
