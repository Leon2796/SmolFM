<SmolFM version="3" name="Echo Cathedral">
  <Graph>
    <Nodes>
      <Node id="note">
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fscale0" factor="1.005">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc0" waveform="saw">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="fscale1" factor="0.995">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc1" waveform="saw">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr0" attack="0.8" decay="0.5" sustain="0.85" release="2.0">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="delay0" time="900" feedback="0.65" mix="0.45" sync="off" division="quarter">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.6">
        <Pin id="in1" direction="in" type="signal" />
      </Node>
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in" />
      <Wire from="fscale0" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="note" fromPort="out" to="fscale1" toPort="freq_in" />
      <Wire from="fscale1" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="osc1" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="delay0" toPort="in" />
      <Wire from="delay0" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="80" y="140" />
      <Box id="fscale0" x="260" y="80" />
      <Box id="osc0" x="440" y="80" />
      <Box id="fscale1" x="260" y="200" />
      <Box id="osc1" x="440" y="200" />
      <Box id="adsr0" x="620" y="140" />
      <Box id="delay0" x="820" y="140" />
      <Box id="output" x="1020" y="140" />
    </Boxes>
  </Layout>
</SmolFM>