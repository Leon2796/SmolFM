<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="Pulse Chord Stab" description="Pounding techno stab: a minor square chord voiced as three gain-staged parallel chains, each mirrored by its own tempo-synced eighth-note delay into one rhythm pulse." techniques="fscale-interval-power-stack,tempo-synced-delay-tail,sub-instrument-layering">
  <Graph>
    <Nodes>
      <Node id="note">
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fscale0" factor="1.1892">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fscale1" factor="1.4983">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc0" waveform="square">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc1" waveform="square">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc2" waveform="square">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr0" attack="0.002" decay="0.16" sustain="0.0" release="0.08">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr1" attack="0.002" decay="0.16" sustain="0.0" release="0.1">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr2" attack="0.002" decay="0.14" sustain="0.0" release="0.08">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain0" factor="0.42">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain1" factor="0.36">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain2" factor="0.42">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="delay0" sync="on" division="eighth" feedback="0.4" mix="0.55">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="delay1" sync="on" division="eighth" feedback="0.4" mix="0.55">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="delay2" sync="on" division="eighth" feedback="0.4" mix="0.55">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.8" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in" />
      <Wire from="note" fromPort="out" to="fscale1" toPort="freq_in" />
      <Wire from="fscale0" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="fscale1" fromPort="out" to="osc2" toPort="note_in" />
      <Wire from="note" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="osc1" fromPort="out" to="adsr1" toPort="in" />
      <Wire from="osc2" fromPort="out" to="adsr2" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="gain0" toPort="in" />
      <Wire from="adsr1" fromPort="out" to="gain1" toPort="in" />
      <Wire from="adsr2" fromPort="out" to="gain2" toPort="in" />
      <Wire from="gain0" fromPort="out" to="delay0" toPort="in" />
      <Wire from="gain1" fromPort="out" to="delay1" toPort="in" />
      <Wire from="gain2" fromPort="out" to="delay2" toPort="in" />
      <Wire from="delay0" fromPort="out" to="output" toPort="in1" />
      <Wire from="delay1" fromPort="out" to="output" toPort="in3" />
      <Wire from="delay2" fromPort="out" to="output" toPort="in5" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="60" />
      <Box id="fscale0" x="60" y="380" />
      <Box id="fscale1" x="60" y="700" />
      <Box id="osc0" x="380" y="60" />
      <Box id="osc1" x="380" y="380" />
      <Box id="osc2" x="380" y="700" />
      <Box id="adsr0" x="700" y="60" />
      <Box id="adsr1" x="700" y="380" />
      <Box id="adsr2" x="700" y="700" />
      <Box id="gain0" x="1000" y="60" />
      <Box id="gain1" x="1000" y="380" />
      <Box id="gain2" x="1000" y="700" />
      <Box id="delay0" x="1000" y="960" />
      <Box id="delay1" x="1300" y="960" />
      <Box id="delay2" x="1600" y="960" />
      <Box id="output" x="1900" y="500" />
    </Boxes>
  </Layout>
</SmolFM>