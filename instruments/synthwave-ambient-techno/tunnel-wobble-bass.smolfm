<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="Tunnel Wobble Bass" description="Warehouse wobble bass: square voice under a key-tracked live cutoff that the FM bridge swings with a slow sine LFO, over a pure sine sub layer." techniques="lfo-cutoff-wobble,serial-drive-filter-sculpt,sub-instrument-layering">
  <Graph>
    <Nodes>
      <Node id="note">
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="oscWob" waveform="sine" mode="lfo" lforate="4.2">
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="fm0" amount="0.16">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="modulator_in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc0" waveform="square">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="filter0" cutoff="600" resonance="0.55" mode="lp">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="cutoff_mod_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="shape0" drive="0.3" shape="soft">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr0" attack="0.004" decay="0.45" sustain="0.8" release="0.25">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc1" waveform="sine">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr1" attack="0.005" decay="0.5" sustain="0.85" release="0.3">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.8" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="fm0" toPort="freq_in" />
      <Wire from="oscWob" fromPort="out" to="fm0" toPort="modulator_in" />
      <Wire from="fm0" fromPort="out" to="filter0" toPort="cutoff_mod_in" />
      <Wire from="note" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="filter0" toPort="in" />
      <Wire from="filter0" fromPort="out" to="shape0" toPort="in" />
      <Wire from="shape0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="output" toPort="in1" />
      <Wire from="note" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="osc1" fromPort="out" to="adsr1" toPort="in" />
      <Wire from="adsr1" fromPort="out" to="output" toPort="in3" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="60" />
      <Box id="oscWob" x="60" y="380" />
      <Box id="fm0" x="380" y="380" />
      <Box id="osc0" x="380" y="60" />
      <Box id="filter0" x="700" y="200" />
      <Box id="shape0" x="700" y="520" />
      <Box id="adsr0" x="1020" y="200" />
      <Box id="osc1" x="380" y="840" />
      <Box id="adsr1" x="700" y="840" />
      <Box id="output" x="1340" y="460" />
    </Boxes>
  </Layout>
</SmolFM>