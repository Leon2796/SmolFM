<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="Sunset Drive Lead" description="Detuned dual-saw synthwave lead with key-tracked sine vibrato on the common FM bridge, softened by a low pass and a light soft-clip stage." techniques="lfo-vibrato-fm,fscale-detune-unison,stereo-micropitch-spread,serial-drive-filter-sculpt">
  <Graph>
    <Nodes>
      <Node id="note">
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="oscVib" waveform="sine" mode="lfo" lforate="5.5">
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="fm0" amount="0.018">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="modulator_in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fscale0" factor="1.0058">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fscale1" factor="0.9942">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc0" waveform="saw">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc1" waveform="saw">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="merge0">
        <Pin id="in1" direction="in" type="signal" />
        <Pin id="in2" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="filter0" cutoff="5200" resonance="0.15" mode="lp">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="shape0" drive="0.25" shape="soft">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr0" attack="0.02" decay="0.4" sustain="0.7" release="0.32">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.62" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="fm0" toPort="freq_in" />
      <Wire from="oscVib" fromPort="out" to="fm0" toPort="modulator_in" />
      <Wire from="fm0" fromPort="out" to="fscale0" toPort="freq_in" />
      <Wire from="fm0" fromPort="out" to="fscale1" toPort="freq_in" />
      <Wire from="fscale0" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="fscale1" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="merge0" toPort="in1" />
      <Wire from="osc1" fromPort="out" to="merge0" toPort="in2" />
      <Wire from="merge0" fromPort="out" to="filter0" toPort="in" />
      <Wire from="filter0" fromPort="out" to="shape0" toPort="in" />
      <Wire from="shape0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="60" />
      <Box id="oscVib" x="60" y="380" />
      <Box id="fm0" x="380" y="60" />
      <Box id="fscale0" x="700" y="60" />
      <Box id="fscale1" x="700" y="380" />
      <Box id="osc0" x="1020" y="60" />
      <Box id="osc1" x="1020" y="380" />
      <Box id="merge0" x="1340" y="200" />
      <Box id="filter0" x="1340" y="500" />
      <Box id="shape0" x="1660" y="300" />
      <Box id="adsr0" x="1660" y="600" />
      <Box id="output" x="1980" y="450" />
    </Boxes>
  </Layout>
</SmolFM>