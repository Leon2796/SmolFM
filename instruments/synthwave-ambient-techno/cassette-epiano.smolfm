<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="Cassette E-Piano" description="DX-style electric piano: a decaying index envelope on the FM amount gives the bright tine bounce, a slightly inharmonic modulator ratio sets the mellow body." techniques="index-envelope-fm,classic-two-op-fm,fscale-interval-modulator-fm">
  <Graph>
    <Nodes>
      <Node id="note">
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="oscConst" waveform="sine" mode="static" staticfreq="440">
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr0" attack="0.001" decay="0.55" sustain="0.0" release="0.3">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="fscale0" factor="3.98">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc0" waveform="sine">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="fm0" amount="5.5">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="modulator_in" direction="in" type="signal" />
        <Pin id="amount_mod_in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc1" waveform="sine">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr1" attack="0.002" decay="1.4" sustain="0.22" release="0.7">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="shape0" drive="0.15" shape="soft">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.72" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="fm0" toPort="freq_in" />
      <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in" />
      <Wire from="fscale0" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="fm0" toPort="modulator_in" />
      <Wire from="oscConst" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="fm0" toPort="amount_mod_in" />
      <Wire from="fm0" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="osc1" fromPort="out" to="adsr1" toPort="in" />
      <Wire from="adsr1" fromPort="out" to="shape0" toPort="in" />
      <Wire from="shape0" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="60" />
      <Box id="oscConst" x="60" y="380" />
      <Box id="adsr0" x="380" y="380" />
      <Box id="fscale0" x="60" y="700" />
      <Box id="osc0" x="380" y="700" />
      <Box id="fm0" x="700" y="380" />
      <Box id="osc1" x="1020" y="380" />
      <Box id="adsr1" x="1340" y="60" />
      <Box id="shape0" x="1340" y="380" />
      <Box id="output" x="1660" y="200" />
    </Boxes>
  </Layout>
</SmolFM>