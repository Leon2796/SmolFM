<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="Grid Runner Bass" description="Retro driving bass: a pitch-dropping saw body through a resonant low pass and soft drive, backed by a pure sine sub layer an octave below." techniques="fadsr-pitch-drop,subtractive-voice-chain,serial-drive-filter-sculpt,sub-instrument-layering">
  <Graph>
    <Nodes>
      <Node id="note">
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fadsr0" attack="0.004" decay="0.08" sustain="1.0" release="0.1" up="2.4" down="1.0">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fscale0" factor="0.5">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc0" waveform="saw">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc1" waveform="sine">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="filter0" cutoff="700" resonance="0.4" mode="lp">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="shape0" drive="0.3" shape="soft">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr0" attack="0.004" decay="0.3" sustain="0.45" release="0.14">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr1" attack="0.004" decay="0.35" sustain="0.5" release="0.14">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain0" factor="0.75">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.7" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="fadsr0" toPort="freq_in" />
      <Wire from="fadsr0" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in" />
      <Wire from="fscale0" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="filter0" toPort="in" />
      <Wire from="filter0" fromPort="out" to="shape0" toPort="in" />
      <Wire from="shape0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="output" toPort="in1" />
      <Wire from="osc1" fromPort="out" to="adsr1" toPort="in" />
      <Wire from="adsr1" fromPort="out" to="gain0" toPort="in" />
      <Wire from="gain0" fromPort="out" to="output" toPort="in3" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="60" />
      <Box id="fadsr0" x="380" y="60" />
      <Box id="fscale0" x="380" y="620" />
      <Box id="osc0" x="700" y="60" />
      <Box id="osc1" x="700" y="620" />
      <Box id="filter0" x="1020" y="60" />
      <Box id="shape0" x="1020" y="360" />
      <Box id="adsr0" x="1340" y="60" />
      <Box id="adsr1" x="1020" y="620" />
      <Box id="gain0" x="1340" y="620" />
      <Box id="output" x="1660" y="300" />
    </Boxes>
  </Layout>
</SmolFM>