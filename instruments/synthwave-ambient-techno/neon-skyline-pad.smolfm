<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="Neon Skyline Pad" description="Wide neon synthwave pad: two two-operator FM voices with micro-detuned modulator ratios summed hard left/right, opened by a slow shared envelope and low pass." techniques="classic-two-op-fm,stereo-micropitch-spread,sub-instrument-layering,adsr-amp-envelope">
  <Graph>
    <Nodes>
      <Node id="note">
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fscale0" factor="2.0040">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fscale1" factor="1.9960">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc0" waveform="sine">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc1" waveform="sine">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="fm0" amount="1.8">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="modulator_in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fm1" amount="1.8">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="modulator_in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc2" waveform="saw">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc3" waveform="saw">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="merge0">
        <Pin id="in1" direction="in" type="signal" />
        <Pin id="in2" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="filter0" cutoff="2800" resonance="0.18" mode="lp">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr0" attack="1.1" decay="2.6" sustain="0.8" release="3.4">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.62" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in" />
      <Wire from="note" fromPort="out" to="fscale1" toPort="freq_in" />
      <Wire from="fscale0" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="fscale1" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="fm0" toPort="modulator_in" />
      <Wire from="osc1" fromPort="out" to="fm1" toPort="modulator_in" />
      <Wire from="note" fromPort="out" to="fm0" toPort="freq_in" />
      <Wire from="note" fromPort="out" to="fm1" toPort="freq_in" />
      <Wire from="fm0" fromPort="out" to="osc2" toPort="note_in" />
      <Wire from="fm1" fromPort="out" to="osc3" toPort="note_in" />
      <Wire from="osc2" fromPort="out" to="merge0" toPort="in1" />
      <Wire from="osc3" fromPort="out" to="merge0" toPort="in2" />
      <Wire from="merge0" fromPort="out" to="filter0" toPort="in" />
      <Wire from="filter0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="60" />
      <Box id="fscale0" x="60" y="380" />
      <Box id="fscale1" x="60" y="700" />
      <Box id="osc0" x="380" y="380" />
      <Box id="osc1" x="380" y="700" />
      <Box id="fm0" x="700" y="60" />
      <Box id="fm1" x="700" y="380" />
      <Box id="osc2" x="1020" y="60" />
      <Box id="osc3" x="1020" y="380" />
      <Box id="merge0" x="1340" y="200" />
      <Box id="filter0" x="1340" y="460" />
      <Box id="adsr0" x="1660" y="200" />
      <Box id="output" x="1660" y="520" />
    </Boxes>
  </Layout>
</SmolFM>