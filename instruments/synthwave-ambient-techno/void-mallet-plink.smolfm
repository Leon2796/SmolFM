<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="Void Mallet Plink" description="Deep-space mallet: a triangle pluck whose band pass sweeps open along a note-tracked F-ADSR, then echoes into a dark 240 ms tap." techniques="fadsr-cutoff-sweep,adsr-amp-envelope,burst-delay-resonance">
  <Graph>
    <Nodes>
      <Node id="note">
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fadsr0" attack="0.001" decay="0.3" sustain="0.85" release="0.5" up="3.6" down="1.15">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc0" waveform="triangle">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="filter0" cutoff="900" resonance="0.5" mode="bp">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="cutoff_mod_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr0" attack="0.001" decay="0.65" sustain="0.0" release="0.5">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="delay0" time="240" feedback="0.3" mix="0.4">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.7" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="fadsr0" toPort="freq_in" />
      <Wire from="fadsr0" fromPort="out" to="filter0" toPort="cutoff_mod_in" />
      <Wire from="note" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="filter0" toPort="in" />
      <Wire from="filter0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="delay0" toPort="in" />
      <Wire from="delay0" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="60" />
      <Box id="fadsr0" x="60" y="380" />
      <Box id="osc0" x="380" y="60" />
      <Box id="filter0" x="700" y="200" />
      <Box id="adsr0" x="1020" y="200" />
      <Box id="delay0" x="1020" y="500" />
      <Box id="output" x="1340" y="340" />
    </Boxes>
  </Layout>
</SmolFM>