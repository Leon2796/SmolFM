<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="Misty Tide Pad" description="Soft tide pad: two near-detuned triangles breathing through a perlin-drifted low pass whose wandering cutoff tracks the played key." techniques="fscale-detune-unison,perlin-cutoff-drift,adsr-amp-envelope">
  <Graph>
    <Nodes>
      <Node id="note">
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fscale0" factor="1.0025">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc0" waveform="triangle">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc1" waveform="triangle">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="oscDrift" waveform="perlin" mode="lfo" lforate="0.07">
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="fm0" amount="0.35">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="modulator_in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="merge0">
        <Pin id="in1" direction="in" type="signal" />
        <Pin id="in2" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="filter0" cutoff="1400" resonance="0.25" mode="lp">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="cutoff_mod_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr0" attack="2.0" decay="2.5" sustain="0.9" release="5.0">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.75" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in" />
      <Wire from="fscale0" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="note" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="merge0" toPort="in1" />
      <Wire from="osc1" fromPort="out" to="merge0" toPort="in2" />
      <Wire from="oscDrift" fromPort="out" to="fm0" toPort="modulator_in" />
      <Wire from="note" fromPort="out" to="fm0" toPort="freq_in" />
      <Wire from="fm0" fromPort="out" to="filter0" toPort="cutoff_mod_in" />
      <Wire from="merge0" fromPort="out" to="filter0" toPort="in" />
      <Wire from="filter0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="60" />
      <Box id="fscale0" x="60" y="380" />
      <Box id="osc0" x="380" y="60" />
      <Box id="osc1" x="380" y="380" />
      <Box id="merge0" x="700" y="200" />
      <Box id="oscDrift" x="60" y="700" />
      <Box id="fm0" x="380" y="700" />
      <Box id="filter0" x="1020" y="380" />
      <Box id="adsr0" x="1340" y="380" />
      <Box id="output" x="1660" y="500" />
    </Boxes>
  </Layout>
</SmolFM>