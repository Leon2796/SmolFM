<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="Nebula Strings" description="Ambient string ensemble: hard-panned micro-detuned saws breathing under a slow tremolo, shaped by a gentle low pass and a long bowing envelope." techniques="fscale-detune-unison,stereo-micropitch-spread,am-tremolo-lfo,sub-instrument-layering">
  <Graph>
    <Nodes>
      <Node id="note">
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fscale0" factor="0.9972">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fscale1" factor="1.0028">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc0" waveform="saw">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc1" waveform="saw">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="merge0">
        <Pin id="in1" direction="in" type="signal" />
        <Pin id="in2" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="filter0" cutoff="3200" resonance="0.15" mode="lp">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr0" attack="1.0" decay="1.6" sustain="0.85" release="3.4">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="oscTrem" waveform="sine" mode="lfo" lforate="4.8">
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="am0" amount="0.3">
        <Pin id="carrier_in" direction="in" type="signal" />
        <Pin id="modulator_in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.7" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in" />
      <Wire from="note" fromPort="out" to="fscale1" toPort="freq_in" />
      <Wire from="fscale0" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="fscale1" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="merge0" toPort="in1" />
      <Wire from="osc1" fromPort="out" to="merge0" toPort="in2" />
      <Wire from="merge0" fromPort="out" to="filter0" toPort="in" />
      <Wire from="filter0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="am0" toPort="carrier_in" />
      <Wire from="oscTrem" fromPort="out" to="am0" toPort="modulator_in" />
      <Wire from="am0" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="60" />
      <Box id="fscale0" x="60" y="380" />
      <Box id="fscale1" x="60" y="700" />
      <Box id="osc0" x="380" y="380" />
      <Box id="osc1" x="380" y="700" />
      <Box id="merge0" x="700" y="380" />
      <Box id="filter0" x="1020" y="380" />
      <Box id="adsr0" x="1020" y="680" />
      <Box id="oscTrem" x="60" y="1020" />
      <Box id="am0" x="1340" y="380" />
      <Box id="output" x="1660" y="500" />
    </Boxes>
  </Layout>
</SmolFM>