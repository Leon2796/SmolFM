<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="Interval Marimba Wood" description="Warm wooden marimba keys: the FM modulator rides a tempered major third so the 13.7-cent drift against pure 5:4 breathes inharmonically, wrapped in a short slapback body under a soft mallet transient" techniques="fscale-interval-modulator-fm, delay-slapback-doubler">
  <Graph>
    <Nodes>
      <Node id="note">
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fscale0" factor="1" interval="major_third_up" />
      <Node id="fscale1" factor="1" interval="octave_up" />
      <Node id="osc0" waveform="sine">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc1" waveform="sine">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc2" waveform="triangle">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="fm0" amount="1.4">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="modulator_in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="adsr0" attack="0.002" decay="0.7" sustain="0.0" release="0.35">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr1" attack="0.002" decay="0.45" sustain="0.0" release="0.3">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="delay0" time="110" feedback="0.15" mix="0.22">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.8" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in" />
      <Wire from="fscale0" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="fm0" toPort="modulator_in" />
      <Wire from="note" fromPort="out" to="fm0" toPort="freq_in" />
      <Wire from="fm0" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="osc1" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="delay0" toPort="in" />
      <Wire from="delay0" fromPort="out" to="output" toPort="in1" />
      <Wire from="note" fromPort="out" to="fscale1" toPort="freq_in" />
      <Wire from="fscale1" fromPort="out" to="osc2" toPort="note_in" />
      <Wire from="osc2" fromPort="out" to="adsr1" toPort="in" />
      <Wire from="adsr1" fromPort="out" to="output" toPort="in2" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="260" />
      <Box id="fscale0" x="380" y="60" />
      <Box id="fscale1" x="380" y="460" />
      <Box id="osc0" x="700" y="60" />
      <Box id="osc2" x="700" y="460" />
      <Box id="fm0" x="1020" y="60" />
      <Box id="osc1" x="1340" y="60" />
      <Box id="adsr0" x="1660" y="60" />
      <Box id="adsr1" x="1660" y="460" />
      <Box id="delay0" x="1940" y="260" />
      <Box id="output" x="2220" y="260" />
    </Boxes>
  </Layout>
</SmolFM>