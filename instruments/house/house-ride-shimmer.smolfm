<?xml version="1.0" encoding="UTF-8"?>

<SmolFM version="2" name="house-ride-shimmer">
  <description>Jazz-leaning house ride cymbal: 7.5 kHz static noise through foldback waveshaping for inharmonic sparkle, long shimmering decay with slow AM movement.</description>
  <Nodes>
    <Node id="note" x="120" y="60">
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="osc0" x="60" y="60" mode="1" staticfreq="7500" waveform="4">
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="shape0" x="360" y="60" drive="0.75" shape="2">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="gain0" x="680" y="60" factor="0.35">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="osc1" x="60" y="380" mode="2" lforate="3.2" waveform="0">
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="am0" x="1000" y="60" amount="0.4">
      <Pin id="carrier_in" direction="in" type="signal"/>
      <Pin id="modulator_in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="adsr0" x="1320" y="60" attack="0.001" decay="1.2" sustain="0.0" release="0.8">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="output" x="1640" y="60" level="0.6"/>
  </Nodes>
  <Connections>
    <Wire from="osc0" fromPort="out" to="shape0" toPort="in"/>
    <Wire from="shape0" fromPort="out" to="gain0" toPort="in"/>
    <Wire from="gain0" fromPort="out" to="am0" toPort="carrier_in"/>
    <Wire from="osc1" fromPort="out" to="am0" toPort="modulator_in"/>
    <Wire from="am0" fromPort="out" to="adsr0" toPort="in"/>
    <Wire from="adsr0" fromPort="out" to="output" toPort="in1"/>
    <Wire from="note" fromPort="out" to="osc0" toPort="note_in"/>
    <Wire from="note" fromPort="out" to="osc1" toPort="note_in"/>
  </Connections>
</SmolFM>