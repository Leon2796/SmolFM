<?xml version="1.0" encoding="UTF-8"?>

<SmolFM version="2" name="house-bass-rolling">
  <description>Rolling UK house bass: sub sine foundation (one octave down) stacked with an FM saw bite layer whose LP filter opens on each attack (cutoff sweep), tight envelope for pumping 16th grooves.</description>
  <Nodes>
    <Node id="note" x="60" y="60">
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="fscale0" x="60" y="680" factor="0.5"/>
    <Node id="osc2" x="360" y="680" waveform="0">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="adsr2" x="680" y="680" attack="0.002" decay="0.15" sustain="0.85" release="0.12">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="fm0" x="360" y="60" amount="1.1">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="modulator_in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="fscale1" x="60" y="380" factor="1.0"/>
    <Node id="osc1" x="60" y="380" waveform="1" mode="0">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="osc0" x="680" y="60" waveform="1">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="adsr0" x="1000" y="60" attack="0.001" decay="0.12" sustain="0.6" release="0.1">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="gain0" x="1000" y="60" factor="0.6">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="fadsr1" x="1000" y="240" attack="0.05" decay="0.3" sustain="0.1" release="0.25" up="5.0" down="0.05">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="filter0" x="1320" y="60" cutoff="160" resonance="0.45" mode="0">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="cutoff_mod_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="fscale2" x="1320" y="380" factor="0.364"/>
    <Node id="output" x="1640" y="60" level="0.65"/>
  </Nodes>
  <Connections>
    <Wire from="note" fromPort="out" to="fm0" toPort="freq_in"/>
    <Wire from="fm0" fromPort="out" to="osc0" toPort="note_in"/>
    <Wire from="note" fromPort="out" to="fscale1" toPort="freq_in"/>
    <Wire from="fscale1" fromPort="out" to="osc1" toPort="note_in"/>
    <Wire from="osc1" fromPort="out" to="fm0" toPort="modulator_in"/>
    <Wire from="osc0" fromPort="out" to="filter0" toPort="in"/>
    <Wire from="note" fromPort="out" to="fscale2" toPort="freq_in"/>
    <Wire from="fscale2" fromPort="out" to="fadsr1" toPort="freq_in"/>
    <Wire from="fadsr1" fromPort="out" to="filter0" toPort="cutoff_mod_in"/>
    <Wire from="filter0" fromPort="out" to="gain0" toPort="in"/>
    <Wire from="gain0" fromPort="out" to="adsr0" toPort="in"/>
    <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in"/>
    <Wire from="fscale0" fromPort="out" to="osc2" toPort="note_in"/>
    <Wire from="osc2" fromPort="out" to="adsr2" toPort="in"/>
    <Wire from="adsr0" fromPort="out" to="output" toPort="in1"/>
    <Wire from="adsr2" fromPort="out" to="output" toPort="in2"/>
  </Connections>
</SmolFM>