<?xml version="1.0" encoding="UTF-8"?>

<SmolFM version="2" name="house-pad-deepy">
  <description>Deep atmospheric house pad: two triangle voices with slow FM sweep via F-ADSR on the modulator path (timbre blooms over 2s) and an LP auto-wah (0.35 Hz note-gated LFO on the cutoff) breathing over the sustain, long release, sub-octave reinforcement.</description>
  <Nodes>
    <Node id="note" x="60" y="60">
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="fm0" x="360" y="60" amount="0.55">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="modulator_in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="fadsr0" x="360" y="380" attack="1.6" decay="1.5" sustain="0.2" release="2.0" up="1.0" down="0.35">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="fscale0" x="60" y="380" factor="2.0"/>
    <Node id="osc1" x="60" y="680" waveform="0">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="osc0" x="680" y="60" waveform="2">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="fscale1" x="60" y="940" factor="0.5"/>
    <Node id="osc2" x="360" y="940" waveform="0">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="adsr0" x="1000" y="60" attack="1.2" decay="0.6" sustain="0.8" release="3.5">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="osc3" x="60" y="1200" mode="2" lforate="0.35" waveform="0">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="filter0" x="1320" y="60" cutoff="500" resonance="0.5" mode="0">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="cutoff_mod_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="adsr1" x="680" y="940" attack="1.5" decay="0.6" sustain="0.8" release="3.8">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="output" x="1640" y="60" level="0.4"/>
  </Nodes>
  <Connections>
    <Wire from="note" fromPort="out" to="fm0" toPort="freq_in"/>
    <Wire from="fm0" fromPort="out" to="osc0" toPort="note_in"/>
    <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in"/>
    <Wire from="fscale0" fromPort="out" to="fadsr0" toPort="freq_in"/>
    <Wire from="fadsr0" fromPort="out" to="osc1" toPort="note_in"/>
    <Wire from="osc1" fromPort="out" to="fm0" toPort="modulator_in"/>
    <Wire from="osc0" fromPort="out" to="filter0" toPort="in"/>
    <Wire from="note" fromPort="out" to="osc3" toPort="note_in"/>
    <Wire from="osc3" fromPort="out" to="filter0" toPort="cutoff_mod_in"/>
    <Wire from="filter0" fromPort="out" to="adsr0" toPort="in"/>
    <Wire from="osc2" fromPort="out" to="adsr1" toPort="in"/>
    <Wire from="note" fromPort="out" to="fscale1" toPort="freq_in"/>
    <Wire from="fscale1" fromPort="out" to="osc2" toPort="note_in"/>
    <Wire from="adsr0" fromPort="out" to="output" toPort="in1"/>
    <Wire from="adsr1" fromPort="out" to="output" toPort="in2"/>
  </Connections>
</SmolFM>