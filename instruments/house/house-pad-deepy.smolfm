<SmolFM version="3" name="house-pad-deepy">
  <Graph>
    <Nodes>
      <Node id="note">
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fm0" amount="0.55">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="modulator_in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fadsr0" attack="1.6" decay="1.5" sustain="0.2" release="2.0" up="1.0" down="0.35">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fscale0" factor="2.0" />
      <Node id="osc1" waveform="sine">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc0" waveform="square">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="fscale1" factor="0.5" />
      <Node id="osc2" waveform="sine">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr0" attack="1.2" decay="0.6" sustain="0.8" release="3.5">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc3" waveform="sine" mode="lfo" lforate="0.35">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="filter0" mode="lp" cutoff="500" resonance="0.5">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="cutoff_mod_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr1" attack="1.5" decay="0.6" sustain="0.8" release="3.8">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.4" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="fm0" toPort="freq_in" />
      <Wire from="fm0" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in" />
      <Wire from="fscale0" fromPort="out" to="fadsr0" toPort="freq_in" />
      <Wire from="fadsr0" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="osc1" fromPort="out" to="fm0" toPort="modulator_in" />
      <Wire from="osc0" fromPort="out" to="filter0" toPort="in" />
      <Wire from="note" fromPort="out" to="osc3" toPort="note_in" />
      <Wire from="osc3" fromPort="out" to="filter0" toPort="cutoff_mod_in" />
      <Wire from="filter0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="osc2" fromPort="out" to="adsr1" toPort="in" />
      <Wire from="note" fromPort="out" to="fscale1" toPort="freq_in" />
      <Wire from="fscale1" fromPort="out" to="osc2" toPort="note_in" />
      <Wire from="adsr0" fromPort="out" to="output" toPort="in1" />
      <Wire from="adsr1" fromPort="out" to="output" toPort="in2" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="60" />
      <Box id="fm0" x="360" y="60" />
      <Box id="fadsr0" x="360" y="380" />
      <Box id="fscale0" x="60" y="380" />
      <Box id="osc1" x="60" y="680" />
      <Box id="osc0" x="680" y="60" />
      <Box id="fscale1" x="60" y="940" />
      <Box id="osc2" x="360" y="940" />
      <Box id="adsr0" x="1000" y="60" />
      <Box id="osc3" x="60" y="1200" />
      <Box id="filter0" x="1320" y="60" />
      <Box id="adsr1" x="680" y="940" />
      <Box id="output" x="1640" y="60" />
    </Boxes>
  </Layout>
</SmolFM>