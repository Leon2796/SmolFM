<?xml version="1.0" encoding="UTF-8"?>

<SmolFM version="2" name="house-kick-loose">
  <description>Loose jazzy house kick: static 52 Hz sine gated by the note input, long amp decay for a soft glide feel, plus a gentle noise transient layer.</description>
  <Nodes>
    <Node id="note" x="60" y="60">
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="osc0" x="680" y="60" mode="1" staticfreq="52" waveform="0">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="osc1" x="60" y="380" mode="1" staticfreq="1200" waveform="4">
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="adsr1" x="360" y="380" attack="0.001" decay="0.03" sustain="0.0" release="0.02">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="gain1" x="680" y="380" factor="0.15">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="shape0" x="1000" y="60" drive="0.25" shape="0">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="adsr0" x="1000" y="240" attack="0.001" decay="0.45" sustain="0.0" release="0.18">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="output" x="1320" y="60" level="0.85"/>
  </Nodes>
  <Connections>
    <Wire from="note" fromPort="out" to="osc0" toPort="note_in"/>
    <Wire from="osc0" fromPort="out" to="shape0" toPort="in"/>
    <Wire from="shape0" fromPort="out" to="adsr0" toPort="in"/>
    <Wire from="osc1" fromPort="out" to="adsr1" toPort="in"/>
    <Wire from="adsr1" fromPort="out" to="gain1" toPort="in"/>
    <Wire from="adsr0" fromPort="out" to="output" toPort="in1"/>
    <Wire from="gain1" fromPort="out" to="output" toPort="in2"/>
    <Wire from="note" fromPort="out" to="osc1" toPort="note_in"/>
  </Connections>
</SmolFM>