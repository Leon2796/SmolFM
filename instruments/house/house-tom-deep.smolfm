<?xml version="1.0" encoding="UTF-8"?>

<SmolFM version="2" name="house-tom-deep">
  <description>Deep house tom: static 120 Hz sine body plus a 300 Hz static strike-transient layer (faster, shorter envelope); both gated by the note input, fully pitch-invariant.</description>
  <Nodes>
    <Node id="note" x="60" y="60">
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="osc0" x="680" y="60" mode="1" staticfreq="120" waveform="0">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="osc1" x="680" y="380" mode="1" staticfreq="300" waveform="0">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="adsr0" x="1000" y="60" attack="0.001" decay="0.32" sustain="0.0" release="0.15">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="adsr1" x="1000" y="380" attack="0.001" decay="0.08" sustain="0.0" release="0.04">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="gain1" x="1320" y="380" factor="0.35">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="output" x="1640" y="60" level="0.8"/>
  </Nodes>
  <Connections>
    <Wire from="note" fromPort="out" to="osc0" toPort="note_in"/>
    <Wire from="note" fromPort="out" to="osc1" toPort="note_in"/>
    <Wire from="osc0" fromPort="out" to="adsr0" toPort="in"/>
    <Wire from="osc1" fromPort="out" to="adsr1" toPort="in"/>
    <Wire from="adsr0" fromPort="out" to="output" toPort="in1"/>
    <Wire from="adsr1" fromPort="out" to="gain1" toPort="in"/>
    <Wire from="gain1" fromPort="out" to="output" toPort="in2"/>
  </Connections>
</SmolFM>