<SmolFM version="3" name="house-hihat-open">
  <Graph>
    <Nodes>
      <Node id="note">
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc0" waveform="noise" mode="static" staticfreq="5600">
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="shape0" drive="0.5" shape="hard">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="am0" amount="0.35">
        <Pin id="carrier_in" direction="in" type="signal" />
        <Pin id="modulator_in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc1" waveform="sine" mode="lfo" lforate="11.0">
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr0" attack="0.001" decay="0.35" sustain="0.0" release="0.15">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.65" />
    </Nodes>
    <Connections>
      <Wire from="osc0" fromPort="out" to="shape0" toPort="in" />
      <Wire from="shape0" fromPort="out" to="am0" toPort="carrier_in" />
      <Wire from="osc1" fromPort="out" to="am0" toPort="modulator_in" />
      <Wire from="am0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="output" toPort="in1" />
      <Wire from="note" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="note" fromPort="out" to="osc1" toPort="note_in" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="120" y="60" />
      <Box id="osc0" x="60" y="60" />
      <Box id="shape0" x="360" y="60" />
      <Box id="am0" x="680" y="60" />
      <Box id="osc1" x="60" y="380" />
      <Box id="adsr0" x="1000" y="60" />
      <Box id="output" x="1320" y="60" />
    </Boxes>
  </Layout>
</SmolFM>