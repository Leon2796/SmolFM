<?xml version="1.0" encoding="UTF-8"?>

<SmolFM version="2" name="house-hihat-open">
  <description>Open house hi-hat: same metallic noise core as the closed hat but with a long ringing decay and a slight AM shimmer from an 11 Hz LFO oscillator for movement.</description>
  <Nodes>
    <Node id="note" x="120" y="60">
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="osc0" x="60" y="60" mode="1" staticfreq="5600" waveform="4">
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="shape0" x="360" y="60" drive="0.5" shape="1">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="am0" x="680" y="60" amount="0.35">
      <Pin id="carrier_in" direction="in" type="signal"/>
      <Pin id="modulator_in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="osc1" x="60" y="380" mode="2" lforate="11.0" waveform="0">
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="adsr0" x="1000" y="60" attack="0.001" decay="0.35" sustain="0.0" release="0.15">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="output" x="1320" y="60" level="0.65"/>
  </Nodes>
  <Connections>
    <Wire from="osc0" fromPort="out" to="shape0" toPort="in"/>
    <Wire from="shape0" fromPort="out" to="am0" toPort="carrier_in"/>
    <Wire from="osc1" fromPort="out" to="am0" toPort="modulator_in"/>
    <Wire from="am0" fromPort="out" to="adsr0" toPort="in"/>
    <Wire from="adsr0" fromPort="out" to="output" toPort="in1"/>
    <Wire from="note" fromPort="out" to="osc0" toPort="note_in"/>
    <Wire from="note" fromPort="out" to="osc1" toPort="note_in"/>
  </Connections>
</SmolFM>