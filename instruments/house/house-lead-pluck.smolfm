<?xml version="1.0" encoding="UTF-8"?>

<SmolFM version="2" name="house-lead-pluck">
  <description>Plucky house lead: FM with 1:3 harmonic ratio, fast attack, short decay, ping-pong delays on two tempo divisions for wide bounce.</description>
  <Nodes>
    <Node id="note" x="60" y="60">
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="fm0" x="360" y="60" amount="2.3">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="modulator_in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="fscale0" x="60" y="380" factor="3.0"/>
    <Node id="osc1" x="360" y="380" waveform="0">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="osc0" x="680" y="60" waveform="0">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="adsr0" x="1000" y="60" attack="0.001" decay="0.3" sustain="0.1" release="0.25">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="delay0" x="1000" y="380" time="250" feedback="0.4" mix="0.35" sync="1" division="2">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="delay1" x="1000" y="680" time="167" feedback="0.3" mix="0.3" sync="1" division="3">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="output" x="1320" y="60" level="0.65"/>
  </Nodes>
  <Connections>
    <Wire from="note" fromPort="out" to="fm0" toPort="freq_in"/>
    <Wire from="fm0" fromPort="out" to="osc0" toPort="note_in"/>
    <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in"/>
    <Wire from="fscale0" fromPort="out" to="osc1" toPort="note_in"/>
    <Wire from="osc1" fromPort="out" to="fm0" toPort="modulator_in"/>
    <Wire from="osc0" fromPort="out" to="adsr0" toPort="in"/>
    <Wire from="adsr0" fromPort="out" to="delay0" toPort="in"/>
    <Wire from="adsr0" fromPort="out" to="delay1" toPort="in"/>
    <Wire from="delay0" fromPort="out" to="output" toPort="in1"/>
    <Wire from="delay1" fromPort="out" to="output" toPort="in2"/>
  </Connections>
</SmolFM>