<?xml version="1.0" encoding="UTF-8"?>

<SmolFM version="2" name="house-fx-filter-riser">
  <description>Filter riser FX: noise burst through an LP filter whose cutoff is swept upward by a slow F-ADSR (up 8x) — the classic pre-drop riser, gated by the note and ending in a long release.</description>
  <Nodes>
    <Node id="note" x="60" y="60">
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="osc0" x="680" y="60" mode="1" staticfreq="3200" waveform="4">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="fadsr0" x="380" y="60" attack="2.5" decay="0.5" sustain="0.9" release="0.8" up="8.0" down="0.006">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="filter0" x="1000" y="60" cutoff="400" resonance="0.6" mode="0">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="cutoff_mod_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="adsr0" x="1320" y="60" attack="2.5" decay="0.3" sustain="0.85" release="1.2">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="output" x="1320" y="380" level="0.55"/>
  </Nodes>
  <Connections>
    <Wire from="note" fromPort="out" to="osc0" toPort="note_in"/>
    <Wire from="note" fromPort="out" to="fadsr0" toPort="freq_in"/>
    <Wire from="fadsr0" fromPort="out" to="filter0" toPort="cutoff_mod_in"/>
    <Wire from="osc0" fromPort="out" to="filter0" toPort="in"/>
    <Wire from="filter0" fromPort="out" to="adsr0" toPort="in"/>
    <Wire from="adsr0" fromPort="out" to="output" toPort="in1"/>
  </Connections>
</SmolFM>