<?xml version="1.0" encoding="UTF-8"?>

<SmolFM version="2" name="house-hihat-closed">
  <description>Closed house hi-hat: static noise at 6 kHz through a hard waveshaper for metallic grit, ultra-fast decay, tight tick.</description>
  <Nodes>
    <Node id="note" x="120" y="60">
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="osc0" x="60" y="60" mode="1" staticfreq="6000" waveform="4">
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="shape0" x="360" y="60" drive="0.6" shape="1">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="gain0" x="680" y="60" factor="0.3">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="adsr0" x="1000" y="60" attack="0.001" decay="0.045" sustain="0.0" release="0.02">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="output" x="1320" y="60" level="0.7"/>
  </Nodes>
  <Connections>
    <Wire from="osc0" fromPort="out" to="shape0" toPort="in"/>
    <Wire from="shape0" fromPort="out" to="gain0" toPort="in"/>
    <Wire from="gain0" fromPort="out" to="adsr0" toPort="in"/>
    <Wire from="adsr0" fromPort="out" to="output" toPort="in1"/>
    <Wire from="note" fromPort="out" to="osc0" toPort="note_in"/>
  </Connections>
</SmolFM>