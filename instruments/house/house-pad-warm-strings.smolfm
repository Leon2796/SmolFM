<?xml version="1.0" encoding="UTF-8"?>

<SmolFM version="2" name="house-pad-warm-strings">
  <description>Warm house string pad: three detuned saw voices (±0.5%) with FM movement (0.3:1 slow modulator), very slow attack and long release, low master level for stacking.</description>
  <Nodes>
    <Node id="note" x="60" y="60">
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="osc0" x="1020" y="60" waveform="1">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="fm0" x="700" y="60" amount="0.35">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="modulator_in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="osc3" x="60" y="1020" mode="2" lforate="0.4" waveform="0">
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="osc1" x="1020" y="380" waveform="1">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="fscale0" x="380" y="380" factor="1.005"/>
    <Node id="osc2" x="1020" y="700" waveform="1">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="fscale1" x="380" y="700" factor="0.995"/>
    <Node id="adsr0" x="1340" y="60" attack="1.4" decay="0.5" sustain="0.85" release="3.2">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="adsr1" x="1340" y="380" attack="1.8" decay="0.5" sustain="0.85" release="3.5">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="adsr2" x="1340" y="700" attack="1.2" decay="0.5" sustain="0.85" release="3.0">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="output" x="1660" y="60" level="0.32"/>
  </Nodes>
  <Connections>
    <Wire from="note" fromPort="out" to="fm0" toPort="freq_in"/>
    <Wire from="osc3" fromPort="out" to="fm0" toPort="modulator_in"/>
    <Wire from="fm0" fromPort="out" to="osc0" toPort="note_in"/>
    <Wire from="osc0" fromPort="out" to="adsr0" toPort="in"/>
    <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in"/>
    <Wire from="fscale0" fromPort="out" to="osc1" toPort="note_in"/>
    <Wire from="osc1" fromPort="out" to="adsr1" toPort="in"/>
    <Wire from="note" fromPort="out" to="fscale1" toPort="freq_in"/>
    <Wire from="fscale1" fromPort="out" to="osc2" toPort="note_in"/>
    <Wire from="osc2" fromPort="out" to="adsr2" toPort="in"/>
    <Wire from="adsr0" fromPort="out" to="output" toPort="in1"/>
    <Wire from="adsr1" fromPort="out" to="output" toPort="in2"/>
    <Wire from="adsr2" fromPort="out" to="output" toPort="in3"/>
    <Wire from="note" fromPort="out" to="osc3" toPort="note_in"/>
  </Connections>
</SmolFM>