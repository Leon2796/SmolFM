<?xml version="1.0" encoding="UTF-8"?>

<SmolFM version="2" name="house-kick-punch">
  <description>Punchy techno-leaning kick: static 58 Hz sine gated by the note input, hard-clipped body for an aggressive attack.</description>
  <Nodes>
    <Node id="note" x="60" y="60">
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="osc0" x="680" y="60" mode="1" staticfreq="58" waveform="0">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="shape0" x="680" y="380" drive="0.55" shape="1">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="gain0" x="1000" y="380" factor="0.5">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="adsr0" x="1000" y="60" attack="0.001" decay="0.28" sustain="0.0" release="0.1">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="output" x="1320" y="60" level="0.85"/>
  </Nodes>
  <Connections>
    <Wire from="note" fromPort="out" to="osc0" toPort="note_in"/>
    <Wire from="osc0" fromPort="out" to="shape0" toPort="in"/>
    <Wire from="shape0" fromPort="out" to="gain0" toPort="in"/>
    <Wire from="gain0" fromPort="out" to="adsr0" toPort="in"/>
    <Wire from="adsr0" fromPort="out" to="output" toPort="in1"/>
  </Connections>
</SmolFM>