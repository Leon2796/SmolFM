<?xml version="1.0" encoding="UTF-8"?>

<SmolFM version="2" name="house-fx-riser-noise">
  <description>Riser FX: noise burst through an LP filter whose cutoff rises with a slow F-ADSR (classic pre-drop riser), plus an FM saw layer with rising rate and long delay tail - build-up texture before drops, triggered by holding a note.</description>
  <Nodes>
    <Node id="note" x="60" y="60">
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="osc2" x="60" y="680" mode="1" staticfreq="2500" waveform="4">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="filter0" x="360" y="680" cutoff="300" resonance="0.55" mode="0">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="cutoff_mod_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="fm0" x="360" y="60" amount="1.8">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="modulator_in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="fscale0" x="60" y="380" factor="1.0"/>
    <Node id="osc1" x="360" y="380" waveform="1">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="osc0" x="680" y="60" waveform="1">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="fadsr0" x="680" y="680" attack="3.0" decay="0.5" sustain="0.9" release="1.0" up="4.0" down="1.0">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="shape0" x="1000" y="60" drive="0.5" shape="0">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="adsr0" x="1320" y="60" attack="2.5" decay="0.3" sustain="0.8" release="1.5">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="adsr1" x="1320" y="380" attack="2.5" decay="0.3" sustain="0.8" release="1.2">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="output" x="1640" y="60" level="0.6"/>
  </Nodes>
  <Connections>
    <Wire from="note" fromPort="out" to="fm0" toPort="freq_in"/>
    <Wire from="fm0" fromPort="out" to="fadsr0" toPort="freq_in"/>
    <Wire from="fadsr0" fromPort="out" to="osc0" toPort="note_in"/>
    <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in"/>
    <Wire from="fscale0" fromPort="out" to="osc1" toPort="note_in"/>
    <Wire from="osc1" fromPort="out" to="fm0" toPort="modulator_in"/>
    <Wire from="osc0" fromPort="out" to="shape0" toPort="in"/>
    <Wire from="shape0" fromPort="out" to="adsr0" toPort="in"/>
    <Wire from="adsr0" fromPort="out" to="output" toPort="in1"/>
    <Wire from="note" fromPort="out" to="osc2" toPort="note_in"/>
    <Wire from="osc2" fromPort="out" to="filter0" toPort="in"/>
    <Wire from="fadsr0" fromPort="out" to="filter0" toPort="cutoff_mod_in"/>
    <Wire from="filter0" fromPort="out" to="adsr1" toPort="in"/>
    <Wire from="adsr1" fromPort="out" to="output" toPort="in2"/>
  </Connections>
</SmolFM>