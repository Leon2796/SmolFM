<?xml version="1.0" encoding="UTF-8"?>

<SmolFM version="2" name="house-bass-growl-filter">
  <description>Growl bass: saw carrier through an LP filter whose cutoff is an F-ADSR-driven sweep — filter closed at ~180 Hz, opening 4x on the attack (classic house growl), plus a stable sub sine layer.</description>
  <Nodes>
    <Node id="note" x="60" y="60">
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="osc0" x="680" y="60" waveform="1">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="osc1" x="680" y="380" waveform="0">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="fscale0" x="360" y="380" factor="0.5">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="fadsr0" x="360" y="60" attack="0.06" decay="0.35" sustain="0.15" release="0.25" up="4.0" down="0.012">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="filter0" x="1000" y="60" cutoff="1000" resonance="0.45" mode="0">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="cutoff_mod_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="gain1" x="1000" y="380" factor="0.55">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="adsr0" x="1320" y="60" attack="0.004" decay="0.25" sustain="0.8" release="0.2">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="adsr1" x="1320" y="380" attack="0.004" decay="0.25" sustain="0.8" release="0.2">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="output" x="1640" y="60" level="0.75"/>
  </Nodes>
  <Connections>
    <Wire from="note" fromPort="out" to="osc0" toPort="note_in"/>
    <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in"/>
    <Wire from="fscale0" fromPort="out" to="osc1" toPort="note_in"/>
    <Wire from="note" fromPort="out" to="fadsr0" toPort="freq_in"/>
    <Wire from="fadsr0" fromPort="out" to="filter0" toPort="cutoff_mod_in"/>
    <Wire from="osc0" fromPort="out" to="filter0" toPort="in"/>
    <Wire from="filter0" fromPort="out" to="adsr0" toPort="in"/>
    <Wire from="osc1" fromPort="out" to="gain1" toPort="in"/>
    <Wire from="gain1" fromPort="out" to="adsr1" toPort="in"/>
    <Wire from="adsr0" fromPort="out" to="output" toPort="in1"/>
    <Wire from="adsr1" fromPort="out" to="output" toPort="in2"/>
  </Connections>
</SmolFM>