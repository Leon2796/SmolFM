<?xml version="1.0" encoding="UTF-8"?>

<SmolFM version="2" name="house-lead-saw-fm">
  <description>Big room house lead: saw carrier with heavy FM growl (2:1) plus soft-saturation, long release with delay tail - festival-ready bright lead.</description>
  <Nodes>
    <Node id="note" x="60" y="60">
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="fm0" x="360" y="60" amount="1.35">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="modulator_in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="fscale0" x="60" y="380" factor="2.0"/>
    <Node id="osc1" x="360" y="380" waveform="1">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="osc0" x="680" y="60" waveform="1">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="shape0" x="1000" y="60" drive="0.4" shape="0">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="adsr0" x="1320" y="60" attack="0.01" decay="0.25" sustain="0.8" release="0.5">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="delay0" x="1320" y="380" time="375" feedback="0.45" mix="0.3" sync="1" division="1">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="output" x="1640" y="60" level="0.65"/>
  </Nodes>
  <Connections>
    <Wire from="note" fromPort="out" to="fm0" toPort="freq_in"/>
    <Wire from="fm0" fromPort="out" to="osc0" toPort="note_in"/>
    <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in"/>
    <Wire from="fscale0" fromPort="out" to="osc1" toPort="note_in"/>
    <Wire from="osc1" fromPort="out" to="fm0" toPort="modulator_in"/>
    <Wire from="osc0" fromPort="out" to="shape0" toPort="in"/>
    <Wire from="shape0" fromPort="out" to="adsr0" toPort="in"/>
    <Wire from="adsr0" fromPort="out" to="delay0" toPort="in"/>
    <Wire from="delay0" fromPort="out" to="output" toPort="in1"/>
  </Connections>
</SmolFM>