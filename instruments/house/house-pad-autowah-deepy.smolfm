<?xml version="1.0" encoding="UTF-8"?>

<SmolFM version="2" name="house-pad-autowah-deepy">
  <description>Deep house pad: two detuned saws through an LP filter breathing with a note-synced LFO (auto-wah), slow attack, long release — the pad starts dark and opens rhythmically.</description>
  <Nodes>
    <Node id="note" x="60" y="60">
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="osc0" x="1020" y="60" waveform="1">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="osc1" x="1020" y="380" waveform="1">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="fscale0" x="380" y="380" factor="1.005">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="osc2" x="380" y="680" mode="2" lforate="2.0" waveform="0">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="filter0" x="1320" y="60" cutoff="600" resonance="0.55" mode="0">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="cutoff_mod_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="gain0" x="1020" y="700" factor="0.5">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="adsr0" x="1640" y="60" attack="1.2" decay="0.5" sustain="0.85" release="3.0">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="output" x="1960" y="60" level="0.35"/>
  </Nodes>
  <Connections>
    <Wire from="note" fromPort="out" to="osc0" toPort="note_in"/>
    <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in"/>
    <Wire from="fscale0" fromPort="out" to="osc1" toPort="note_in"/>
    <Wire from="note" fromPort="out" to="osc2" toPort="note_in"/>
    <Wire from="osc0" fromPort="out" to="gain0" toPort="in"/>
    <Wire from="gain0" fromPort="out" to="filter0" toPort="in"/>
    <Wire from="osc2" fromPort="out" to="filter0" toPort="cutoff_mod_in"/>
    <Wire from="filter0" fromPort="out" to="adsr0" toPort="in"/>
    <Wire from="adsr0" fromPort="out" to="output" toPort="in1"/>
  </Connections>
</SmolFM>