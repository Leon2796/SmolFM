"<?xml version=\"1.0\" encoding=\"UTF-8\"?>
<SmolFmPatch>
  <Nodes>
    <Node id=\"note\" x=\"60\" y=\"100\"/>
    <Node id=\"osc0\" x=\"300\" y=\"100\" waveform=\"0\" mode=\"2\" lforate=\"0.3\">
      <Pin id=\"note_in\" direction=\"in\" type=\"frequency\"/>
      <Pin id=\"out\" direction=\"out\" type=\"signal\"/>
    </Node>
    <Node id=\"osc1\" x=\"300\" y=\"250\" waveform=\"0\" mode=\"2\" lforate=\"0.4\">
      <Pin id=\"note_in\" direction=\"in\" type=\"frequency\"/>
      <Pin id=\"out\" direction=\"out\" type=\"signal\"/>
    </Node>
    <Node id=\"adsr0\" x=\"550\" y=\"175\" attack=\"0.8\" decay=\"1.5\" sustain=\"0.6\" release=\"2.0\">
      <Pin id=\"in\" direction=\"in\" type=\"signal\"/>
      <Pin id=\"out\" direction=\"out\" type=\"signal\"/>
    </Node>
    <Node id=\"delay0\" x=\"750\" y=\"175\" timems=\"600\" feedback=\"0.55\" mix=\"0.6\" sync=\"0\">
      <Pin id=\"in\" direction=\"in\" type=\"signal\"/>
      <Pin id=\"out\" direction=\"out\" type=\"signal\"/>
    </Node>
    <Node id=\"output\" x=\"950\" y=\"175\">
      <Pin id=\"in1\" direction=\"in\" type=\"signal\"/>
    </Node>
  </Nodes>
  <Connections>
    <Wire from=\"osc0\" fromPort=\"out\" to=\"adsr0\" toPort=\"in\"/>
    <Wire from=\"osc1\" fromPort=\"out\" to=\"adsr0\" toPort=\"in\"/>
    <Wire from=\"adsr0\" fromPort=\"out\" to=\"delay0\" toPort=\"in\"/>
    <Wire from=\"delay0\" fromPort=\"out\" to=\"output\" toPort=\"in1\"/>
  </Connections>
</SmolFmPatch>"