<SmolFM version="3">
  <Graph>
    <Nodes>
      <Node id="note" />
      <Node id="osc0" waveform="sine" mode="lfo" lforate="0.4">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr0" attack="0.8" decay="1.5" sustain="0.6" release="2.0">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="delay0" feedback="0.5" mix="0.5" sync="off">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.8" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="delay0" toPort="in" />
      <Wire from="delay0" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="100" />
      <Box id="osc0" x="300" y="100" />
      <Box id="adsr0" x="500" y="100" />
      <Box id="delay0" x="700" y="100" />
      <Box id="output" x="900" y="100" />
    </Boxes>
  </Layout>
</SmolFM>