"<?xml version=\"1.0\" encoding=\"UTF-8\"?>
<SmolFmPatch>
  <Nodes>
    <Node id=\"note\" x=\"60\" y=\"100\"/>
    <Node id=\"fscale0\" x=\"200\" y=\"100\" factor=\"0.5\">
      <Pin id=\"freq_in\" direction=\"in\" type=\"frequency\"/>
      <Pin id=\"out\" direction=\"out\" type=\"frequency\"/>
    </Node>
    <Node id=\"osc0\" x=\"400\" y=\"100\" waveform=\"1\">
      <Pin id=\"note_in\" direction=\"in\" type=\"frequency\"/>
      <Pin id=\"out\" direction=\"out\" type=\"signal\"/>
    </Node>
    <Node id=\"osc1\" x=\"400\" y=\"250\" waveform=\"1\">
      <Pin id=\"note_in\" direction=\"in\" type=\"frequency\"/>
      <Pin id=\"out\" direction=\"out\" type=\"signal\"/>
    </Node>
    <Node id=\"adsr0\" x=\"600\" y=\"100\" attack=\"1.5\" decay=\"2.0\" sustain=\"0.7\" release=\"1.5\">
      <Pin id=\"in\" direction=\"in\" type=\"signal\"/>
      <Pin id=\"out\" direction=\"out\" type=\"signal\"/>
    </Node>
    <Node id=\"adsr1\" x=\"600\" y=\"250\" attack=\"1.8\" decay=\"2.2\" sustain=\"0.75\" release=\"1.8\">
      <Pin id=\"in\" direction=\"in\" type=\"signal\"/>
      <Pin id=\"out\" direction=\"out\" type=\"signal\"/>
    </Node>
    <Node id=\"delay0\" x=\"800\" y=\"175\" timems=\"450\" feedback=\"0.4\" mix=\"0.5\" sync=\"0\">
      <Pin id=\"in\" direction=\"in\" type=\"signal\"/>
      <Pin id=\"out\" direction=\"out\" type=\"signal\"/>
    </Node>
    <Node id=\"output\" x=\"1000\" y=\"175\">
      <Pin id=\"in1\" direction=\"in\" type=\"signal\"/>
      <Pin id=\"in2\" direction=\"in\" type=\"signal\"/>
    </Node>
  </Nodes>
  <Connections>
    <Wire from=\"note\" fromPort=\"out\" to=\"fscale0\" toPort=\"freq_in\"/>
    <Wire from=\"fscale0\" fromPort=\"out\" to=\"osc0\" toPort=\"note_in\"/>
    <Wire from=\"fscale0\" fromPort=\"out\" to=\"osc1\" toPort=\"note_in\"/>
    <Wire from=\"osc0\" fromPort=\"out\" to=\"adsr0\" toPort=\"in\"/>
    <Wire from=\"osc1\" fromPort=\"out\" to=\"adsr1\" toPort=\"in\"/>
    <Wire from=\"adsr0\" fromPort=\"out\" to=\"delay0\" toPort=\"in\"/>
    <Wire from=\"adsr1\" fromPort=\"out\" to=\"delay0\" toPort=\"in\"/>
    <Wire from=\"delay0\" fromPort=\"out\" to=\"output\" toPort=\"in1\"/>
  </Connections>
</SmolFmPatch>"