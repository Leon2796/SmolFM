"<?xml version=\"1.0\" encoding=\"UTF-8\"?>
<SmolFmPatch>
  <Nodes>
    <Node id=\"note\" x=\"60\" y=\"100\"/>
    <Node id=\"osc0\" x=\"300\" y=\"80\" waveform=\"4\" mode=\"1\" staticfreq=\"1800\">
      <Pin id=\"note_in\" direction=\"in\" type=\"frequency\"/>
      <Pin id=\"out\" direction=\"out\" type=\"signal\"/>
    </Node>
    <Node id=\"osc1\" x=\"300\" y=\"200\" waveform=\"1\" mode=\"1\" staticfreq=\"250\">
      <Pin id=\"note_in\" direction=\"in\" type=\"frequency\"/>
      <Pin id=\"out\" direction=\"out\" type=\"signal\"/>
    </Node>
    <Node id=\"adsr0\" x=\"500\" y=\"80\" attack=\"0.001\" decay=\"0.15\" sustain=\"0.0\" release=\"0.05\">
      <Pin id=\"in\" direction=\"in\" type=\"signal\"/>
      <Pin id=\"out\" direction=\"out\" type=\"signal\"/>
    </Node>
    <Node id=\"adsr1\" x=\"500\" y=\"200\" attack=\"0.001\" decay=\"0.12\" sustain=\"0.0\" release=\"0.04\">
      <Pin id=\"in\" direction=\"in\" type=\"signal\"/>
      <Pin id=\"out\" direction=\"out\" type=\"signal\"/>
    </Node>
    <Node id=\"gain0\" x=\"700\" y=\"140\" factor=\"1.0\">
      <Pin id=\"in\" direction=\"in\" type=\"signal\"/>
      <Pin id=\"out\" direction=\"out\" type=\"signal\"/>
    </Node>
    <Node id=\"output\" x=\"900\" y=\"140\">
      <Pin id=\"in1\" direction=\"in\" type=\"signal\"/>
      <Pin id=\"in2\" direction=\"in\" type=\"signal\"/>
    </Node>
  </Nodes>
  <Connections>
    <Wire from=\"osc0\" fromPort=\"out\" to=\"adsr0\" toPort=\"in\"/>
    <Wire from=\"osc1\" fromPort=\"out\" to=\"adsr1\" toPort=\"in\"/>
    <Wire from=\"adsr0\" fromPort=\"out\" to=\"gain0\" toPort=\"in\"/>
    <Wire from=\"adsr1\" fromPort=\"out\" to=\"gain0\" toPort=\"in\"/>
    <Wire from=\"gain0\" fromPort=\"out\" to=\"output\" toPort=\"in1\"/>
  </Connections>
</SmolFmPatch>"