<SmolFM version="3">
  <Graph>
    <Nodes>
      <Node id="note" />
      <Node id="osc0" waveform="noise" mode="static" staticfreq="1800">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr0" attack="0.0005" decay="0.12" sustain="0.0" release="0.01">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="filter0" mode="hp" cutoff="10000" resonance="0.5">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.8" />
    </Nodes>
    <Connections>
      <Wire from="osc0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="filter0" toPort="in" />
      <Wire from="filter0" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="100" />
      <Box id="osc0" x="300" y="100" />
      <Box id="adsr0" x="500" y="100" />
      <Box id="filter0" x="700" y="100" />
      <Box id="output" x="900" y="100" />
    </Boxes>
  </Layout>
</SmolFM>