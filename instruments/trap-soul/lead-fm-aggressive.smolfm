"<?xml version=\"1.0\" encoding=\"UTF-8\"?>
<SmolFmPatch>
  <Nodes>
    <Node id=\"note\" x=\"60\" y=\"100\"/>
    <Node id=\"fm0\" x=\"250\" y=\"100\" amount=\"4.0\">
      <Pin id=\"freq_in\" direction=\"in\" type=\"frequency\"/>
      <Pin id=\"modulator_in\" direction=\"in\" type=\"signal\"/>
      <Pin id=\"out\" direction=\"out\" type=\"frequency\"/>
    </Node>
    <Node id=\"osc0\" x=\"450\" y=\"100\" waveform=\"1\">
      <Pin id=\"note_in\" direction=\"in\" type=\"frequency\"/>
      <Pin id=\"out\" direction=\"out\" type=\"signal\"/>
    </Node>
    <Node id=\"osc1\" x=\"450\" y=\"250\" waveform=\"1\" mode=\"2\" lforate=\"4.5\">
      <Pin id=\"note_in\" direction=\"in\" type=\"frequency\"/>
      <Pin id=\"out\" direction=\"out\" type=\"signal\"/>
    </Node>
    <Node id=\"adsr0\" x=\"650\" y=\"100\" attack=\"0.001\" decay=\"0.3\" sustain=\"0.5\" release=\"0.1\">
      <Pin id=\"in\" direction=\"in\" type=\"signal\"/>
      <Pin id=\"out\" direction=\"out\" type=\"signal\"/>
    </Node>
    <Node id=\"shape0\" x=\"850\" y=\"100\" drive=\"0.7\" shape=\"1\">
      <Pin id=\"in\" direction=\"in\" type=\"signal\"/>
      <Pin id=\"out\" direction=\"out\" type=\"signal\"/>
    </Node>
    <Node id=\"output\" x=\"1050\" y=\"100\">
      <Pin id=\"in1\" direction=\"in\" type=\"signal\"/>
    </Node>
  </Nodes>
  <Connections>
    <Wire from=\"osc1\" fromPort=\"out\" to=\"fm0\" toPort=\"modulator_in\"/>
    <Wire from=\"note\" fromPort=\"out\" to=\"fm0\" toPort=\"freq_in\"/>
    <Wire from=\"fm0\" fromPort=\"out\" to=\"osc0\" toPort=\"note_in\"/>
    <Wire from=\"osc0\" fromPort=\"out\" to=\"adsr0\" toPort=\"in\"/>
    <Wire from=\"adsr0\" fromPort=\"out\" to=\"shape0\" toPort=\"in\"/>
    <Wire from=\"shape0\" fromPort=\"out\" to=\"output\" toPort=\"in1\"/>
  </Connections>
</SmolFmPatch>"