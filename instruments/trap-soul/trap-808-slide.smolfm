"<?xml version=\"1.0\" encoding=\"UTF-8\"?>
<SmolfmPatch>
  <Nodes>
    <Node id=\"note\" x=\"60\" y=\"100\"/>
    <Node id=\"fadsr0\" x=\"250\" y=\"100\" attack=\"0.02\" decay=\"0.15\" sustain=\"0.0\" release=\"0.05\" up=\"1.0\" down=\"0.5\">
      <Pin id=\"freq_in\" direction=\"in\" type=\"frequency\"/>
      <Pin id=\"out\" direction=\"out\" type=\"frequency\"/>
    </Node>
    <Node id=\"osc0\" x=\"500\" y=\"100\" waveform=\"1\">
      <Pin id=\"note_in\" direction=\"in\" type=\"frequency\"/>
      <Pin id=\"out\" direction=\"out\" type=\"signal\"/>
    </Node>
    <Node id=\"adsr0\" x=\"700\" y=\"100\" attack=\"0.001\" decay=\"0.5\" sustain=\"0.0\" release=\"0.05\">
      <Pin id=\"in\" direction=\"in\" type=\"signal\"/>
      <Pin id=\"out\" direction=\"out\" type=\"signal\"/>
    </Node>
    <Node id=\"shape0\" x=\"900\" y=\"100\" drive=\"0.85\" shape=\"1\">
      <Pin id=\"in\" direction=\"in\" type=\"signal\"/>
      <Pin id=\"out\" direction=\"out\" type=\"signal\"/>
    </Node>
    <Node id=\"output\" x=\"1100\" y=\"100\">
      <Pin id=\"in1\" direction=\"in\" type=\"signal\"/>
    </Node>
  </Nodes>
  <Connections>
    <Wire from=\"note\" fromPort=\"out\" to=\"fadsr0\" toPort=\"freq_in\"/>
    <Wire from=\"fadsr0\" fromPort=\"out\" to=\"osc0\" toPort=\"note_in\"/>
    <Wire from=\"osc0\" fromPort=\"out\" to=\"adsr0\" toPort=\"in\"/>
    <Wire from=\"adsr0\" fromPort=\"out\" to=\"shape0\" toPort=\"in\"/>
    <Wire from=\"shape0\" fromPort=\"out\" to=\"output\" toPort=\"in1\"/>
  </Connections>
</SmolFmPatch>"