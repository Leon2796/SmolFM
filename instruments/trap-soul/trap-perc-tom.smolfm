"<?xml version=\"1.0\" encoding=\"UTF-8\"?>
<SmolFmPatch>
  <Nodes>
    <Node id=\"note\" x=\"60\" y=\"100\"/>
    <Node id=\"fadsr0\" x=\"250\" y=\"100\" attack=\"0.001\" decay=\"0.25\" sustain=\"0.0\" release=\"0.05\" up=\"0.3\" down=\"0.15\">
      <Pin id=\"freq_in\" direction=\"in\" type=\"frequency\"/>
      <Pin id=\"out\" direction=\"out\" type=\"frequency\"/>
    </Node>
    <Node id=\"osc0\" x=\"500\" y=\"100\" waveform=\"1\">
      <Pin id=\"note_in\" direction=\"in\" type=\"frequency\"/>
      <Pin id=\"out\" direction=\"out\" type=\"signal\"/>
    </Node>
    <Node id=\"adsr0\" x=\"700\" y=\"100\" attack=\"0.001\" decay=\"0.3\" sustain=\"0.0\" release=\"0.1\">
      <Pin id=\"in\" direction=\"in\" type=\"signal\"/>
      <Pin id=\"out\" direction=\"out\" type=\"signal\"/>
    </Node>
    <Node id=\"output\" x=\"900\" y=\"100\">
      <Pin id=\"in1\" direction=\"in\" type=\"signal\"/>
    </Node>
  </Nodes>
  <Connections>
    <Wire from=\"note\" fromPort=\"out\" to=\"fadsr0\" toPort=\"freq_in\"/>
    <Wire from=\"fadsr0\" fromPort=\"out\" to=\"osc0\" toPort=\"note_in\"/>
    <Wire from=\"osc0\" fromPort=\"out\" to=\"adsr0\" toPort=\"in\"/>
    <Wire from=\"adsr0\" fromPort=\"out\" to=\"output\" toPort=\"in1\"/>
  </Connections>
</SmolFmPatch>"