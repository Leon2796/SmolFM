<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="2">
  <Nodes>
    <Node id="note" x="60" y="100"/>
    <Node id="osc0" x="300" y="100" waveform="0" mode="2" lforate="0.3">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="adsr0" x="500" y="100" attack="0.8" decay="1.5" sustain="0.6" release="2.0">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
