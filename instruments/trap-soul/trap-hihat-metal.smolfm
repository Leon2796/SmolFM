<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="trap-hihat-metal">
  <Graph>
    <Nodes>
      <Node id="note">
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc0" waveform="sine" mode="static" staticfreq="2600">
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc1" waveform="sine" mode="static" staticfreq="3400">
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="ring0">
        <Pin id="in1" direction="in" type="signal" />
        <Pin id="in2" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="filter0" mode="hp" cutoff="7500" resonance="0.35">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr0" attack="0.001" decay="0.3" sustain="0.0" release="0.12">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc2" waveform="noise" mode="static" staticfreq="8000">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="shape0" drive="0.35" shape="hard">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr1" attack="0.001" decay="0.09" sustain="0.0" release="0.04">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="gain0" factor="0.35">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.8" />
    </Nodes>
    <Connections>
      <Wire from="osc0" fromPort="out" to="ring0" toPort="in1" />
      <Wire from="osc1" fromPort="out" to="ring0" toPort="in2" />
      <Wire from="ring0" fromPort="out" to="filter0" toPort="in" />
      <Wire from="filter0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="note" fromPort="out" to="osc2" toPort="note_in" />
      <Wire from="osc2" fromPort="out" to="shape0" toPort="in" />
      <Wire from="shape0" fromPort="out" to="adsr1" toPort="in" />
      <Wire from="adsr1" fromPort="out" to="gain0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="output" toPort="in1" />
      <Wire from="gain0" fromPort="out" to="output" toPort="in2" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="60" />
      <Box id="osc0" x="360" y="60" />
      <Box id="osc1" x="360" y="220" />
      <Box id="ring0" x="680" y="140" />
      <Box id="filter0" x="1000" y="140" />
      <Box id="adsr0" x="1320" y="140" />
      <Box id="osc2" x="360" y="540" />
      <Box id="shape0" x="680" y="540" />
      <Box id="adsr1" x="1000" y="540" />
      <Box id="gain0" x="1320" y="540" />
      <Box id="output" x="1640" y="340" />
    </Boxes>
  </Layout>
</SmolFM>