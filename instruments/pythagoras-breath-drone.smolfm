<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="Pythagoras Breath Drone" description="Drone stack that breathes at two key-tracking beat rates: chained tempered fifths chase the pure ratios 3:2 and 9:4, so the register shimmers like a slightly out-of-temper organ that re-tunes itself with every note" techniques="fscale-interval-power-stack, fscale-temper-beating">
  <Graph>
    <Nodes>
      <Node id="note">
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc0" waveform="saw">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="fscale0" factor="1" interval="fifth_up" />
      <Node id="fscale1" factor="1" interval="fifth_up" />
      <Node id="fscale2" factor="2.25" />
      <Node id="fscale3" factor="1" interval="fifth_up" />
      <Node id="fscale4" factor="1.5" />
      <Node id="osc1" waveform="triangle">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc2" waveform="triangle">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc3" waveform="triangle">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc4" waveform="triangle">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr0" attack="0.05" decay="0.4" sustain="0.85" release="1.2">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr1" attack="0.02" decay="0.4" sustain="0.8" release="1.1">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr2" attack="0.06" decay="0.4" sustain="0.7" release="1.4">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr3" attack="0.04" decay="0.4" sustain="0.8" release="1.2">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr4" attack="0.07" decay="0.4" sustain="0.75" release="1.5">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.7" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in" />
      <Wire from="fscale0" fromPort="out" to="fscale1" toPort="freq_in" />
      <Wire from="fscale1" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="note" fromPort="out" to="fscale2" toPort="freq_in" />
      <Wire from="fscale2" fromPort="out" to="osc2" toPort="note_in" />
      <Wire from="note" fromPort="out" to="fscale3" toPort="freq_in" />
      <Wire from="fscale3" fromPort="out" to="osc3" toPort="note_in" />
      <Wire from="note" fromPort="out" to="fscale4" toPort="freq_in" />
      <Wire from="fscale4" fromPort="out" to="osc4" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="osc1" fromPort="out" to="adsr1" toPort="in" />
      <Wire from="osc2" fromPort="out" to="adsr2" toPort="in" />
      <Wire from="osc3" fromPort="out" to="adsr3" toPort="in" />
      <Wire from="osc4" fromPort="out" to="adsr4" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="output" toPort="in1" />
      <Wire from="adsr1" fromPort="out" to="output" toPort="in2" />
      <Wire from="adsr2" fromPort="out" to="output" toPort="in3" />
      <Wire from="adsr3" fromPort="out" to="output" toPort="in4" />
      <Wire from="adsr4" fromPort="out" to="output" toPort="in5" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="460" />
      <Box id="osc0" x="380" y="60" />
      <Box id="fscale0" x="380" y="302" />
      <Box id="fscale1" x="700" y="260" />
      <Box id="fscale2" x="700" y="468" />
      <Box id="fscale3" x="700" y="676" />
      <Box id="fscale4" x="700" y="884" />
      <Box id="osc1" x="1020" y="260" />
      <Box id="osc2" x="1020" y="502" />
      <Box id="osc3" x="1020" y="744" />
      <Box id="osc4" x="1020" y="986" />
      <Box id="adsr0" x="1340" y="60" />
      <Box id="adsr1" x="1340" y="372" />
      <Box id="adsr2" x="1340" y="684" />
      <Box id="adsr3" x="1340" y="996" />
      <Box id="adsr4" x="1340" y="1308" />
      <Box id="output" x="1660" y="460" />
    </Boxes>
  </Layout>
</SmolFM>