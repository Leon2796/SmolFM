<?xml version="1.0" encoding="UTF-8"?>
<SmolFM version="3" name="Interval Sweep Clang Lead" description="Inharmonic clang lead: the modulator sits an off-pure tempered major third over the key while the F-ADSR blooms the FM centre brighter on every attack, grounded by a soft fifth-down shadow voice" techniques="fscale-interval-modulator-fm, fscale-interval-power-stack, fadsr-fm-spectrum-sweep">
  <Graph>
    <Nodes>
      <Node id="note">
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fadsr0" attack="0.01" decay="0.5" sustain="0.6" release="0.2" up="1.25" down="0.95">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fscale0" factor="1.02" interval="major_third_up" />
      <Node id="fscale1" factor="1" interval="fifth_down" />
      <Node id="osc0" waveform="saw">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc1" waveform="square">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc2" waveform="triangle">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="fm0" amount="3.2">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="modulator_in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="adsr0" attack="0.002" decay="0.45" sustain="0.35" release="0.2">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr1" attack="0.002" decay="0.3" sustain="0.3" release="0.15">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.72" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="fadsr0" toPort="freq_in" />
      <Wire from="fadsr0" fromPort="out" to="fm0" toPort="freq_in" />
      <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in" />
      <Wire from="fscale0" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="fm0" toPort="modulator_in" />
      <Wire from="fm0" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="osc1" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="output" toPort="in1" />
      <Wire from="note" fromPort="out" to="fscale1" toPort="freq_in" />
      <Wire from="fscale1" fromPort="out" to="osc2" toPort="note_in" />
      <Wire from="osc2" fromPort="out" to="adsr1" toPort="in" />
      <Wire from="adsr1" fromPort="out" to="output" toPort="in2" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="260" />
      <Box id="fadsr0" x="60" y="460" />
      <Box id="fscale0" x="380" y="60" />
      <Box id="fscale1" x="380" y="460" />
      <Box id="osc0" x="700" y="60" />
      <Box id="osc2" x="700" y="460" />
      <Box id="fm0" x="1020" y="60" />
      <Box id="osc1" x="1340" y="60" />
      <Box id="adsr0" x="1660" y="60" />
      <Box id="adsr1" x="1340" y="460" />
      <Box id="output" x="1940" y="260" />
    </Boxes>
  </Layout>
</SmolFM>