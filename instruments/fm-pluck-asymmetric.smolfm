<?xml version="1.0" encoding="UTF-8"?>

<!-- Advanced: Asymmetric Pluck (Saw Modulator / Sine Carrier) -->
<SmolFM version="2" name="Asymmetric Pluck">
  <description>Saw modulator on sine carrier for harsher FM plucks</description>
  <Nodes>
    <Node id="note0" x="100" y="100"/>
    <Node id="note1" x="100" y="300"/>
    
    <Node id="fscale0" x="300" y="300" factor="1.5"/>
    
    <Node id="fm0" x="500" y="100" amount="1.8"/>
    
    <Node id="osc0" x="700" y="100" waveform="0"/>
    <Node id="osc1" x="500" y="300" waveform="1"/>
    
    <Node id="adsr0" x="900" y="100" attack="0.001" decay="0.25" sustain="0.3" release="0.15"/>
    
    <Node id="output" x="1100" y="100" level="0.7"/>
  </Nodes>
  <Connections>
    <Wire from="note0" fromPort="out" to="fm0" toPort="freq_in"/>
    <Wire from="note1" fromPort="out" to="fscale0" toPort="freq_in"/>
    <Wire from="fscale0" fromPort="out" to="osc1" toPort="note_in"/>
    <Wire from="osc1" fromPort="out" to="fm0" toPort="modulator_in"/>
    <Wire from="fm0" fromPort="out" to="osc0" toPort="note_in"/>
    <Wire from="osc0" fromPort="out" to="adsr0" toPort="in"/>
    <Wire from="adsr0" fromPort="out" to="output" toPort="in1"/>
  </Connections>
</SmolFM>