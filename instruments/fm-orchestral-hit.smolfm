<?xml version="1.0" encoding="UTF-8"?>

<!-- Advanced: Orchestral Hit (4-Layer Stab with FM and Ring Mod) -->
<SmolFM version="2" name="Orchestral Hit">
  <description>Massive layered stab with FM voices and ring modulation</description>
  <Nodes>
    <Node id="note0" x="100" y="100"/>
    <Node id="note1" x="100" y="300"/>
    
    <Node id="fscale0" x="300" y="300" factor="2.0"/>
    <Node id="fscale1" x="300" y="400" factor="1.5"/>
    
    <Node id="fm0" x="500" y="100" amount="2.0"/>
    <Node id="fm1" x="500" y="200" amount="1.8"/>
    
    <Node id="osc0" x="700" y="100" waveform="0"/>
    <Node id="osc1" x="500" y="300" waveform="0"/>
    <Node id="osc2" x="700" y="200" waveform="0"/>
    
    <Node id="adsr0" x="900" y="100" attack="0.001" decay="0.4" sustain="0.0" release="0.2"/>
    <Node id="adsr1" x="900" y="200" attack="0.001" decay="0.35" sustain="0.0" release="0.18"/>
    
    <Node id="output" x="1100" y="200" level="0.4"/>
  </Nodes>
  <Connections>
    <Wire from="note0" fromPort="out" to="fm0" toPort="freq_in"/>
    <Wire from="note0" fromPort="out" to="fscale0" toPort="freq_in"/>
    <Wire from="fscale0" fromPort="out" to="osc1" toPort="note_in"/>
    <Wire from="osc1" fromPort="out" to="fm0" toPort="modulator_in"/>
    <Wire from="fm0" fromPort="out" to="osc0" toPort="note_in"/>
    <Wire from="osc0" fromPort="out" to="adsr0" toPort="in"/>
    <Wire from="adsr0" fromPort="out" to="output" toPort="in1"/>
    
    <Wire from="note1" fromPort="out" to="fm1" toPort="freq_in"/>
    <Wire from="note1" fromPort="out" to="fscale1" toPort="freq_in"/>
    <Wire from="fscale1" fromPort="out" to="osc1" toPort="note_in"/>
    <Wire from="fm1" fromPort="out" to="osc2" toPort="note_in"/>
    <Wire from="osc2" fromPort="out" to="adsr1" toPort="in"/>
    <Wire from="adsr1" fromPort="out" to="output" toPort="in2"/>
  </Connections>
</SmolFM>