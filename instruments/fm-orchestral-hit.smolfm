<SmolFM version="3" name="Orchestral Hit">
  <Graph>
    <Nodes>
      <Node id="note" />
      <Node id="fscale0" factor="2.0" />
      <Node id="fscale1" factor="1.5" />
      <Node id="fm0" amount="2.0" />
      <Node id="fm1" amount="1.8" />
      <Node id="osc0" waveform="sine" />
      <Node id="osc1" waveform="sine" />
      <Node id="osc2" waveform="sine" />
      <Node id="adsr0" attack="0.001" decay="0.4" sustain="0.0" release="0.2" />
      <Node id="adsr1" attack="0.001" decay="0.35" sustain="0.0" release="0.18" />
      <Node id="output" level="0.4" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="fm0" toPort="freq_in" />
      <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in" />
      <Wire from="fscale0" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="osc1" fromPort="out" to="fm0" toPort="modulator_in" />
      <Wire from="fm0" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="output" toPort="in1" />
      <Wire from="note" fromPort="out" to="fm1" toPort="freq_in" />
      <Wire from="note" fromPort="out" to="fscale1" toPort="freq_in" />
      <Wire from="fscale1" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="fm1" fromPort="out" to="osc2" toPort="note_in" />
      <Wire from="osc2" fromPort="out" to="adsr1" toPort="in" />
      <Wire from="adsr1" fromPort="out" to="output" toPort="in2" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="100" y="100" />
      <Box id="fscale0" x="300" y="300" />
      <Box id="fscale1" x="300" y="400" />
      <Box id="fm0" x="500" y="100" />
      <Box id="fm1" x="500" y="200" />
      <Box id="osc0" x="700" y="100" />
      <Box id="osc1" x="500" y="300" />
      <Box id="osc2" x="700" y="200" />
      <Box id="adsr0" x="900" y="100" />
      <Box id="adsr1" x="900" y="200" />
      <Box id="output" x="1100" y="200" />
    </Boxes>
  </Layout>
</SmolFM>