<SmolFM version="3" name="Thunder FX">
  <Graph>
    <Nodes>
      <Node id="note" />
      <Node id="fscale0" factor="0.3" />
      <Node id="fscale1" factor="1.7" />
      <Node id="fscale2" factor="2.3" />
      <Node id="osc0" waveform="saw" />
      <Node id="osc1" waveform="saw" />
      <Node id="osc2" waveform="sine" />
      <Node id="ring0" />
      <Node id="ring1" />
      <Node id="adsr0" attack="0.05" decay="2.0" sustain="0.0" release="1.5" />
      <Node id="output" level="0.6" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in" />
      <Wire from="fscale0" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="note" fromPort="out" to="fscale1" toPort="freq_in" />
      <Wire from="fscale1" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="ring0" toPort="in1" />
      <Wire from="osc1" fromPort="out" to="ring0" toPort="in2" />
      <Wire from="ring0" fromPort="out" to="ring1" toPort="in1" />
      <Wire from="note" fromPort="out" to="fscale2" toPort="freq_in" />
      <Wire from="fscale2" fromPort="out" to="osc2" toPort="note_in" />
      <Wire from="osc2" fromPort="out" to="ring1" toPort="in2" />
      <Wire from="ring1" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="output" toPort="in1" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="100" y="100" />
      <Box id="fscale0" x="300" y="100" />
      <Box id="fscale1" x="300" y="300" />
      <Box id="fscale2" x="300" y="500" />
      <Box id="osc0" x="500" y="100" />
      <Box id="osc1" x="500" y="300" />
      <Box id="osc2" x="500" y="500" />
      <Box id="ring0" x="700" y="200" />
      <Box id="ring1" x="900" y="200" />
      <Box id="adsr0" x="1100" y="200" />
      <Box id="output" x="1300" y="200" />
    </Boxes>
  </Layout>
</SmolFM>