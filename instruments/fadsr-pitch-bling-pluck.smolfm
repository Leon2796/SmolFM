<?xml version="1.0" encoding="UTF-8"?>

<SmolFM version="2" name="fadsr-pitch-bling-pluck">
  <description>Plucked bell-ish lead: the F-ADSR strikes the carrier one octave above the played pitch and decays it back to playing pitch over 150 ms; amplitude envelope gives a fast pluck with short tail.</description>
  <Nodes>
    <Node id="note0" x="60" y="60">
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="fadsr0" x="360" y="60" attack="0.001" decay="0.15" sustain="0.0" release="0.2" up="2.0" down="1.0">
      <Pin id="freq_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="frequency"/>
    </Node>
    <Node id="osc0" x="680" y="60" waveform="0">
      <Pin id="note_in" direction="in" type="frequency"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="adsr0" x="1000" y="60" attack="0.001" decay="0.6" sustain="0.0" release="0.3">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="delay0" x="1320" y="60" time="280" feedback="0.25" mix="0.2" sync="0" division="1">
      <Pin id="in" direction="in" type="signal"/>
      <Pin id="out" direction="out" type="signal"/>
    </Node>
    <Node id="output" x="1640" y="60" level="0.85"/>
  </Nodes>
  <Connections>
    <Wire from="note0" fromPort="out" to="fadsr0" toPort="freq_in"/>
    <Wire from="fadsr0" fromPort="out" to="osc0" toPort="note_in"/>
    <Wire from="osc0" fromPort="out" to="adsr0" toPort="in"/>
    <Wire from="adsr0" fromPort="out" to="delay0" toPort="in"/>
    <Wire from="delay0" fromPort="out" to="output" toPort="in1"/>
  </Connections>
</SmolFM>