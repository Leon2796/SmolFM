<SmolFM version="3" name="fadsr-chaos-bell-cascade">
  <Graph>
    <Nodes>
      <Node id="note">
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fadsr0" attack="0.001" decay="0.6" sustain="0.0" release="0.8" up="2.0" down="1.0">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fadsr1" attack="0.001" decay="1.1" sustain="0.0" release="1.2" up="0.5" down="1.0">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="osc0" waveform="sine">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="osc1" waveform="sine">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="fm0" amount="2.8">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="modulator_in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fm1" amount="1.6">
        <Pin id="freq_in" direction="in" type="frequency" />
        <Pin id="modulator_in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="frequency" />
      </Node>
      <Node id="fscale0" factor="1.5" />
      <Node id="osc2" waveform="sine">
        <Pin id="note_in" direction="in" type="frequency" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr0" attack="0.001" decay="2.2" sustain="0.0" release="1.8">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="adsr1" attack="0.001" decay="3.0" sustain="0.0" release="2.0">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="delay0" time="500" feedback="0.5" mix="0.85" sync="on" division="half">
        <Pin id="in" direction="in" type="signal" />
        <Pin id="out" direction="out" type="signal" />
      </Node>
      <Node id="output" level="0.7" />
    </Nodes>
    <Connections>
      <Wire from="note" fromPort="out" to="fadsr0" toPort="freq_in" />
      <Wire from="note" fromPort="out" to="fscale0" toPort="freq_in" />
      <Wire from="fscale0" fromPort="out" to="osc1" toPort="note_in" />
      <Wire from="osc1" fromPort="out" to="fm0" toPort="modulator_in" />
      <Wire from="note" fromPort="out" to="fadsr1" toPort="freq_in" />
      <Wire from="fadsr1" fromPort="out" to="osc2" toPort="note_in" />
      <Wire from="osc2" fromPort="out" to="fm1" toPort="modulator_in" />
      <Wire from="fadsr0" fromPort="out" to="fm0" toPort="freq_in" />
      <Wire from="fm0" fromPort="out" to="fm1" toPort="freq_in" />
      <Wire from="fm1" fromPort="out" to="osc0" toPort="note_in" />
      <Wire from="osc0" fromPort="out" to="adsr0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="delay0" toPort="in" />
      <Wire from="adsr0" fromPort="out" to="output" toPort="in1" />
      <Wire from="delay0" fromPort="out" to="output" toPort="in2" />
    </Connections>
  </Graph>
  <Layout>
    <Boxes>
      <Box id="note" x="60" y="60" />
      <Box id="fadsr0" x="360" y="60" />
      <Box id="fadsr1" x="360" y="700" />
      <Box id="osc0" x="680" y="60" />
      <Box id="osc1" x="680" y="380" />
      <Box id="fm0" x="1000" y="60" />
      <Box id="fm1" x="1000" y="380" />
      <Box id="fscale0" x="60" y="940" />
      <Box id="osc2" x="360" y="940" />
      <Box id="adsr0" x="1340" y="60" />
      <Box id="adsr1" x="1340" y="380" />
      <Box id="delay0" x="1340" y="700" />
      <Box id="output" x="1660" y="60" />
    </Boxes>
  </Layout>
</SmolFM>